import "calculus.rhm" as calc
attribute cost = 4 copy
synth text on Q
synth value on Q
start Q

Q -> calc.F(cost = cost) {
  value = differentiate(differentiate($1.formula, "x"), "x")
  require not formula_is_zero(value)
  text = $1.latex
}

prompt "Find the second derivative of [`f(x) = {Q.text}`]."
answer Q.value
width 24
