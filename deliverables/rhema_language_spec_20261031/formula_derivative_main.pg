DOCUMENT();
loadMacros("PGstandard.pl", "MathObjects.pl", "PGML.pl");
Context("Numeric");

BEGIN_PGML
Differentiate [`f(x) = \sin\left(x\right) - x^{4}`] with respect to x.[_____]{answer=>Formula('cos(x)-4*x^3'),width=>24}

Differentiate [`f(x) = \sin\left(x\right) - 4 \cdot x^{2}`] with respect to x.[_____]{answer=>Formula('cos(x)-4*2*x'),width=>24}

Differentiate [`f(x) = \sin\left(x\right) - 4 \cdot x^{2}`] with respect to x.[_____]{answer=>Formula('cos(x)-4*2*x'),width=>24}

Differentiate [`f(x) = \sin\left(x\right) - 4 \cdot x^{4}`] with respect to x.[_____]{answer=>Formula('cos(x)-4*4*x^3'),width=>24}

Differentiate [`f(x) = 3 \cdot x^{3} + \sin\left(x\right)`] with respect to x.[_____]{answer=>Formula('3*3*x^2+cos(x)'),width=>24}
END_PGML
ENDDOCUMENT();
