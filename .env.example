# Project-RHM's Flask server calls this endpoint. Do not expose it as a user input.
WEBWORK_RENDERER_URL=http://127.0.0.1:3000/render-api
# Browser-visible base used by the returned HTML for CSS, JS and MathJax assets.
WEBWORK_RENDERER_PUBLIC_BASE_URL=http://127.0.0.1:3000/
WEBWORK_RENDER_TIMEOUT_SECONDS=10
WEBWORK_RENDER_MAX_BYTES=262144
WEBWORK_RENDER_MAX_RESPONSE_BYTES=4194304
WEBWORK_RENDER_ENABLED=true
