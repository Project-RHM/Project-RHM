(* config.ml *)
(* Global difficulty parameters *)

(* The list of allowed macros *)
let allowed_macros = ["parserRadioButtons.pl"; "PGcourse.pl"]

(* ================================================================ *)
(* ============== These could be difficulty levels ================ *)
(* ================================================================ *)

(* ============================================== *)
(* ============= General Difficulty ============= *)
(* ============================================== *)
(* The max depth of the context configuration *)
(*
let max_cfg_depth = 3
let min_cfg_depth = 1
*)
(* The maximum amount of questions *)
let min_question_num = {{ min_question_num }}
let max_question_num = {{ max_question_num }}

(* Problem type:
    0 = all question type,
    1 = arithmetic only,
    2 = set only,
    3 = vector only
    4 = calculus only (derivative and integral),
    5 = Boolean Algebra only (includes evaluation and equivalence),
    6 = Complex Number only *)
let problem_type = {{ problem_type }}

(* For problem type is 0 (all question type):
   you can set the amount of each question type.
   - Set question_random_amounts as true if you want the amount of each question type to be random.
   - Set question_random_amounts as false and set question_type_amounts as the amount of each question type.
   *)
let question_random_amounts = {{ question_random_amounts }}
(* The amount of each question type:
     - [arithmetic_amount; set_amount; vector_amount; calculus_amount; boolean_amount; complex_amount]
     - the total amount of questions should be within the interval [min_question_num, max_question_num]
   *)
let question_type_amounts = {{ question_type_amounts }}
(* Set shuffle_questions_for_0_type as true if you want to shuffle the order of the questions. *)
let shuffle_questions_for_0_type = {{ shuffle_questions_for_0_type }}

(* ----------------------------------------------- *)

(* ============================================== *)
(* ======= Arithmetic Question Difficulty ======= *)
(* ============================================== *)
(* The absolute max depth of a math expression *)
let max_expr_depth = {{ max_expr_depth }}

(* Control whether to generate floats *)
let allow_float = {{ allow_float }} (* Set to false to generate only integers *)

(* ----------------------------------------------- *)

(* ======================================= *)
(* ======= Set Question Difficulty ======= *)
(* ======================================= *)
(* The max depth of a set expression *)
let min_set_expr_depth = {{ min_set_expr_depth }}
let max_set_expr_depth = {{ max_set_expr_depth }}

(* The range of set elements *)
let min_set_element = {{ min_set_element }}
let max_set_element = {{ max_set_element }}

(* The maximum amount of set definitions in set questions *)
(* !!! It must be greater than 2 and leq than the length of set_variables !!! *)
let max_set_def_num = {{ max_set_def_num }}
(* The set variable names used in set questions *)
let set_variables = {{ set_variables }}

(* The number of questions in a set problem *)
let min_set_prob_num = {{ min_set_prob_num }}
let max_set_prob_num = {{ max_set_prob_num }}

(* ----------------------------------------------- *)

(* ========================================== *)
(* ======= Vector Question Difficulty ======= *)
(* ========================================== *)
(* The number of vector components *)
let vector_dimension = {{ vector_dimension }}  (* Generate 3D vectors *)

(* The range of vector components *)
let min_vector_element = {{ min_vector_element }}
let max_vector_element = {{ max_vector_element }}

(* The maximum amount of vector definitions in vector questions *)
(* !!! It must be greater than 2 and leq than the length of vector_variables !!! *)
let max_vector_def_num = {{ max_vector_def_num }}
(* The vector variable names used in vector questions *)
let vector_variables = {{ vector_variables }}

(* The number of questions in a vector problem *)
let min_vector_prob_num = {{ min_vector_prob_num }}
let max_vector_prob_num = {{ max_vector_prob_num }}

(* ----------------------------------------------- *)

(* ============================================== *)
(* ======= Calculus Question Difficulty ======= *)
(* ============================================== *)
(* The max depth of a function expression:
   - Set min_fun_expr_depth and max_fun_expr_depth both as 1 to generate only basic functions *)
let min_fun_expr_depth = {{ min_fun_expr_depth }}
let max_fun_expr_depth = {{ max_fun_expr_depth }}

(* 0 = mixed, 1 = derivative only, 2 = integral only. *)
let calculus_question_mode = {{ calculus_question_mode }}

(* Used when calculus_question_mode = 0. Weights for each type: *)
let derivative_weight = {{ derivative_weight }}
let integral_weight = {{ integral_weight }}

(* Derivative problem configuration *)
let min_derivative_prob_num = {{ min_derivative_prob_num }}
let max_derivative_prob_num = {{ max_derivative_prob_num }}

(* Integral problem configuration *)
let integral_expr_depth = {{ integral_expr_depth }}

(* ----------------------------------------------- *)

(* ============================================== *)
(* ======= Boolean Algebra Difficulty =========== *)
(* ============================================== *)
(* 0 = mixed, 1 = evaluation only, 2 = equivalence only. *)
let boolean_question_mode = {{ boolean_question_mode }}

(* Used when boolean_question_mode = 0. Weights for each type: *)
let boolean_eval_weight = {{ boolean_eval_weight }}
let boolean_equiv_weight = {{ boolean_equiv_weight }}

(* The min and max depth of a Boolean expression. *)
let min_bool_expr_depth = {{ min_bool_expr_depth }}
let max_bool_expr_depth = {{ max_bool_expr_depth }}

(* The number of Boolean variables used in one problem. *)
let min_bool_var_num = {{ min_bool_var_num }}
let max_bool_var_num = {{ max_bool_var_num }}

(* The Boolean variable names used in Boolean expression questions. *)
let boolean_variables = {{ boolean_variables }}

(* ----------------------------------------------- *)

(* ============================================== *)
(* ======= Complex Number Difficulty ============ *)
(* ============================================== *)
(* 0 = mixed, 1 = arithmetic only, 2 = conjugate only, 3 = modulus only, 4 = powers of i only. *)
let complex_question_mode = {{ complex_question_mode }}

(* Used when complex_question_mode = 0. Weights for each type: *)
let complex_arithmetic_weight = {{ complex_arithmetic_weight }}
let complex_conjugate_weight = {{ complex_conjugate_weight }}
let complex_modulus_weight = {{ complex_modulus_weight }}
let complex_power_i_weight = {{ complex_power_i_weight }}

(* The range of real and imaginary components in generated complex numbers. *)
let min_complex_component = {{ min_complex_component }}
let max_complex_component = {{ max_complex_component }}

(* The exponent range for i^n questions. *)
let min_complex_power = {{ min_complex_power }}
let max_complex_power = {{ max_complex_power }}

