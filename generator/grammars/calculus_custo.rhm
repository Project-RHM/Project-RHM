# Generated by the Rhema form editor.

attribute cost = 10 split

attribute calculus_mode = 0 copy

attribute constants = 1 copy

attribute advanced = 1 copy

context "Numeric"

synth kind on Q

synth text on Q

synth derivative on Q

synth answer_value on Q

synth kind on D

synth text on D

synth derivative on D

synth answer_value on D

synth kind on I

synth text on I

synth derivative on I

synth answer_value on I

synth formula on F

synth latex on F

synth constant on F

synth monomial on F

synth constants_used on F

synth linear_terms on F

synth formula on T

synth latex on T

synth value on T

synth constant on T

synth monomial on T

synth constants_used on T

synth linear on T

synth coefficient on T

synth power on F

start Q

Q -> D when (calculus_mode != 2) weight 1 {
  kind = $1.kind
  derivative = $1.derivative
  text = $1.text
  answer_value = $1.answer_value
}

Q -> I when ((calculus_mode != 1) and (cost >= 3)) weight 1 {
  kind = $1.kind
  derivative = $1.derivative
  text = $1.text
  answer_value = $1.answer_value
}

D -> F "derivative" weight 1 {
  kind = "derivative"
  require ($1.constants_used <= 1)
  derivative = differentiate($1.formula, "x")
  require (not formula_is_zero(derivative))
  text = ("Differentiate the function with respect to x:
[`f(x) = " ++ ($1.latex ++ "`]."))
  answer_value = derivative
}

I -> F "integral" when (cost >= 3) weight 1 {
  cost = (- 2)
  constants = (- 1)
  advanced = (- 1)
  kind = "integral"
  derivative = differentiate($1.formula, "x")
  require (not formula_is_zero(derivative))
  text = ("Find an antiderivative with the constant of integration C = 0:
[`\\int \\left(" ++ (formula_latex(derivative) ++ "\\right)\\,dx`]."))
  answer_value = $1.formula
}

question derivative {
  start D
  prompt "{D.text}"
  answer D.answer_value
}

question integral {
  start I
  prompt "{I.text}"
  answer I.answer_value
  cost = 10
}

F -> F "+" F when (cost >= 1) weight 3 {
  cost = (- 1)
  require ($1.latex != $3.latex)
  require (($1.constant + $3.constant) < 2)
  constant = 0
  monomial = 0
  constants_used = ($1.constants_used + $3.constants_used)
  linear_terms = ($1.linear_terms + $3.linear_terms)
  power = 0
  require (linear_terms <= 1)
  formula = formula_add($1.formula, $3.formula)
  require (not formula_is_zero(differentiate(formula, "x")))
  latex = formula_latex(formula)
}

F -> F "-" F when (cost >= 1) weight 3 {
  cost = (- 1)
  require ($1.latex != $3.latex)
  require (($1.constant + $3.constant) < 2)
  constant = 0
  monomial = 0
  constants_used = ($1.constants_used + $3.constants_used)
  linear_terms = ($1.linear_terms + $3.linear_terms)
  power = 0
  require (linear_terms <= 1)
  formula = formula_subtract($1.formula, $3.formula)
  require (not formula_is_zero(differentiate(formula, "x")))
  latex = formula_latex(formula)
}

F -> F "\\cdot" F when (cost >= 4) weight 2 {
  cost = (- 3)
  require ($1.latex != $3.latex)
  require ($1.constant = 0)
  require ($3.constant = 0)
  require (($1.monomial + $3.monomial) < 2)
  constant = 0
  monomial = 0
  constants_used = ($1.constants_used + $3.constants_used)
  linear_terms = 0
  power = 0
  formula = formula_multiply($1.formula, $3.formula)
  latex = formula_latex(formula)
}

F -> T "power" integer_between(2, 5) when ((cost >= 1) and (cost <= 2)) weight 3 {
  cost = (- 1)
  require ($1.constant = 0)
  constant = 0
  monomial = 1
  constants_used = 0
  linear_terms = 0
  power = 1
  formula = formula_power($1.formula, $3.value)
  latex = formula_latex(formula)
}

F -> F "power" integer_between(2, 5) when (cost >= 5) weight 3 {
  cost = (- 3)
  require ($1.power = 0)
  power = 1
  constant = 0
  monomial = 0
  constants_used = $1.constants_used
  linear_terms = 0
  formula = formula_power($1.formula, $3.value)
  latex = formula_latex(formula)
}

