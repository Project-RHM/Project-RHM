# Generated by the Rhema form editor.

attribute cost = 1 split

context "Numeric"

random p_value = boolean

random q_value = boolean

let p_text = cond(p_value, 1, 0)

let q_text = cond(p_value, 1, 0)

let mask = (cond(p_value, 1, 0) + cond(q_value, 2, 0))

synth expr on E

synth text on Q

synth value on Q

start Q

Q -> E weight 1 {
  require (bool_variable_count($1.expr) = 2)
  require bool_is_tidy($1.expr)
  text = bool_latex($1.expr)
  value = cond(bool_evaluate($1.expr, "p,q", mask), 1, 0)
}

E -> "p" when (cost = 0) weight 1 {
  expr = bool_var("p")
}

E -> "q" when (cost = 0) weight 1 {
  expr = bool_var("q")
}

E -> E "AND" E when (cost >= 1) weight 2 {
  cost = (- 1)
  expr = bool_and($1.expr, $3.expr)
}

E -> E "OR" E when (cost >= 1) weight 1 {
  cost = (- 1)
  expr = bool_or($1.expr, $3.expr)
}

E -> "NOT" E when (cost >= 1) weight 1 {
  cost = (- 1)
  expr = bool_not($2.expr)
}

E -> E "XOR" E when (cost >= 1) weight 2 {
  cost = (- 1)
  expr = bool_xor($1.expr, $3.expr)
}

prompt "Given [`p = {p_text}`], [`q = {q_text}`], evalute [`{Q.text}`]. Enter 1 for true, 0 for false"

answer Q.value

width 10
