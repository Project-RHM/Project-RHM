# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "Rhema: an attribute-grammar language for generating mathematics questions"
description:
  "Rhema is the question-grammar language of the RHM project. A .rhm file describes a question type as an attribute grammar whose inherited budgets set the difficulty and whose synthesized attributes compute the answer, or a whole assignment as a set of such questions. The rhema command checks a file and generates WeBWorK PG, the same paper every time for the same assignment. The package installs the command and a library of grammars for arithmetic, algebra, calculus, propositional logic, sets, vectors, complex numbers and linear algebra."
maintainer: ["Jingming Zhang"]
authors: [
  "Jingming Zhang" "Jiaming Lei" "Xiaobo Huang" "Jiesen Long" "Zhiyuan Li"
]
license: "MIT"
tags: [
  "education"
  "mathematics"
  "attribute grammar"
  "webwork"
  "question generation"
]
homepage: "https://github.com/Project-RHM/Project-RHM"
doc:
  "https://github.com/Project-RHM/Project-RHM/blob/main/RHEMA_LANGUAGE_GUIDE.md"
bug-reports: "https://github.com/Project-RHM/Project-RHM/issues"
depends: [
  "dune" {>= "3.6"}
  "ocaml" {>= "4.14"}
  "menhir" {>= "20201216"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Project-RHM/Project-RHM.git"
