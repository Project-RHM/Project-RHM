# ==========================================================================
#  Diophantine equations and continued fractions
#
#  The linear equation a x + b y = c in whole numbers: for which c it can
#  be solved, the next solution after a given one, the solution with x in
#  a given range, the number of solutions with neither unknown negative,
#  and the amounts two stamps cannot make. Continued fractions: the value
#  of one, and a partial quotient of a fraction. And the smallest
#  solutions of Pell's equation x^2 - d y^2 = 1. It goes on from
#  number_theory.rhm and modular_arithmetic.rhm.
#
#  An equation is built from a solution: x and y are chosen and c is what
#  the left side comes to. A fraction whose continued fraction is asked
#  for is built from its partial quotients, the last of them at least 2,
#  so that the expansion is the only one. The smallest solution of a Pell
#  equation is read off a list for d from 2 to 15. A solution is entered
#  as a point.
#
#  Four mistakes are looked for: taking every c to give a solvable
#  equation, stepping from one solution to the next by b where b / gcd(a, b)
#  belongs, adding the reciprocals of the partial quotients one after the
#  other, and taking the product a b for the largest amount two stamps
#  cannot make.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  how many c up to N make a x + b y = c solvable, the value of a
#       continued fraction
#    2  the next solution after a given one, the x between 0 and b of a
#       solution, the largest amount two stamps cannot make and the number
#       of such amounts, a partial quotient of a fraction
#    3  the number of ways to make an amount from two stamps, the smallest
#       and the second smallest solution of a Pell equation
# ==========================================================================

attribute cost = 2 split

mistake gcd_condition_missed "takes a x + b y = c to have a solution for every c, where c must be a multiple of gcd(a, b)"
mistake step_not_reduced "steps from one solution to the next by b in x and a in y, where b / gcd(a, b) and a / gcd(a, b) belong"
mistake added_straight "adds the reciprocals of the partial quotients one after the other, where each fraction stands below the one before"
mistake product_taken "takes the product a b for the largest amount that cannot be made, where a b - a - b belongs"

synth kind on Q
synth text on Q
synth answer_value on Q

# Two numbers a < b from 3 to 12 with no common factor.
synth small on C
synth large on C

start Q

C -> integer_between(3, 11) integer_between(4, 12) {
  require $1.value < $2.value and gcd($1.value, $2.value) = 1
  small = $1.value
  large = $2.value
}

# ---- Price 1 --------------------------------------------------------------

# a = g a' and b = g b' with a' and b' coprime: the equation can be solved
# exactly for the multiples of g, and there are floor(N / g) of them up to
# N.
Q -> "solvable_count" integer_between(2, 6) C integer_between(20, 100) when cost = 1 {
  cost = -1
  kind = "solvable_count"
  let g = $2.value
  let limit = $4.value
  text = "For how many of the whole numbers [`c`] from [`1`] to [`" ++ str(limit) ++ "`] does the equation [`" ++ str(g * $3.small) ++ "x + "
         ++ str(g * $3.large) ++ "y = c`] have a solution in integers [`x`] and [`y`]?"
  answer_value = (limit - limit % g) / g
  mistake gcd_condition_missed answer_value = limit
}

# [a_0; a_1, a_2] is a_0 + 1 / (a_1 + 1 / a_2), and with a fourth partial
# quotient one level deeper. The last child says whether it is there.
Q -> "continued_value" integer_between(0, 5) integer_between(1, 6) integer_between(1, 6) integer_between(2, 6) integer_between(0, 1) when cost = 1 {
  cost = -1
  kind = "continued_value"
  let deepest = cond($6.value = 1, $4.value + 1 / $5.value, $4.value)
  require $6.value = 1 or $4.value >= 2
  text = "Write the continued fraction [`[" ++ str($2.value) ++ "; " ++ str($3.value) ++ ", " ++ str($4.value)
         ++ cond($6.value = 1, ", " ++ str($5.value), "") ++ "]`] as a single fraction. Here [`[a_0; a_1, a_2, \ldots]`] stands for [`a_0 + \frac{1}{a_1 + \frac{1}{a_2 + \cdots}}`]."
  answer_value = $2.value + 1 / ($3.value + 1 / deepest)
  mistake added_straight answer_value = $2.value + 1 / $3.value + 1 / $4.value + cond($6.value = 1, 1 / $5.value, 0)
}

# ---- Price 2 --------------------------------------------------------------

# The solutions are (x_0 + (b / g) t, y_0 - (a / g) t), so the next one has
# t = 1. The equation is g a' x + g b' y = c with c computed from the
# solution given.
Q -> "next_solution" integer_between(1, 4) C integer_between(-9, 9) integer_between(-9, 9) when cost = 2 weight 2 {
  cost = -2
  kind = "next_solution"
  let g = $2.value
  let a = g * $3.small
  let b = g * $3.large
  text = "The pair [`(x, y) = (" ++ str($4.value) ++ ", " ++ str($5.value) ++ ")`] is a solution in integers of [`" ++ str(a) ++ "x + " ++ str(b)
         ++ "y = " ++ str(a * $4.value + b * $5.value) ++ "`]. Find the solution in integers with the least [`x`] greater than [`" ++ str($4.value)
         ++ "`]. Enter it as a point [`(x, y)`]."
  answer_value = point2($4.value + $3.large, $5.value - $3.small)
  mistake step_not_reduced answer_value = point2($4.value + b, $5.value - a)
}

# a and b are coprime, so x is known modulo b: one solution has
# 0 <= x < b. It is chosen, with any y, and c is computed.
Q -> "solution_in_range" C integer_between(0, 11) integer_between(-9, 9) when cost = 2 weight 2 {
  cost = -2
  kind = "solution_in_range"
  require $3.value < $2.large
  text = "The equation [`" ++ str($2.small) ++ "x + " ++ str($2.large) ++ "y = " ++ str($2.small * $3.value + $2.large * $4.value)
         ++ "`] has exactly one solution in integers with [`0 \le x < " ++ str($2.large) ++ "`]. Find its [`x`]."
  answer_value = $3.value
}

# With coprime a and b the largest amount that a x + b y, x and y not
# negative, cannot make is a b - a - b, and (a - 1)(b - 1) / 2 amounts
# cannot be made. The last child says which is asked.
Q -> "stamps" C integer_between(0, 1) when cost = 2 weight 2 {
  cost = -2
  kind = cond($3.value = 0, "largest_gap", "gap_count")
  text = "Stamps come in two values, [`" ++ str($2.small) ++ "`] cents and [`" ++ str($2.large) ++ "`] cents. "
         ++ cond($3.value = 0, "What is the largest whole number of cents that cannot be made up exactly with such stamps?",
                 "How many whole numbers of cents, from [`1`] upwards, cannot be made up exactly with such stamps?")
  answer_value = cond($3.value = 0, $2.small * $2.large - $2.small - $2.large, ($2.small - 1) * ($2.large - 1) / 2)
  mistake product_taken answer_value = cond($3.value = 0, $2.small * $2.large, answer_value)
}

# The fraction is built from [a_0; a_1, a_2, a_3] with a_3 at least 2: its
# denominator is a_1 (a_2 a_3 + 1) + a_3 and its numerator a_0 times that
# plus a_2 a_3 + 1. The last child says which partial quotient is asked.
Q -> "partial_quotient" integer_between(0, 4) integer_between(1, 5) integer_between(1, 5) integer_between(2, 5) integer_between(1, 3) when cost = 2 weight 2 {
  cost = -2
  kind = "partial_quotient"
  let inner = $4.value * $5.value + 1
  let below = $3.value * inner + $5.value
  let above = $2.value * below + inner
  text = "The fraction [`\frac{" ++ str(above) ++ "}{" ++ str(below) ++ "}`] is the continued fraction [`[a_0; a_1, a_2, a_3] = a_0 + \frac{1}{a_1 + \frac{1}{a_2 + \frac{1}{a_3}}}`] with whole numbers [`a_1, a_2 \ge 1`] and [`a_3 \ge 2`]. Find [`a_{"
         ++ str($6.value) ++ "}`]."
  answer_value = cond($6.value = 1, $3.value, cond($6.value = 2, $4.value, $5.value))
}

# The least x that is not negative is c times the inverse of a modulo b,
# reduced modulo b; what is left of c is then a multiple of b, and each
# step takes b from x's share and a from y's. At least two ways are
# wanted, so that there is something to count.
Q -> "ways" C integer_between(30, 150) when cost = 3 weight 2 {
  cost = -3
  kind = "ways"
  let a = $2.small
  let b = $2.large
  let amount = $3.value
  let least = amount * mod_inverse(a, b) % b
  let rest = amount - a * least
  require rest >= 0
  let most = rest / b
  let count = (most - most % a) / a + 1
  require count >= 2
  text = "Stamps come in two values, [`" ++ str(a) ++ "`] cents and [`" ++ str(b) ++ "`] cents. In how many ways can exactly [`" ++ str(amount)
         ++ "`] cents be made up with such stamps? Two ways are different when they use different numbers of some stamp."
  answer_value = count
}

# The smallest solution in positive whole numbers, from a list, for the d
# from 2 to 15 that are not squares (13, whose smallest solution has three
# digits, is left out). The next one is (x^2 + d y^2, 2 x y). The last
# child says which is asked.
Q -> "pell" integer_between(1, 11) integer_between(0, 1) when cost = 3 weight 2 {
  cost = -3
  kind = cond($3.value = 0, "pell_least", "pell_next")
  let d = cond($2.value = 1, 2, cond($2.value = 2, 3, cond($2.value = 3, 5, cond($2.value = 4, 6, cond($2.value = 5, 7, cond($2.value = 6, 8,
          cond($2.value = 7, 10, cond($2.value = 8, 11, cond($2.value = 9, 12, cond($2.value = 10, 14, 15))))))))))
  let x1 = cond(d = 2, 3, cond(d = 3, 2, cond(d = 5, 9, cond(d = 6, 5, cond(d = 7, 8, cond(d = 8, 3, cond(d = 10, 19, cond(d = 11, 10,
           cond(d = 12, 7, cond(d = 14, 15, 4))))))))))
  let y1 = cond(d = 2, 2, cond(d = 3, 1, cond(d = 5, 4, cond(d = 6, 2, cond(d = 7, 3, cond(d = 8, 1, cond(d = 10, 6, cond(d = 11, 3,
           cond(d = 12, 2, cond(d = 14, 4, 1))))))))))
  text = "Among the solutions in positive whole numbers of [`x^{2} - " ++ str(d) ++ "y^{2} = 1`], find the one with the "
         ++ cond($3.value = 0, "least", "second least") ++ " [`x`]. Enter it as a point [`(x, y)`]."
  answer_value = cond($3.value = 0, point2(x1, y1), point2(x1 ^ 2 + d * y1 ^ 2, 2 * x1 * y1))
}

prompt "{Q.text}"
answer Q.answer_value
