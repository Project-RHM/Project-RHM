# ==========================================================================
#  Groups
#
#  Orders of elements in cyclic groups, in a product of two cyclic groups,
#  in the group of units modulo a prime and in a symmetric group; the
#  number of elements of a given order and the number of generators of a
#  cyclic group; the index of a cyclic subgroup; and the number of
#  primitive roots of a prime. It goes on from number_theory.rhm and
#  modular_arithmetic.rhm, which compute with congruences.
#
#  A number whose Euler function is needed is built from its prime
#  factors, so the count is read off them. A permutation is a product of
#  disjoint cycles of consecutive numbers: its order is what is asked, not
#  how to find its cycles. The order of a unit modulo a prime is the least
#  power that gives 1, found among the divisors of p - 1.
#
#  Five mistakes are looked for: taking n for the order of k in Z_n,
#  adding the lengths of the cycles of a permutation where their least
#  common multiple belongs, multiplying the orders of the two parts of a
#  pair where their least common multiple belongs, counting every
#  non-identity element where only the generators count, and taking p - 1
#  for the order of every unit modulo p.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the order of k in Z_n, the order of a product of disjoint cycles
#    2  the order of (a, b) in Z_m x Z_n, the number of elements of order d
#       in Z_n, the order of a unit modulo a prime
#    3  the number of generators of Z_n, the index of the subgroup
#       generated by (a, b) in Z_m x Z_n, the number of primitive roots of
#       a prime
# ==========================================================================

attribute cost = 2 split

mistake gcd_ignored "takes n for the order of k in Z_n, where n / gcd(n, k) belongs"
mistake lengths_added "adds the lengths of the cycles, where their least common multiple belongs"
mistake orders_multiplied "multiplies the orders of the two parts of the pair, where their least common multiple belongs"
mistake all_nonzero "counts every element other than the identity, where only the generators count"
mistake fermat_bound "takes p - 1 for the order of every unit modulo p, where it is only the largest order there can be"

synth kind on Q
synth text on Q
synth answer_value on Q

# Two primes p < q from 2, 3, 5 and 7 and their powers: n = p^a q^b, with
# Euler's function p^(a-1)(p - 1) q^(b-1)(q - 1).
synth value on N
synth phi on N

# An element (a, b) of Z_m x Z_n: the two parts and the orders of the two.
synth left_modulus on E
synth right_modulus on E
synth left_part on E
synth right_part on E
synth first_order on E
synth second_order on E

start Q

N -> integer_between(1, 4) integer_between(1, 4) integer_between(1, 3) integer_between(1, 2) {
  require $1.value < $2.value
  let p = cond($1.value = 1, 2, cond($1.value = 2, 3, cond($1.value = 3, 5, 7)))
  let q = cond($2.value = 1, 2, cond($2.value = 2, 3, cond($2.value = 3, 5, 7)))
  value = p ^ $3.value * q ^ $4.value
  phi = p ^ ($3.value - 1) * (p - 1) * q ^ ($4.value - 1) * (q - 1)
}

# The two orders share a factor, so that their least common multiple is
# not their product.
E -> integer_between(4, 15) integer_between(4, 15) integer_between(1, 14) integer_between(1, 14) {
  require $3.value < $1.value and $4.value < $2.value
  left_modulus = $1.value
  right_modulus = $2.value
  left_part = $3.value
  right_part = $4.value
  first_order = $1.value / gcd($1.value, $3.value)
  second_order = $2.value / gcd($2.value, $4.value)
  require gcd($1.value / gcd($1.value, $3.value), $2.value / gcd($2.value, $4.value)) > 1
}

# ---- Price 1 --------------------------------------------------------------

Q -> "cyclic_order" integer_between(6, 30) integer_between(2, 29) when cost = 1 {
  cost = -1
  kind = "cyclic_order"
  require $3.value < $2.value
  text = "Find the order of the element [`" ++ str($3.value) ++ "`] in the group [`\mathbb{Z}_{" ++ str($2.value)
         ++ "}`] of the integers modulo [`" ++ str($2.value) ++ "`] under addition."
  answer_value = $2.value / gcd($2.value, $3.value)
  mistake gcd_ignored answer_value = $2.value
}

# Cycles of lengths l1, l2 and, when the third child is 2 or more, l3, on
# consecutive numbers from 1. The order is their least common multiple.
Q -> "permutation_order" integer_between(2, 5) integer_between(2, 5) integer_between(0, 4) when cost = 1 {
  cost = -1
  kind = "permutation_order"
  let l1 = $2.value
  let l2 = $3.value
  let l3 = cond($4.value >= 2, $4.value, 0)
  require l1 + l2 + l3 <= 9
  let s2 = l1 + 1
  let s3 = l1 + l2 + 1
  let first = "(1 2" ++ cond(l1 >= 3, " 3", "") ++ cond(l1 >= 4, " 4", "") ++ cond(l1 >= 5, " 5", "") ++ ")"
  let second = "(" ++ str(s2) ++ " " ++ str(s2 + 1) ++ cond(l2 >= 3, " " ++ str(s2 + 2), "") ++ cond(l2 >= 4, " " ++ str(s2 + 3), "")
               ++ cond(l2 >= 5, " " ++ str(s2 + 4), "") ++ ")"
  let third = cond(l3 = 0, "", "(" ++ str(s3) ++ " " ++ str(s3 + 1) ++ cond(l3 >= 3, " " ++ str(s3 + 2), "")
                                   ++ cond(l3 >= 4, " " ++ str(s3 + 3), "") ++ ")")
  let order = cond(l3 = 0, lcm(l1, l2), lcm(lcm(l1, l2), l3))
  require order != l1 + l2 + l3
  text = "Find the order of the permutation [`" ++ first ++ second ++ third ++ "`] of [`\{1, 2, \ldots, 9\}`], written in cycle notation."
  answer_value = order
  mistake lengths_added answer_value = l1 + l2 + l3
}

# ---- Price 2 --------------------------------------------------------------

Q -> "pair_order" E when cost = 2 weight 2 {
  cost = -2
  kind = "pair_order"
  text = "Find the order of the element [`(" ++ str($2.left_part) ++ ", " ++ str($2.right_part) ++ ")`] in the group [`\mathbb{Z}_{" ++ str($2.left_modulus)
         ++ "} \times \mathbb{Z}_{" ++ str($2.right_modulus) ++ "}`]."
  answer_value = lcm($2.first_order, $2.second_order)
  mistake orders_multiplied answer_value = $2.first_order * $2.second_order
}

# d = p^a or p^a q with p < q, and n a multiple of it. The elements of
# order d are the generators of the one subgroup of order d: phi(d) of
# them.
Q -> "elements_of_order" integer_between(1, 3) integer_between(1, 2) integer_between(0, 3) integer_between(1, 4) when cost = 2 weight 2 {
  cost = -2
  kind = "elements_of_order"
  let p = cond($2.value = 1, 2, cond($2.value = 2, 3, 5))
  let q = cond($4.value = 0, 1, cond($4.value = 1, 3, cond($4.value = 2, 5, 7)))
  require q = 1 or q > p
  let d = p ^ $3.value * q
  require d >= 3
  let n = d * $5.value
  text = "How many elements of order [`" ++ str(d) ++ "`] does the group [`\mathbb{Z}_{" ++ str(n) ++ "}`] have?"
  answer_value = p ^ ($3.value - 1) * (p - 1) * cond(q = 1, 1, q - 1)
  mistake all_nonzero answer_value = d - 1
}

# The least k with a^k = 1 modulo p, which divides p - 1.
Q -> "unit_order" integer_between(1, 5) integer_between(2, 17) when cost = 2 weight 2 {
  cost = -2
  kind = "unit_order"
  let p = cond($2.value = 1, 7, cond($2.value = 2, 11, cond($2.value = 3, 13, cond($2.value = 4, 17, 19))))
  let a = $3.value
  require a <= p - 2
  text = "Find the order of [`" ++ str(a) ++ "`] in the group of units modulo [`" ++ str(p)
         ++ "`], the least positive [`k`] with [`" ++ str(a) ++ "^{k} \equiv 1 \pmod{" ++ str(p) ++ "}`]."
  answer_value = cond(pow_mod(a, 1, p) = 1, 1, cond(pow_mod(a, 2, p) = 1, 2, cond(pow_mod(a, 3, p) = 1, 3, cond(pow_mod(a, 4, p) = 1, 4,
                 cond(pow_mod(a, 5, p) = 1, 5, cond(pow_mod(a, 6, p) = 1, 6, cond(pow_mod(a, 7, p) = 1, 7, cond(pow_mod(a, 8, p) = 1, 8,
                 cond(pow_mod(a, 9, p) = 1, 9, cond(pow_mod(a, 10, p) = 1, 10, cond(pow_mod(a, 11, p) = 1, 11, cond(pow_mod(a, 12, p) = 1, 12,
                 cond(pow_mod(a, 13, p) = 1, 13, cond(pow_mod(a, 14, p) = 1, 14, cond(pow_mod(a, 15, p) = 1, 15, cond(pow_mod(a, 16, p) = 1, 16,
                 cond(pow_mod(a, 17, p) = 1, 17, 18)))))))))))))))))
  mistake fermat_bound answer_value = p - 1
}

# ---- Price 3 --------------------------------------------------------------

# The generators of Z_n are the k coprime to n: phi(n) of them.
Q -> "generators" N when cost = 3 weight 2 {
  cost = -3
  kind = "generators"
  require $2.value <= 200
  text = "How many elements of the group [`\mathbb{Z}_{" ++ str($2.value) ++ "}`] generate the whole group?"
  answer_value = $2.phi
  mistake all_nonzero answer_value = $2.value - 1
}

# The subgroup generated by (a, b) has as many elements as the order of
# (a, b), so its index is m n over that order.
Q -> "pair_index" E when cost = 3 {
  cost = -3
  kind = "pair_index"
  text = "Find the index of the subgroup generated by [`(" ++ str($2.left_part) ++ ", " ++ str($2.right_part) ++ ")`] in the group [`\mathbb{Z}_{" ++ str($2.left_modulus)
         ++ "} \times \mathbb{Z}_{" ++ str($2.right_modulus) ++ "}`], the number of its cosets."
  answer_value = $2.left_modulus * $2.right_modulus / lcm($2.first_order, $2.second_order)
  mistake orders_multiplied answer_value = $2.left_modulus * $2.right_modulus / ($2.first_order * $2.second_order)
}

# The units modulo a prime p form a cyclic group of order p - 1, which has
# phi(p - 1) generators, the primitive roots.
Q -> "primitive_roots" integer_between(1, 12) when cost = 3 {
  cost = -3
  kind = "primitive_roots"
  let p = cond($2.value = 1, 7, cond($2.value = 2, 11, cond($2.value = 3, 13, cond($2.value = 4, 17, cond($2.value = 5, 19,
          cond($2.value = 6, 23, cond($2.value = 7, 29, cond($2.value = 8, 31, cond($2.value = 9, 37, cond($2.value = 10, 41,
          cond($2.value = 11, 43, 47)))))))))))
  let count = cond(p = 7, 2, cond(p = 11, 4, cond(p = 13, 4, cond(p = 17, 8, cond(p = 19, 6, cond(p = 23, 10, cond(p = 29, 12,
              cond(p = 31, 8, cond(p = 37, 12, cond(p = 41, 16, cond(p = 43, 12, 22)))))))))))
  text = "How many primitive roots does the prime [`" ++ str(p) ++ "`] have? (A primitive root modulo [`" ++ str(p)
         ++ "`] is a unit whose powers give every unit modulo [`" ++ str(p) ++ "`].)"
  answer_value = count
  mistake all_nonzero answer_value = p - 2
}

prompt "{Q.text}"
answer Q.answer_value
