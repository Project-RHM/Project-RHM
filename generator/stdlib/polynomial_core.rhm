# ==========================================================================
#  Products of polynomial factors: the tree shared by factoring and
#  expansion
#
#  This file is a library: it has no start symbol, prompt or answer, and is
#  included by factoring.rhm, polynomial_expand.rhm and polynomial_forms.rhm,
#  each of which asks its own question of the same tree. The factors are
#  built first and multiplied out with the Polynomial library, so a question
#  can show either side and hold the other as the answer.
#
#  Difficulty is the budget `cost`, spent exactly:
#
#    a product of two factors          2
#    a square                          1        a cube                   2
#    monic linear factor x + b         0        linear factor ax + b     1
#    irreducible quadratic x^2 + c     2
#
#  Every linear factor in one tree is distinct (one bit per factor, disjoint
#  across a product), so a repeated factor only ever appears as a power and
#  the factored form is the complete one.
# ==========================================================================

attribute cost = 5 split

synth poly on E                # the product, expanded
synth factored on E            # the product as a formula of its factors
synth latex on E               # the factored form as the student sees it
synth factors on E             # how many factors, counting multiplicity
synth mask on E                # one bit per distinct factor
synth poly on L
synth factored on L
synth latex on L
synth mask on L
synth value on L               # generator leaves carry `value`; declared once

# ---- Products and powers -------------------------------------------------
#
# Each rule's guard is the least it can spend.

E -> E "\cdot" E when cost >= 2 weight 3 {
  cost = -2
  require $1.latex != $3.latex
  require bit_and($1.mask, $3.mask) = 0
  poly = polynomial_multiply($1.poly, $3.poly)
  factored = formula_multiply($1.factored, $3.factored)
  latex = $1.latex ++ $3.latex
  factors = $1.factors + $3.factors
  mask = bit_or($1.mask, $3.mask)
}

E -> L "square" when cost >= 1 and cost <= 3 weight 2 {
  cost = -1
  poly = polynomial_power($1.poly, 2)
  factored = formula_power($1.factored, 2)
  latex = "(" ++ $1.latex ++ ")^{2}"
  factors = 2
  mask = $1.mask
}

E -> L "cube" when cost >= 2 and cost <= 4 weight 1 {
  cost = -2
  poly = polynomial_power($1.poly, 3)
  factored = formula_power($1.factored, 3)
  latex = "(" ++ $1.latex ++ ")^{3}"
  factors = 3
  mask = $1.mask
}

E -> L when cost <= 2 {
  poly = $1.poly
  factored = $1.factored
  latex = "(" ++ $1.latex ++ ")"
  factors = 1
  mask = $1.mask
}

# ---- Factors -------------------------------------------------------------
#
# A factor's bit is its index among the possible factors: the linear ones
# ax + b with a in 1..3 and b in -6..6 take 0..38, the quadratics x^2 + c
# with c in 1..9 take 39..47.

L -> "monic" nonzero_integer_between(-6, 6) when cost = 0 weight 3 {
  poly = polynomial_linear(1, $2.value, "x")
  factored = polynomial_formula(poly)
  latex = polynomial_latex(poly)
  value = poly
  mask = 2 ^ ($2.value + 6)
}

# a is 2 or 3, both prime, so the factor is primitive when a does not
# divide b.
L -> integer_between(2, 3) nonzero_integer_between(-5, 5) when cost = 1 weight 2 {
  cost = -1
  require $2.value % $1.value != 0
  poly = polynomial_linear($1.value, $2.value, "x")
  factored = polynomial_formula(poly)
  latex = polynomial_latex(poly)
  value = poly
  mask = 2 ^ (($1.value - 1) * 13 + $2.value + 6)
}

L -> "irreducible" integer_between(1, 9) when cost = 2 weight 1 {
  cost = -2
  poly = polynomial_quadratic(1, 0, $2.value, "x")
  factored = polynomial_formula(poly)
  latex = polynomial_latex(poly)
  value = poly
  mask = 2 ^ (39 + $2.value - 1)
}
