# ==========================================================================
#  Exponentials and logarithms
#
#  Values of logarithms and equations in exponentials and logarithms, with
#  exact answers. Each equation is built so that it comes down to powers of
#  one base: a logarithm is taken of a power of its base, two bases are
#  powers of the same number, a logarithmic equation is made from its root.
#  The two hardest forms have a second candidate that must be rejected: a
#  root outside the domain of the logarithm, or a negative value for an
#  exponential.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  log_b of a power of b (or of its reciprocal), b^(x + c) = b^k
#    2  two bases that are powers of one number, log_b(p x + q) = k
#    3  log_b(x) + log_b(x - d) = log_b(N) with one root rejected,
#       a quadratic in b^x with one factor that has no solution
# ==========================================================================

attribute cost = 2 split

synth kind on Q
synth text on Q
synth answer_value on Q

start Q

# ---- Price 1 --------------------------------------------------------------

# log_b(b^k) = k and log_b(1 / b^k) = -k.
Q -> "log_value" integer_between(2, 5) integer_between(2, 4) nonzero_integer_between(-1, 1) when cost = 1 {
  cost = -1
  kind = "log_value"
  text = "Evaluate [`\log_{" ++ str($2.value) ++ "}\left("
         ++ cond($4.value > 0, str($2.value ^ $3.value), "\frac{1}{" ++ str($2.value ^ $3.value) ++ "}") ++ "\right)`]."
  answer_value = $4.value * $3.value
}

# b^(x + c) = b^k, the right side written as a number: x = k - c.
Q -> "same_base" integer_between(2, 5) integer_between(2, 4) nonzero_integer_between(-6, 6) when cost = 1 weight 2 {
  cost = -1
  kind = "same_base"
  text = "Solve [`" ++ str($2.value) ++ "^{" ++ polynomial_latex(polynomial_linear(1, $4.value, "x")) ++ "} = "
         ++ str($2.value ^ $3.value) ++ "`] for [`x`]."
  answer_value = $3.value - $4.value
}

# ---- Price 2 --------------------------------------------------------------

# (b^m)^(x + c) = (b^n)^(x + d): m (x + c) = n (x + d).
Q -> "two_bases" integer_between(2, 3) integer_between(1, 3) integer_between(1, 3) integer_between(-5, 5) integer_between(-5, 5) when cost = 2 weight 2 {
  cost = -2
  kind = "two_bases"
  require $3.value != $4.value
  require $5.value != $6.value
  text = "Solve [`" ++ str($2.value ^ $3.value) ++ "^{" ++ polynomial_latex(polynomial_linear(1, $5.value, "x")) ++ "} = "
         ++ str($2.value ^ $4.value) ++ "^{" ++ polynomial_latex(polynomial_linear(1, $6.value, "x")) ++ "}`] for [`x`]."
  answer_value = ($4.value * $6.value - $3.value * $5.value) / ($3.value - $4.value)
}

# log_b(p x + q) = k with q = b^k - p r, so the root is r.
Q -> "log_equation" integer_between(2, 5) integer_between(1, 3) integer_between(1, 5) integer_between(-9, 9) when cost = 2 weight 2 {
  cost = -2
  kind = "log_equation"
  require $2.value ^ $3.value != $4.value * $5.value
  text = "Solve [`\log_{" ++ str($2.value) ++ "}\left("
         ++ polynomial_latex(polynomial_linear($4.value, $2.value ^ $3.value - $4.value * $5.value, "x"))
         ++ "\right) = " ++ str($3.value) ++ "`] for [`x`]."
  answer_value = $5.value
}

# ---- Price 3 --------------------------------------------------------------

# x (x - (r - s)) = r s has the roots r and -s; only r > 0 is in the domain.
Q -> "log_sum" integer_between(2, 5) integer_between(1, 9) integer_between(1, 9) when cost = 3 weight 2 {
  cost = -3
  kind = "log_sum"
  require $3.value != $4.value
  text = "Solve [`\log_{" ++ str($2.value) ++ "}\left(x\right) + \log_{" ++ str($2.value) ++ "}\left("
         ++ polynomial_latex(polynomial_linear(1, $4.value - $3.value, "x")) ++ "\right) = \log_{" ++ str($2.value)
         ++ "}\left(" ++ str($3.value * $4.value) ++ "\right)`] for [`x`]."
  answer_value = $3.value
}

# (b^x - b^m)(b^x + c) = 0 written out; b^x = -c has no solution, so x = m.
Q -> "quadratic_exp" integer_between(2, 3) integer_between(1, 3) integer_between(1, 9) when cost = 3 weight 2 {
  cost = -3
  kind = "quadratic_exp"
  require $4.value != $2.value ^ $3.value
  text = "Solve [`" ++ str($2.value) ++ "^{2x} " ++ cond($4.value > $2.value ^ $3.value, "+ ", "- ")
         ++ cond(abs($4.value - $2.value ^ $3.value) = 1, "", str(abs($4.value - $2.value ^ $3.value)) ++ " \cdot ")
         ++ str($2.value) ++ "^{x} - " ++ str($4.value * $2.value ^ $3.value) ++ " = 0`] for [`x`]."
  answer_value = $3.value
}

prompt "{Q.text}"
answer Q.answer_value
