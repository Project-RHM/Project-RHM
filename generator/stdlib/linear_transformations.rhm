# ==========================================================================
#  Linear transformations
#
#  A linear transformation of the plane and its matrix: the image of a
#  vector, the matrix from the images of the standard basis and from the
#  images of two other vectors, the matrix of one transformation after
#  another, the area of an image, the dimensions of the kernel and the
#  image of a transformation of space, the vector that is sent to a given
#  one, the matrix in another basis, and the matrix of a reflection. It
#  goes on from matrix_expr.rhm and row_reduction.rhm, which compute with
#  matrices as such.
#
#  Where something is to be found, it is chosen first: a vector that is
#  sent to a given one is drawn and its image shown; a matrix that is to
#  be found from two images is drawn and applied to two vectors. Those two
#  vectors, and the vectors of a new basis, are the columns of a matrix of
#  determinant 1, so that nothing found has a fraction in it. A reflection
#  is in a line whose direction has whole entries with no common factor,
#  and its matrix has fractions.
#
#  Three mistakes are looked for: writing the images of the basis vectors
#  as the rows of the matrix, multiplying the matrices of two
#  transformations in the order they are applied, and changing basis the
#  wrong way round. A question is asked only where the mistake gives
#  another matrix.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the image of a vector, the matrix from the images of (1, 0) and
#       (0, 1)
#    2  the matrix of one transformation after another, the area of the
#       image of a region, the dimension of the kernel or of the image of a
#       transformation of space, the vector sent to a given one
#    3  the matrix from the images of two other vectors, the matrix in
#       another basis, the matrix of a reflection in a line
# ==========================================================================

attribute cost = 2 split

mistake images_as_rows "writes the images of the basis vectors as the rows of the matrix, where they are its columns"
mistake order_swapped "multiplies the two matrices in the order the transformations are applied, the first on the left"
mistake basis_wrong_way "changes basis the wrong way round: P A P^(-1) where P^(-1) A P belongs"

synth kind on Q
synth text on Q
synth answer_value on Q
synth pg_context on Q

# One coordinate of an image, a x + b y with neither number 0.
synth first on R
synth second on R
synth latex on R

# A transformation of the plane: its matrix, and the vector it sends
# (x, y) to, as LaTeX.
synth map on M
synth rule on M

# A matrix of determinant 1 with no 0 in it, (1, q; p, p q + 1): the
# matrix, its two columns, and the columns as LaTeX.
synth map on U
synth column1 on U
synth column2 on U
synth latex1 on U
synth latex2 on U

# A row of three whole numbers, not all 0.
synth arrow on W

start Q

R -> nonzero_integer_between(-4, 4) nonzero_integer_between(-4, 4) {
  first = $1.value
  second = $2.value
  latex = cond($1.value = 1, "", cond($1.value = -1, "-", str($1.value))) ++ "x" ++ cond($2.value > 0, " + ", " - ")
          ++ cond(abs($2.value) = 1, "", str(abs($2.value))) ++ "y"
}

M -> R R {
  map = matrix2($1.first, $1.second, $2.first, $2.second)
  rule = "\langle " ++ $1.latex ++ ", \; " ++ $2.latex ++ " \rangle"
}

U -> nonzero_integer_between(-3, 3) nonzero_integer_between(-3, 3) {
  require $1.value * $2.value != -1
  map = matrix2(1, $2.value, $1.value, $1.value * $2.value + 1)
  column1 = vector2(1, $1.value)
  column2 = vector2($2.value, $1.value * $2.value + 1)
  latex1 = vector_latex(vector2(1, $1.value))
  latex2 = vector_latex(vector2($2.value, $1.value * $2.value + 1))
}

W -> integer_between(-3, 3) integer_between(-3, 3) integer_between(-3, 3) {
  require $1.value != 0 or $2.value != 0 or $3.value != 0
  arrow = vector3($1.value, $2.value, $3.value)
}

# ---- Price 1 --------------------------------------------------------------

Q -> "image" M nonzero_integer_between(-5, 5) nonzero_integer_between(-5, 5) when cost = 1 {
  cost = -1
  kind = "image"
  text = "The linear transformation [`T`] of the plane sends [`\langle x, y \rangle`] to [`" ++ $2.rule
         ++ "`]. Find the image of [`" ++ vector_latex(vector2($3.value, $4.value)) ++ "`] under [`T`]."
  answer_value = matrix_vector($2.map, vector2($3.value, $4.value))
  pg_context = "Vector"
}

# The images of the standard basis are the columns of the matrix. The
# matrix is not symmetric, so its rows are other vectors.
Q -> "standard_matrix" integer_between(-5, 5) integer_between(-5, 5) integer_between(-5, 5) integer_between(-5, 5) when cost = 1 {
  cost = -1
  kind = "standard_matrix"
  require $3.value != $4.value
  text = "A linear transformation [`T`] of the plane sends [`" ++ vector_latex(vector2(1, 0)) ++ "`] to [`"
         ++ vector_latex(vector2($2.value, $4.value)) ++ "`] and [`" ++ vector_latex(vector2(0, 1)) ++ "`] to [`"
         ++ vector_latex(vector2($3.value, $5.value)) ++ "`]. Find the matrix [`A`] with [`T(v) = Av`] for every vector [`v`]."
  answer_value = matrix2($2.value, $3.value, $4.value, $5.value)
  mistake images_as_rows answer_value = matrix2($2.value, $4.value, $3.value, $5.value)
  pg_context = "Matrix"
}

# ---- Price 2 --------------------------------------------------------------

# T first and S after it is v -> A_S (A_T v): the matrix of S stands on
# the left. The two matrices do not commute, so the order matters.
Q -> "composition" M M when cost = 2 weight 2 {
  cost = -2
  kind = "composition"
  require matrix_multiply($2.map, $3.map) != matrix_multiply($3.map, $2.map)
  text = "The linear transformations [`S`] and [`T`] of the plane have the matrices [`A_S = " ++ matrix_latex($2.map)
         ++ "`] and [`A_T = " ++ matrix_latex($3.map)
         ++ "`]. Find the matrix of the transformation that applies [`T`] first and then [`S`]."
  answer_value = matrix_multiply($2.map, $3.map)
  mistake order_swapped answer_value = matrix_multiply($3.map, $2.map)
  pg_context = "Matrix"
}

# Areas are multiplied by the absolute value of the determinant, which is
# not 0 here.
Q -> "area" M integer_between(1, 6) when cost = 2 {
  cost = -2
  kind = "area"
  require matrix_determinant($2.map) != 0
  text = "A linear transformation of the plane has the matrix [`" ++ matrix_latex($2.map) ++ "`]. A region of area [`" ++ str($3.value)
         ++ "`] is transformed by it. Find the area of its image."
  answer_value = $3.value * abs(matrix_determinant($2.map))
  pg_context = "Numeric"
}

# The third row is a combination of the first two, so the rank is 1 or 2:
# the image is a line or a plane and the kernel a plane or a line. Two
# rows drawn apart are hardly ever along each other, so one time in three
# the second row is a multiple of the first instead, and the rank is 1.
# The sixth child says which dimension is asked for. No row is all 0.
Q -> "dimensions" W W integer_between(-2, 2) integer_between(-2, 2) integer_between(0, 1) integer_between(0, 2) nonzero_integer_between(-2, 2) when cost = 2 weight 2 {
  cost = -2
  kind = cond($6.value = 0, "kernel_dimension", "image_dimension")
  let middle = cond($7.value = 0, vector_scale($8.value, $2.arrow), $3.arrow)
  let third = vector_add(vector_scale($4.value, $2.arrow), vector_scale($5.value, middle))
  require not vector_is_zero(third)
  let whole = matrix_stack(matrix_stack(matrix_row($2.arrow), matrix_row(middle)), matrix_row(third))
  text = "A linear transformation [`T`] of space has the matrix [`" ++ matrix_latex(whole) ++ "`]. Find the dimension of its "
         ++ cond($6.value = 0, "kernel, the set of vectors that [`T`] sends to the zero vector.",
                 "image, the set of all vectors [`T(v)`].")
  answer_value = cond($6.value = 0, 3 - matrix_rank(whole), matrix_rank(whole))
  pg_context = "Numeric"
}

# The vector is chosen and its image shown. The matrix has determinant 1,
# so there is one such vector and it has whole entries.
Q -> "preimage" U nonzero_integer_between(-5, 5) nonzero_integer_between(-5, 5) when cost = 2 weight 2 {
  cost = -2
  kind = "preimage"
  text = "A linear transformation [`T`] of the plane has the matrix [`" ++ matrix_latex($2.map) ++ "`]. Find the vector [`v`] with [`T(v) = "
         ++ vector_latex(matrix_vector($2.map, vector2($3.value, $4.value))) ++ "`]."
  answer_value = vector2($3.value, $4.value)
  pg_context = "Vector"
}

# ---- Price 3 --------------------------------------------------------------

# The matrix is chosen and applied to the two columns of a matrix of
# determinant 1; with those columns as U and their images as W, the matrix
# is W U^(-1).
Q -> "matrix_from_images" integer_between(-4, 4) integer_between(-4, 4) integer_between(-4, 4) integer_between(-4, 4) U when cost = 3 weight 2 {
  cost = -3
  kind = "matrix_from_images"
  let chosen = matrix2($2.value, $3.value, $4.value, $5.value)
  require matrix_determinant(chosen) != 0
  text = "A linear transformation [`T`] of the plane sends [`" ++ $6.latex1 ++ "`] to [`" ++ vector_latex(matrix_vector(chosen, $6.column1))
         ++ "`] and [`" ++ $6.latex2 ++ "`] to [`" ++ vector_latex(matrix_vector(chosen, $6.column2))
         ++ "`]. Find the matrix [`A`] with [`T(v) = Av`] for every vector [`v`]."
  answer_value = chosen
  pg_context = "Matrix"
}

# With the new basis as the columns of P, the matrix in that basis is
# P^(-1) A P. A matrix that commutes with P would be the same in both
# bases and is not asked, and neither is one whose entries in the new
# basis go beyond 30.
Q -> "new_basis" M U when cost = 3 weight 4 {
  cost = -3
  kind = "new_basis"
  let there = matrix_multiply(matrix_multiply(matrix_inverse($3.map), $2.map), $3.map)
  let back = matrix_multiply(matrix_multiply($3.map, $2.map), matrix_inverse($3.map))
  require there != $2.map and there != back
  require abs(matrix_entry(there, 1, 1)) <= 30 and abs(matrix_entry(there, 1, 2)) <= 30
  require abs(matrix_entry(there, 2, 1)) <= 30 and abs(matrix_entry(there, 2, 2)) <= 30
  text = "A linear transformation [`T`] of the plane has the matrix [`" ++ matrix_latex($2.map)
         ++ "`] in the standard basis. Find its matrix in the basis [`b_1 = " ++ $3.latex1 ++ "`], [`b_2 = " ++ $3.latex2 ++ "`]."
  answer_value = there
  mistake basis_wrong_way answer_value = back
  pg_context = "Matrix"
}

# The reflection in the line along (a, b) is twice the projection onto it
# less the identity: ((a^2 - b^2, 2ab), (2ab, b^2 - a^2)) / (a^2 + b^2).
Q -> "reflection" integer_between(1, 4) nonzero_integer_between(-4, 4) when cost = 3 weight 2 {
  cost = -3
  kind = "reflection"
  require gcd($2.value, abs($3.value)) = 1
  text = "Find the matrix of the reflection of the plane in its line through the origin in the direction of [`"
         ++ vector_latex(vector2($2.value, $3.value)) ++ "`]. Its entries may be fractions."
  answer_value = matrix_scale(1 / ($2.value ^ 2 + $3.value ^ 2),
                              matrix2($2.value ^ 2 - $3.value ^ 2, 2 * $2.value * $3.value, 2 * $2.value * $3.value,
                                      $3.value ^ 2 - $2.value ^ 2))
  pg_context = "Matrix"
}

prompt "{Q.text}"
answer Q.answer_value
