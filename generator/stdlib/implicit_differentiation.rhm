# ==========================================================================
#  Implicit differentiation
#
#  A curve given by an equation in x and y, and what its derivative says at
#  one of its points: the slope, a rate of change along the curve, where the
#  tangent meets the y-axis, and the second derivative. A question is built
#  from its point: the point is chosen first and the constant of the
#  equation is what the left side comes to there, so the point is on the
#  curve. Every answer is an exact fraction or a whole number.
#
#  An equation that looks like a curve and is not one is left out:
#  x^2 + 2xy + y^2 = c is the pair of lines x + y = +-sqrt(c), and
#  x^3 + y^3 = 3xy - 1 is the line x + y + 1 = 0 with one point beside it.
#
#  Two mistakes are looked for: leaving out the minus sign of
#  dy/dx = -F_x / F_y, and differentiating the product x y as if x were a
#  constant factor, which loses the term x dy/dx. A question is asked only
#  where each of them gives another number.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the slope of a circle, or of p x^2 + q y^2 = c, at a point
#    2  the slope of a curve with a product term, x^2 + k x y + y^2 = c or
#       x^3 + y^3 = k x y + c; dy/dt from dx/dt for a point moving on a
#       circle
#    3  where the tangent at a point meets the y-axis; the second
#       derivative at a point
# ==========================================================================

attribute cost = 2 split

mistake sign_dropped "takes dy/dx to be F_x / F_y and leaves out the minus sign"
mistake product_rule_missed "differentiates x y as if x were a constant factor, so the term x dy/dx is lost"

synth kind on Q
synth text on Q
synth answer_value on Q

# A point with neither coordinate zero.
synth across on P
synth up on P
synth latex on P

# p x^2 + q y^2 with p positive: an ellipse where q is positive too and a
# hyperbola where it is negative. p and q are different, so it is not a
# circle, and have no common factor, so the equation is in lowest terms.
synth x_part on E
synth y_part on E
synth latex on E

start Q

P -> nonzero_integer_between(-4, 4) nonzero_integer_between(-4, 4) {
  across = $1.value
  up = $2.value
  latex = "\left(" ++ str($1.value) ++ ", " ++ str($2.value) ++ "\right)"
}

E -> integer_between(1, 4) nonzero_integer_between(-3, 4) {
  require $1.value != $2.value
  require gcd($1.value, abs($2.value)) = 1
  x_part = $1.value
  y_part = $2.value
  latex = cond($1.value = 1, "", str($1.value)) ++ "x^{2}" ++ cond($2.value > 0, " + ", " - ")
          ++ cond(abs($2.value) = 1, "", str(abs($2.value))) ++ "y^{2}"
}

# ---- Price 1 --------------------------------------------------------------

# 2x + 2y y' = 0.
Q -> "circle" P when cost = 1 {
  cost = -1
  kind = "circle"
  text = "Find the slope [`\dfrac{dy}{dx}`] of the circle [`x^{2} + y^{2} = " ++ str($2.across ^ 2 + $2.up ^ 2)
         ++ "`] at the point [`" ++ $2.latex ++ "`]."
  answer_value = 0 - $2.across / $2.up
  mistake sign_dropped answer_value = $2.across / $2.up
}

# 2 p x + 2 q y y' = 0. A constant of 0 would be a pair of lines.
Q -> "conic" E P when cost = 1 weight 2 {
  cost = -1
  kind = "conic"
  let constant = $2.x_part * $3.across ^ 2 + $2.y_part * $3.up ^ 2
  require constant != 0
  text = "Find the slope [`\dfrac{dy}{dx}`] of the curve [`" ++ $2.latex ++ " = " ++ str(constant)
         ++ "`] at the point [`" ++ $3.latex ++ "`]."
  answer_value = 0 - $2.x_part * $3.across / ($2.y_part * $3.up)
  mistake sign_dropped answer_value = $2.x_part * $3.across / ($2.y_part * $3.up)
}

# ---- Price 2 --------------------------------------------------------------

# 2x + k y + k x y' + 2 y y' = 0, so y' = -(2x + k y) / (k x + 2y). A point
# where the tangent is level or upright is not asked. k is 1 or 3 with
# either sign: with 2 the left side is the square of x + y or of x - y.
Q -> "product" nonzero_integer_between(-3, 3) P when cost = 2 weight 2 {
  cost = -2
  kind = "product"
  require abs($2.value) != 2
  let top = 2 * $3.across + $2.value * $3.up
  let bottom = $2.value * $3.across + 2 * $3.up
  require top != 0 and bottom != 0
  text = "Find the slope [`\dfrac{dy}{dx}`] of the curve [`x^{2}" ++ cond($2.value > 0, " + ", " - ")
         ++ cond(abs($2.value) = 1, "", str(abs($2.value))) ++ "xy + y^{2} = "
         ++ str($3.across ^ 2 + $2.value * $3.across * $3.up + $3.up ^ 2) ++ "`] at the point [`" ++ $3.latex ++ "`]."
  answer_value = 0 - top / bottom
  mistake sign_dropped answer_value = top / bottom
  mistake product_rule_missed answer_value = 0 - top / (2 * $3.up)
}

# 3x^2 + 3y^2 y' = k y + k x y', so y' = (k y - 3x^2) / (3y^2 - k x).
# x^3 + y^3 - 3xy + 1 has the factor x + y + 1, and x^3 + y^3 + 3xy - 1 the
# factor x + y - 1: those two are a straight line and are not asked.
Q -> "cubic" nonzero_integer_between(-3, 3) P when cost = 2 weight 2 {
  cost = -2
  kind = "cubic"
  let top = $2.value * $3.up - 3 * $3.across ^ 2
  let bottom = 3 * $3.up ^ 2 - $2.value * $3.across
  let constant = $3.across ^ 3 + $3.up ^ 3 - $2.value * $3.across * $3.up
  require top != 0 and bottom != 0
  require abs($2.value) != 3 or $2.value * constant != 0 - 3
  text = "Find the slope [`\dfrac{dy}{dx}`] of the curve [`x^{3} + y^{3} = "
         ++ cond($2.value = 1, "", cond($2.value = 0 - 1, "-", str($2.value))) ++ "xy"
         ++ cond(constant = 0, "", cond(constant > 0, " + ", " - ") ++ str(abs(constant)))
         ++ "`] at the point [`" ++ $3.latex ++ "`]."
  answer_value = top / bottom
  mistake sign_dropped answer_value = 0 - top / bottom
  mistake product_rule_missed answer_value = top / (3 * $3.up ^ 2)
}

# 2x dx/dt + 2y dy/dt = 0.
Q -> "related_rate" P nonzero_integer_between(-5, 5) when cost = 2 {
  cost = -2
  kind = "related_rate"
  text = "A point moves along the circle [`x^{2} + y^{2} = " ++ str($2.across ^ 2 + $2.up ^ 2)
         ++ "`]. At the moment it passes through [`" ++ $2.latex ++ "`], its [`x`]-coordinate is changing at the rate [`\dfrac{dx}{dt} = "
         ++ str($3.value) ++ "`]. Find [`\dfrac{dy}{dt}`] at that moment."
  answer_value = 0 - $2.across * $3.value / $2.up
  mistake sign_dropped answer_value = $2.across * $3.value / $2.up
}

# ---- Price 3 --------------------------------------------------------------

# The tangent at (a, b) has the slope -p a / (q b) and meets the y-axis at
# b + p a^2 / (q b), which is c / (q b).
Q -> "tangent_intercept" E P when cost = 3 weight 2 {
  cost = -3
  kind = "tangent_intercept"
  let constant = $2.x_part * $3.across ^ 2 + $2.y_part * $3.up ^ 2
  require constant != 0
  let slope = 0 - $2.x_part * $3.across / ($2.y_part * $3.up)
  mistake sign_dropped slope = $2.x_part * $3.across / ($2.y_part * $3.up)
  text = "The tangent to the curve [`" ++ $2.latex ++ " = " ++ str(constant) ++ "`] at the point [`" ++ $3.latex
         ++ "`] meets the [`y`]-axis at the point [`(0, h)`]. Find [`h`]."
  answer_value = $3.up - slope * $3.across
}

# y' = -p x / (q y) is a constant times x / y, so y'' is that constant times
# (y - x y') / y^2, which is y' (y - x y') / (x y); with p x^2 + q y^2 = c
# put in it comes to -p c / (q^2 y^3). A slope with the wrong sign is
# carried into the second derivative.
Q -> "second_derivative" E P when cost = 3 weight 2 {
  cost = -3
  kind = "second_derivative"
  let constant = $2.x_part * $3.across ^ 2 + $2.y_part * $3.up ^ 2
  require constant != 0
  text = "Find [`\dfrac{d^{2}y}{dx^{2}}`] at the point [`" ++ $3.latex ++ "`] of the curve [`" ++ $2.latex ++ " = "
         ++ str(constant) ++ "`]."
  let slope = 0 - $2.x_part * $3.across / ($2.y_part * $3.up)
  mistake sign_dropped slope = $2.x_part * $3.across / ($2.y_part * $3.up)
  answer_value = slope * ($3.up - $3.across * slope) / ($3.across * $3.up)
}

prompt "{Q.text}"
answer Q.answer_value
