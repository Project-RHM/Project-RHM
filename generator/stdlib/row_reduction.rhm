# ==========================================================================
#  Row reduction: rank, reduced row echelon form, null space
#
#  Every matrix is built from its reduced row echelon form R: A = M R with
#  M an integer matrix of determinant 1 (a product of unit triangular
#  matrices). Multiplying on the left by an invertible matrix is a sequence
#  of row operations, so R is the reduced form of A, the rank of A is the
#  number of pivots of R, and the null space of A is that of R, which is
#  read off its free column. A has whole entries and is not already reduced.
#
#  Answers: the rank is a number; a reduced form is a matrix (Matrix
#  context); a vector of the null space is graded up to a non-zero multiple
#  (Vector context), since any such multiple is as good.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the rank of a 3 by 3 matrix (2 or 3)
#    2  the reduced row echelon form of a 2 by 3 matrix
#    3  the reduced row echelon form of a 3 by 4 matrix, a non-zero vector
#       of the null space of a 3 by 3 matrix of rank 2
# ==========================================================================

attribute cost = 2 split

random p = nonzero_integer_between(-2, 2)
random q = nonzero_integer_between(-2, 2)
random u1 = integer_between(-1, 1)
random u2 = integer_between(-1, 1)
random u3 = integer_between(-1, 1)
random v1 = integer_between(-1, 1)
random v2 = integer_between(-1, 1)
random v3 = integer_between(-1, 1)
random a = integer_between(-3, 3)
random b = integer_between(-3, 3)
random c = integer_between(-3, 3)
random d = integer_between(-3, 3)

# Determinant 1: [1 q; p pq+1], and L U with unit diagonals.
let mix2 = matrix2(1, q, p, p * q + 1)
let mix3 = matrix_multiply(matrix3(1, 0, 0, u1, 1, 0, u2, u3, 1), matrix3(1, v1, v2, 0, 1, v3, 0, 0, 1))

synth kind on Q
synth text on Q
synth answer_value on Q
synth pg_context on Q

start Q

# ---- Price 1 --------------------------------------------------------------

# [1 a b; 0 1 c; 0 0 t] has rank 2 when t = 0 and 3 when t = 1.
Q -> "rank" integer_between(0, 1) when cost = 1 {
  cost = -1
  kind = "rank"
  pg_context = "Numeric"
  let reduced = matrix3(1, a, b, 0, 1, c, 0, 0, $2.value)
  let matrix = matrix_multiply(mix3, reduced)
  require matrix != reduced
  text = "Find the rank of [`A = " ++ matrix_latex(matrix) ++ "`]."
  answer_value = 2 + $2.value
}

# ---- Price 2 --------------------------------------------------------------

# Pivots in columns 1 and 2, or in columns 1 and 3.
Q -> "rref_small" integer_between(0, 1) when cost = 2 {
  cost = -2
  kind = "rref_small"
  pg_context = "Matrix"
  let reduced = cond($2.value = 0,
                     matrix_stack(matrix_row(vector3(1, 0, a)), matrix_row(vector3(0, 1, b))),
                     matrix_stack(matrix_row(vector3(1, a, 0)), matrix_row(vector3(0, 0, 1))))
  let matrix = matrix_multiply(mix2, reduced)
  text = "Find the reduced row echelon form of [`A = " ++ matrix_latex(matrix) ++ "`]."
  answer_value = reduced
}

# ---- Price 3 --------------------------------------------------------------

# Three shapes: one free column and a row of zeros with the pivots together
# or apart, or three pivots (a system with one solution, as [I | x]).
Q -> "rref_large" integer_between(1, 3) when cost = 3 weight 2 {
  cost = -3
  kind = "rref_large"
  pg_context = "Matrix"
  let reduced = cond($2.value = 1,
                     matrix_stack(matrix_row(vector4(1, 0, a, b)), matrix_stack(matrix_row(vector4(0, 1, c, d)), matrix_row(vector4(0, 0, 0, 0)))),
                cond($2.value = 2,
                     matrix_stack(matrix_row(vector4(1, a, 0, b)), matrix_stack(matrix_row(vector4(0, 0, 1, c)), matrix_row(vector4(0, 0, 0, 0)))),
                     matrix_stack(matrix_row(vector4(1, 0, 0, a)), matrix_stack(matrix_row(vector4(0, 1, 0, b)), matrix_row(vector4(0, 0, 1, c))))))
  let matrix = matrix_multiply(mix3, reduced)
  require matrix != reduced
  text = "Find the reduced row echelon form of [`A = " ++ matrix_latex(matrix) ++ "`]."
  answer_value = reduced
}

# R = [1 0 a; 0 1 b; 0 0 0]: x = -a z and y = -b z, so (-a, -b, 1) spans
# the null space.
Q -> "null_vector" when cost = 3 weight 2 {
  cost = -3
  kind = "null_vector"
  pg_context = "Vector"
  let reduced = matrix3(1, 0, a, 0, 1, b, 0, 0, 0)
  let matrix = matrix_multiply(mix3, reduced)
  require matrix != reduced
  text = "Find a non-zero vector [`\mathbf{v}`] with [`A\mathbf{v} = \mathbf{0}`], where [`A = " ++ matrix_latex(matrix)
         ++ "`]. Enter it as a vector, such as [`\langle 1, -2, 3 \rangle`]."
  answer_value = vector_parallel_answer(vector3(0 - a, 0 - b, 1))
}

prompt "{Q.text}"
answer Q.answer_value
