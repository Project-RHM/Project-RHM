# ==========================================================================
#  A whole assignment in one file
#
#  This file asks for no question of its own. It imports four grammars and
#  describes two sets: which questions, how many of each, with what
#  budgets, in which order. `rhema homework_set.rhm --run homework` compiles the
#  set to one PG document with numbered parts; `rhema run` shows it.
#
#    rhema run homework_set.rhm --run homework              the assignment, in the terminal
#    rhema homework_set.rhm --run homework                  compiled to homework.pg
#    rhema homework_set.rhm --run quick --pg-dir out/       one .pg file per question
#    rhema homework_set.rhm --run homework --student 2330026211 -o hw_2330026211.pg
#                                                           one student's own paper
#
#  A set is one assignment and one paper: generating it again gives the same
#  questions. --student is optional and gives that student a paper of their
#  own, also the same every time.
#
#  Budgets are drawn three ways: a fixed value (cost = 6), one of a list
#  used evenly (cost in {8, 10, 12}), or around a mean, adjusted so that
#  the part's mean is exactly the mean asked for (cost ~ 6 spread 2). The
#  last is the expectation method of difficulty: the set, not the
#  question, is what has the chosen difficulty.
#
#  Constraints: `distinct` refuses a second question with the shape of an
#  earlier one, `balanced` refuses three equal coded answers in a row,
#  `ordered` puts easier questions first within a part.
# ==========================================================================

import "calculus.rhm" as calc
import "boolean.rhm" as bool
import "boolean_equiv.rhm" as laws
import "logic_forms.rhm" as forms

set homework {
  part "Differentiation"
    3 of calc.derivative(cost ~ 6 spread 2 low 2)
    1 of calc.integral(cost in {5, 7})
  part "Propositional logic"
    3 of bool.main(cost in {8, 10, 12})
    2 of laws.main(cost = 6)
  part "Mixed"
    2 of any(forms.main(cost = 6), calc.derivative(cost = 8))
  distinct
  balanced
  ordered
}

# A short flat set: no parts, every question under its own number.
set quick {
  4 of any(calc.derivative(cost = 5), bool.main(cost = 8))
  distinct
}
