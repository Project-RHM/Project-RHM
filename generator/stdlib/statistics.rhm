# ==========================================================================
#  Statistics
#
#  Summaries of a small data set, the expectation and variance of a random
#  variable given by its probabilities, and a binomial probability. Every
#  answer is exact. The data are built so that the summary can be read off
#  the numbers that made them: a data set is drawn in increasing order and
#  listed in a mixed order, so its median and range are known without
#  sorting; a data set for a variance is its mean plus five deviations that
#  add up to zero; probabilities are whole weights over their total, so they
#  add up to one.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the mean, the median (of five or six values) or the range of a data
#       set
#    2  the variance of a data set, a value missing from a known mean, the
#       expectation of a random variable
#    3  the variance of a random variable, the probability of at least two
#       successes in n trials
# ==========================================================================

attribute cost = 2 split

synth kind on Q
synth text on Q
synth answer_value on Q

# Five values in increasing order, listed in one of three mixed orders.
synth total on D
synth low on D
synth middle on D
synth above_middle on D
synth high on D
synth listing on D

# A random variable with three values and its probabilities.
synth mean on R
synth second_moment on R
synth listing on R

start Q

D -> integer_between(1, 12) integer_between(0, 6) integer_between(1, 6) integer_between(0, 6) integer_between(1, 6) integer_between(1, 3) {
  let v1 = $1.value
  let v2 = v1 + $2.value
  let v3 = v2 + $3.value
  let v4 = v3 + $4.value
  let v5 = v4 + $5.value
  low = v1
  middle = v3
  above_middle = v4
  high = v5
  total = v1 + v2 + v3 + v4 + v5
  listing = cond($6.value = 1,
                 str(v3) ++ ", " ++ str(v1) ++ ", " ++ str(v5) ++ ", " ++ str(v2) ++ ", " ++ str(v4),
            cond($6.value = 2,
                 str(v4) ++ ", " ++ str(v2) ++ ", " ++ str(v1) ++ ", " ++ str(v5) ++ ", " ++ str(v3),
                 str(v2) ++ ", " ++ str(v5) ++ ", " ++ str(v3) ++ ", " ++ str(v1) ++ ", " ++ str(v4)))
}

# Values s, s + t, s + t + u with weights w1, w2, w3 over their total.
R -> integer_between(0, 3) integer_between(1, 3) integer_between(1, 3) integer_between(1, 5) integer_between(1, 5) integer_between(1, 5) {
  let x1 = $1.value
  let x2 = x1 + $2.value
  let x3 = x2 + $3.value
  let weights = $4.value + $5.value + $6.value
  let p1 = $4.value / weights
  let p2 = $5.value / weights
  let p3 = $6.value / weights
  mean = x1 * p1 + x2 * p2 + x3 * p3
  second_moment = x1 ^ 2 * p1 + x2 ^ 2 * p2 + x3 ^ 2 * p3
  listing = "[`P(X = " ++ str(x1) ++ ") = " ++ number_latex(p1) ++ "`], "
            ++ "[`P(X = " ++ str(x2) ++ ") = " ++ number_latex(p2) ++ "`] and "
            ++ "[`P(X = " ++ str(x3) ++ ") = " ++ number_latex(p3) ++ "`]"
}

# ---- Price 1 --------------------------------------------------------------

Q -> "mean" D when cost = 1 {
  cost = -1
  kind = "mean"
  text = "Find the mean of the data [`" ++ $2.listing ++ "`]."
  answer_value = $2.total / 5
}

# With a sixth value above the others the median is halfway between the
# third and the fourth.
Q -> "median" D integer_between(0, 4) when cost = 1 {
  cost = -1
  kind = "median"
  text = "Find the median of the data [`" ++ cond($3.value = 0, "", str($2.high + $3.value) ++ ", ") ++ $2.listing ++ "`]."
  answer_value = cond($3.value = 0, $2.middle, ($2.middle + $2.above_middle) / 2)
}

Q -> "range" D when cost = 1 {
  cost = -1
  kind = "range"
  text = "Find the range of the data [`" ++ $2.listing ++ "`]."
  answer_value = $2.high - $2.low
}

# ---- Price 2 --------------------------------------------------------------

# m + d1, ..., m + d4 and m - (d1 + ... + d4): the mean is m and the
# variance is the mean of the squared deviations.
Q -> "variance" integer_between(6, 15) integer_between(-4, 4) integer_between(-4, 4) integer_between(-4, 4) integer_between(-4, 4) when cost = 2 weight 2 {
  cost = -2
  kind = "variance"
  let last = 0 - ($3.value + $4.value + $5.value + $6.value)
  require abs(last) <= 5
  require $3.value ^ 2 + $4.value ^ 2 + $5.value ^ 2 + $6.value ^ 2 > 0
  text = "Find the variance of the data [`" ++ str($2.value + $3.value) ++ ", " ++ str($2.value + $4.value) ++ ", "
         ++ str($2.value + $5.value) ++ ", " ++ str($2.value + last) ++ ", "
         ++ str($2.value + $6.value) ++ "`], dividing by the number of values (the population variance)."
  answer_value = ($3.value ^ 2 + $4.value ^ 2 + $5.value ^ 2 + $6.value ^ 2 + last ^ 2) / 5
}

Q -> "missing_value" integer_between(6, 15) integer_between(-5, 5) integer_between(-5, 5) integer_between(-5, 5) integer_between(-5, 5) when cost = 2 {
  cost = -2
  kind = "missing_value"
  let last = 0 - ($3.value + $4.value + $5.value + $6.value)
  require abs(last) <= 5
  text = "Five numbers have mean [`" ++ str($2.value) ++ "`]. Four of them are [`" ++ str($2.value + $3.value) ++ ", "
         ++ str($2.value + $4.value) ++ ", " ++ str($2.value + $5.value) ++ ", " ++ str($2.value + $6.value)
         ++ "`]. Find the fifth number."
  answer_value = $2.value + last
}

Q -> "expectation" R when cost = 2 weight 2 {
  cost = -2
  kind = "expectation"
  text = "A random variable [`X`] has " ++ $2.listing ++ ". Find the expectation [`E(X)`]."
  answer_value = $2.mean
}

# ---- Price 3 --------------------------------------------------------------

Q -> "rv_variance" R when cost = 3 weight 2 {
  cost = -3
  kind = "rv_variance"
  text = "A random variable [`X`] has " ++ $2.listing ++ ". Find the variance [`\mathrm{Var}(X)`]."
  answer_value = $2.second_moment - $2.mean ^ 2
}

# At least two successes: everything but none and exactly one.
Q -> "binomial_tail" integer_between(3, 5) integer_between(1, 4) integer_between(3, 5) when cost = 3 weight 2 {
  cost = -3
  kind = "binomial_tail"
  require $3.value < $2.value
  let faulty = $3.value / $2.value
  let sound = 1 - faulty
  text = "A machine produces a faulty part with probability [`" ++ number_latex(faulty)
         ++ "`], independently for each part. Among [`" ++ str($4.value)
         ++ "`] parts, what is the probability that at least two are faulty? Give your answer as a fraction."
  answer_value = 1 - sound ^ $4.value - $4.value * faulty * sound ^ ($4.value - 1)
}

prompt "{Q.text}"
answer Q.answer_value
