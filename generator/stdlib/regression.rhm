# ==========================================================================
#  Linear regression
#
#  The least-squares line of y on x: its slope and intercept from summary
#  numbers, a residual, and the line fitted to five data points, with a
#  prediction and the coefficient of determination. Every answer is an
#  exact fraction or a whole number.
#
#  The data are five points at x-values one apart, so the squared
#  deviations of x add up to 10 whatever the points are; the y-values are a
#  trend with a small whole disturbance on each. A residual is chosen first
#  and the point is put that far from the line.
#
#  Two mistakes are looked for: dividing by the spread of y where that of x
#  belongs, which gives the slope of x on y, and fitting a line through the
#  origin, the sum of x y over the sum of x^2. A question is asked only
#  where each of them gives another number, and the two give different
#  numbers, so a wrong answer says which mistake was made.
#
#  The coefficient of determination is asked only where its denominator, in
#  lowest terms, has at most two digits.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the slope from S_xx, S_yy and S_xy; the intercept from the slope
#       and the two means; a residual
#    2  the slope from five data points, and from the sums of x, y, x^2
#       and x y
#    3  a prediction from five data points; the coefficient of
#       determination r^2
# ==========================================================================

attribute cost = 2 split

mistake x_on_y "divides by the spread of y in place of that of x: S_xy / S_yy"
mistake through_origin "fits a line through the origin: the sum of x y over the sum of x squared"

synth kind on Q
synth text on Q
synth answer_value on Q

# Five points at the x-values x0, x0 + 1, ..., x0 + 4. `sxy` and `syy` are
# the sums of the products and of the squares of the deviations from the
# means; the deviations of x are -2, -1, 0, 1, 2 and their squares add up
# to 10.
synth sxy on D
synth syy on D
synth mean_x on D
synth mean_y on D
synth sum_x on D
synth sum_y on D
synth sum_xx on D
synth sum_xy on D
synth listing on D

start Q

D -> integer_between(0, 3) integer_between(1, 6) nonzero_integer_between(-2, 3) integer_between(-2, 2) integer_between(-2, 2) integer_between(-2, 2) integer_between(-2, 2) integer_between(-2, 2) {
  let x0 = $1.value
  let y1 = $2.value + $4.value
  let y2 = $2.value + $3.value + $5.value
  let y3 = $2.value + 2 * $3.value + $6.value
  let y4 = $2.value + 3 * $3.value + $7.value
  let y5 = $2.value + 4 * $3.value + $8.value
  let total = y1 + y2 + y3 + y4 + y5
  sxy = 2 * y5 + y4 - y2 - 2 * y1
  syy = y1 ^ 2 + y2 ^ 2 + y3 ^ 2 + y4 ^ 2 + y5 ^ 2 - total ^ 2 / 5
  mean_x = x0 + 2
  mean_y = total / 5
  sum_x = 5 * x0 + 10
  sum_y = total
  sum_xx = 5 * x0 ^ 2 + 20 * x0 + 30
  sum_xy = x0 * y1 + (x0 + 1) * y2 + (x0 + 2) * y3 + (x0 + 3) * y4 + (x0 + 4) * y5
  listing = "(" ++ str(x0) ++ ", " ++ str(y1) ++ "), (" ++ str(x0 + 1) ++ ", " ++ str(y2) ++ "), (" ++ str(x0 + 2) ++ ", " ++ str(y3)
            ++ "), (" ++ str(x0 + 3) ++ ", " ++ str(y4) ++ "), (" ++ str(x0 + 4) ++ ", " ++ str(y5) ++ ")"
}

# ---- Price 1 --------------------------------------------------------------

# S_yy is at least S_xy^2 / S_xx, as it is for any data: the whole part of
# that quotient and a little more.
Q -> "slope" integer_between(2, 20) nonzero_integer_between(-30, 30) integer_between(1, 10) when cost = 1 {
  cost = -1
  kind = "slope"
  let spread_y = ($3.value ^ 2 - $3.value ^ 2 % $2.value) / $2.value + $4.value
  require spread_y != $2.value
  text = "For a set of data pairs [`(x, y)`], [`S_{xx} = \sum (x - \bar{x})^{2} = " ++ str($2.value)
         ++ "`], [`S_{yy} = \sum (y - \bar{y})^{2} = " ++ str(spread_y)
         ++ "`] and [`S_{xy} = \sum (x - \bar{x})(y - \bar{y}) = " ++ str($3.value)
         ++ "`]. Find the slope of the least-squares regression line of [`y`] on [`x`]."
  answer_value = $3.value / $2.value
  mistake x_on_y answer_value = $3.value / spread_y
}

# The line passes through the point of the two means.
Q -> "intercept" nonzero_integer_between(-5, 5) integer_between(1, 3) integer_between(1, 9) integer_between(-10, 20) when cost = 1 {
  cost = -1
  kind = "intercept"
  require gcd(abs($2.value), $3.value) = 1
  text = "The least-squares regression line of [`y`] on [`x`] for a set of data has the slope [`"
         ++ number_latex($2.value / $3.value) ++ "`]. The mean of the [`x`]-values is [`" ++ str($4.value)
         ++ "`] and the mean of the [`y`]-values is [`" ++ str($5.value) ++ "`]. Find the intercept of the line, its value at [`x = 0`]."
  answer_value = $5.value - $2.value / $3.value * $4.value
}

# The children are the slope, the intercept, the x-value of the point and
# its residual.
Q -> "residual" nonzero_integer_between(-4, 4) integer_between(-5, 9) integer_between(1, 8) nonzero_integer_between(-4, 4) when cost = 1 {
  cost = -1
  kind = "residual"
  text = "The least-squares regression line for a set of data is [`\hat{y} = "
         ++ cond($2.value = 1, "", cond($2.value = 0 - 1, "-", str($2.value))) ++ "x"
         ++ cond($3.value = 0, "", cond($3.value > 0, " + ", " - ") ++ str(abs($3.value)))
         ++ "`]. One of the data points is [`(" ++ str($4.value)
         ++ ", " ++ str($2.value * $4.value + $3.value + $5.value)
         ++ ")`]. Find the residual of this point: the observed value of [`y`] minus the predicted one."
  answer_value = $5.value
}

# ---- Price 2 --------------------------------------------------------------

Q -> "slope_from_data" D when cost = 2 weight 2 {
  cost = -2
  kind = "slope_from_data"
  require $2.sxy != 0 and $2.syy != 10
  require $2.sum_xy / $2.sum_xx != $2.sxy / 10
  require $2.sum_xy / $2.sum_xx != $2.sxy / $2.syy
  text = "Find the slope of the least-squares regression line of [`y`] on [`x`] for the data [`" ++ $2.listing ++ "`]."
  answer_value = $2.sxy / 10
  mistake x_on_y answer_value = $2.sxy / $2.syy
  mistake through_origin answer_value = $2.sum_xy / $2.sum_xx
}

# (n sum xy - sum x sum y) / (n sum x^2 - (sum x)^2), with n = 5.
Q -> "slope_from_sums" D when cost = 2 weight 2 {
  cost = -2
  kind = "slope_from_sums"
  require $2.sxy != 0
  require $2.sum_xy / $2.sum_xx != $2.sxy / 10
  text = "Five data pairs [`(x, y)`] have [`\sum x = " ++ str($2.sum_x) ++ "`], [`\sum y = " ++ str($2.sum_y)
         ++ "`], [`\sum x^{2} = " ++ str($2.sum_xx) ++ "`] and [`\sum xy = " ++ str($2.sum_xy)
         ++ "`]. Find the slope of the least-squares regression line of [`y`] on [`x`]."
  answer_value = $2.sxy / 10
  mistake through_origin answer_value = $2.sum_xy / $2.sum_xx
}

# ---- Price 3 --------------------------------------------------------------

# The line is y = mean_y + slope (x - mean_x); it is asked beyond the data.
Q -> "predict" D integer_between(1, 3) when cost = 3 weight 2 {
  cost = -3
  kind = "predict"
  require $2.sxy != 0
  let ahead = $2.mean_x + 2 + $3.value
  text = "The least-squares regression line of [`y`] on [`x`] is fitted to the data [`" ++ $2.listing
         ++ "`]. Find the value of [`y`] it predicts at [`x = " ++ str(ahead) ++ "`]."
  answer_value = $2.mean_y + $2.sxy / 10 * (ahead - $2.mean_x)
}

# r^2 = S_xy^2 / (S_xx S_yy). Points that lie on one line, or show no trend
# at all, are not asked. 10 S_yy is a whole number, so the denominator of
# r^2 in lowest terms is 10 S_yy divided by what it shares with S_xy^2.
# About half of the data pass that, and the weight makes up for it.
Q -> "determination" D when cost = 3 weight 4 {
  cost = -3
  kind = "determination"
  require $2.sxy != 0 and $2.syy != 0
  require $2.sxy ^ 2 != 10 * $2.syy
  require 10 * $2.syy / gcd($2.sxy ^ 2, 10 * $2.syy) < 100
  text = "Find the coefficient of determination [`r^{2}`], the square of the correlation coefficient, for the data [`"
         ++ $2.listing ++ "`]. Give it as a fraction."
  answer_value = $2.sxy ^ 2 / (10 * $2.syy)
}

prompt "{Q.text}"
answer Q.answer_value
