# ==========================================================================
#  Inequalities
#
#  Linear, quadratic, absolute-value and rational inequalities in one
#  variable, answered in interval notation (Interval context). Each is
#  built from its solution: the roots are chosen first, and whether the
#  answer is the inside or the outside of them, and which ends are closed,
#  follows from the comparison and the sign of the leading coefficient.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  a x + b < c (any of <, <=, >, >=)
#    2  k (x - r1)(x - r2) < 0 written out, |x - a| < b
#    3  |p x - q| < b, (x - r1) / (x - r2) < 0
# ==========================================================================

context "Interval"
attribute cost = 2 split

synth kind on Q
synth text on Q
synth answer_value on Q

# A comparison drawn as 1 to 4: <, <=, >, >=.
synth latex on O
synth less on O
synth closed on O

start Q

O -> integer_between(1, 4) {
  latex = cond($1.value = 1, "<", cond($1.value = 2, "\le", cond($1.value = 3, ">", "\ge")))
  less = $1.value <= 2
  closed = $1.value = 2 or $1.value = 4
}

# ---- Price 1 --------------------------------------------------------------

# a x + b OP a r + b: x OP r, the direction flipped when a < 0.
Q -> "linear" nonzero_integer_between(-9, 9) integer_between(-9, 9) integer_between(-9, 9) O when cost = 1 {
  cost = -1
  kind = "linear"
  require $2.value != 1
  text = "Solve [`" ++ polynomial_latex(polynomial_linear($2.value, $3.value, "x")) ++ " " ++ $5.latex ++ " "
         ++ str($2.value * $4.value + $3.value) ++ "`]. Give the solution set in interval notation."
  answer_value = cond($5.less != ($2.value < 0), set_below($4.value, $5.closed), set_above($4.value, $5.closed))
}

# ---- Price 2 --------------------------------------------------------------

# k (x - r1)(x - r2) OP 0 with r1 < r2: the inside of the roots when the
# comparison and the sign of k disagree about being negative, else outside.
Q -> "quadratic" integer_between(-8, 6) integer_between(1, 6) nonzero_integer_between(-3, 3) O when cost = 2 weight 2 {
  cost = -2
  kind = "quadratic"
  text = "Solve [`" ++ polynomial_latex(polynomial_multiply(polynomial_linear($4.value, 0 - $4.value * $2.value, "x"),
                                                         polynomial_linear(1, 0 - ($2.value + $3.value), "x")))
         ++ " " ++ $5.latex ++ " 0`]. Give the solution set in interval notation."
  answer_value = cond($5.less = ($4.value > 0),
                      set_interval($2.value, $2.value + $3.value, $5.closed, $5.closed),
                      set_union(set_below($2.value, $5.closed), set_above($2.value + $3.value, $5.closed)))
}

Q -> "absolute" integer_between(-9, 9) integer_between(1, 9) O when cost = 2 weight 2 {
  cost = -2
  kind = "absolute"
  require $2.value != 0
  text = "Solve [`\left|" ++ polynomial_latex(polynomial_linear(1, 0 - $2.value, "x")) ++ "\right| " ++ $4.latex ++ " "
         ++ str($3.value) ++ "`]. Give the solution set in interval notation."
  answer_value = cond($4.less,
                      set_interval($2.value - $3.value, $2.value + $3.value, $4.closed, $4.closed),
                      set_union(set_below($2.value - $3.value, $4.closed), set_above($2.value + $3.value, $4.closed)))
}

# ---- Price 3 --------------------------------------------------------------

# |p x - q| OP b: the ends are (q - b)/p and (q + b)/p, fractions in general.
Q -> "absolute_linear" integer_between(2, 5) integer_between(-9, 9) integer_between(1, 9) O when cost = 3 weight 2 {
  cost = -3
  kind = "absolute_linear"
  require $3.value % $2.value != 0 or $4.value % $2.value != 0
  text = "Solve [`\left|" ++ polynomial_latex(polynomial_linear($2.value, 0 - $3.value, "x")) ++ "\right| " ++ $5.latex ++ " "
         ++ str($4.value) ++ "`]. Give the solution set in interval notation."
  answer_value = cond($5.less,
                      set_interval(($3.value - $4.value) / $2.value, ($3.value + $4.value) / $2.value, $5.closed, $5.closed),
                      set_union(set_below(($3.value - $4.value) / $2.value, $5.closed),
                                set_above(($3.value + $4.value) / $2.value, $5.closed)))
}

# (x - r1)/(x - r2) OP 0: positive outside the two points, negative between;
# r1 is a zero (closed under <= and >=), r2 is never in the domain.
Q -> "rational" integer_between(-9, 9) integer_between(-9, 9) O when cost = 3 weight 2 {
  cost = -3
  kind = "rational"
  require $2.value != $3.value
  text = "Solve [`\dfrac{" ++ polynomial_latex(polynomial_linear(1, 0 - $2.value, "x")) ++ "}{"
         ++ polynomial_latex(polynomial_linear(1, 0 - $3.value, "x")) ++ "} " ++ $4.latex
         ++ " 0`]. Give the solution set in interval notation."
  answer_value = cond($4.less,
                      set_interval(min($2.value, $3.value), max($2.value, $3.value),
                                   $4.closed and $2.value < $3.value, $4.closed and $2.value > $3.value),
                      set_union(set_below(min($2.value, $3.value), $4.closed and $2.value < $3.value),
                                set_above(max($2.value, $3.value), $4.closed and $2.value > $3.value)))
}

prompt "{Q.text}"
answer Q.answer_value
