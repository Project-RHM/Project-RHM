# ==========================================================================
#  Recurrence relations
#
#  Linear recurrences of the first and second order with constant
#  coefficients: terms found by going through the recurrence, and solutions
#  in closed form. A closed form is built from its answer: the roots of the
#  characteristic equation and the constants are chosen first, and the
#  coefficients of the recurrence and its first terms are read off them.
#
#  The forms have one to four blanks (a term; the constants A and B; the
#  roots r and s and the constants). Each places its own blanks in its text
#  with blank(...), so the file has no `answer` line. The roots of a
#  characteristic equation asked on their own are a set, graded in the
#  Interval context so that their order does not matter.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  a term of a_n = r a_(n-1) + d, a term of a_n = s a_(n-1) + t a_(n-2)
#    2  A and B in the solution A r^n + B of a first-order recurrence, the
#       roots of the characteristic equation of a second-order one
#    3  r, s, A and B in the solution A r^n + B s^n; r, A and B in the
#       solution (A + B n) r^n when the root is repeated
# ==========================================================================

attribute cost = 2 split

synth kind on Q
synth text on Q
synth pg_context on Q

# A ratio that is not 1, 0 or -1, and how it is written under a power.
synth value on R
synth base on R

# A second-order recurrence a_n = s a_(n-1) + t a_(n-2) with characteristic
# roots first < second, neither zero and not opposite (so s is not zero).
synth first on W
synth second on W
synth latex on W

start Q

R -> nonzero_integer_between(-2, 3) {
  require abs($1.value) != 1
  value = $1.value
  base = cond($1.value < 0, "\left(" ++ str($1.value) ++ "\right)", str($1.value))
}

W -> nonzero_integer_between(-3, 3) integer_between(1, 4) {
  let upper = $1.value + $2.value
  let sum = $1.value + upper
  let product = $1.value * upper
  require upper != 0 and sum != 0
  first = $1.value
  second = upper
  latex = "a_n = " ++ cond(sum = 1, "", cond(sum = 0 - 1, "-", str(sum))) ++ "a_{n-1}"
          ++ cond(product < 0, " + ", " - ") ++ cond(abs(product) = 1, "", str(abs(product))) ++ "a_{n-2}"
}

# ---- Price 1 --------------------------------------------------------------

# a_1 = c and a_n = r a_(n-1) + d: a_k = r^(k-1) c + d (r^(k-1) - 1)/(r - 1).
Q -> "iterate_first" R nonzero_integer_between(-5, 5) integer_between(-4, 4) integer_between(4, 5) when cost = 1 {
  cost = -1
  kind = "iterate_first"
  pg_context = "Numeric"
  let power = $2.value ^ ($5.value - 1)
  text = "A sequence has [`a_1 = " ++ str($4.value) ++ "`] and [`a_n = " ++ str($2.value) ++ "a_{n-1}"
         ++ cond($3.value > 0, " + ", " - ") ++ str(abs($3.value)) ++ "`] for [`n \ge 2`]. Find [`a_{" ++ str($5.value)
         ++ "}`]. " ++ blank(power * $4.value + $3.value * (power - 1) / ($2.value - 1))
}

# a_1, a_2 given and a_n = s a_(n-1) + t a_(n-2): five steps written out.
Q -> "iterate_second" integer_between(1, 2) nonzero_integer_between(-1, 2) integer_between(-3, 3) integer_between(-3, 3) integer_between(5, 6) when cost = 1 {
  cost = -1
  kind = "iterate_second"
  pg_context = "Numeric"
  require $4.value != 0 or $5.value != 0
  let a3 = $2.value * $5.value + $3.value * $4.value
  let a4 = $2.value * a3 + $3.value * $5.value
  let a5 = $2.value * a4 + $3.value * a3
  let a6 = $2.value * a5 + $3.value * a4
  text = "A sequence has [`a_1 = " ++ str($4.value) ++ "`], [`a_2 = " ++ str($5.value) ++ "`] and [`a_n = "
         ++ cond($2.value = 1, "", str($2.value)) ++ "a_{n-1}" ++ cond($3.value > 0, " + ", " - ")
         ++ cond(abs($3.value) = 1, "", str(abs($3.value))) ++ "a_{n-2}`] for [`n \ge 3`]. Find [`a_{" ++ str($6.value)
         ++ "}`]. " ++ blank(cond($6.value = 5, a5, a6))
}

# ---- Price 2 --------------------------------------------------------------

# a_n = A r^n + B satisfies a_n = r a_(n-1) + B (1 - r) and a_0 = A + B.
Q -> "closed_first" R nonzero_integer_between(-4, 4) nonzero_integer_between(-4, 4) when cost = 2 weight 2 {
  cost = -2
  kind = "closed_first"
  pg_context = "Numeric"
  let shift = $4.value * (1 - $2.value)
  text = "A sequence has [`a_0 = " ++ str($3.value + $4.value) ++ "`] and [`a_n = " ++ str($2.value) ++ "a_{n-1}"
         ++ cond(shift > 0, " + ", " - ") ++ str(abs(shift)) ++ "`] for [`n \ge 1`]. Its solution is [`a_n = A \cdot "
         ++ $2.base ++ "^{n} + B`]. [`A = `] " ++ blank($3.value) ++ " [`B = `] " ++ blank($4.value)
}

Q -> "characteristic" W when cost = 2 weight 2 {
  cost = -2
  kind = "characteristic"
  pg_context = "Interval"
  text = "Find the roots of the characteristic equation of the recurrence [`" ++ $2.latex
         ++ "`]. Enter them as a set, such as [`\{-1, 4\}`]. "
         ++ blank(set_insert(set_insert(set_empty(), $2.first), $2.second))
}

# ---- Price 3 --------------------------------------------------------------

# a_n = A r^n + B s^n: a_0 = A + B and a_1 = A r + B s.
Q -> "closed_second" W nonzero_integer_between(-4, 4) nonzero_integer_between(-4, 4) when cost = 3 weight 2 {
  cost = -3
  kind = "closed_second"
  pg_context = "Numeric"
  text = "A sequence has [`a_0 = " ++ str($3.value + $4.value) ++ "`], [`a_1 = "
         ++ str($3.value * $2.first + $4.value * $2.second) ++ "`] and [`" ++ $2.latex
         ++ "`] for [`n \ge 2`]. Its solution is [`a_n = A \cdot r^{n} + B \cdot s^{n}`] with [`r < s`]. [`r = `] "
         ++ blank($2.first) ++ " [`s = `] " ++ blank($2.second) ++ " [`A = `] " ++ blank($3.value) ++ " [`B = `] "
         ++ blank($4.value)
}

# A repeated root r: a_n = 2r a_(n-1) - r^2 a_(n-2), with the solution
# (A + B n) r^n, a_0 = A and a_1 = (A + B) r.
Q -> "repeated" nonzero_integer_between(-3, 3) integer_between(-4, 4) nonzero_integer_between(-4, 4) when cost = 3 {
  cost = -3
  kind = "repeated"
  pg_context = "Numeric"
  require abs($2.value) != 1
  text = "A sequence has [`a_0 = " ++ str($3.value) ++ "`], [`a_1 = " ++ str(($3.value + $4.value) * $2.value)
         ++ "`] and [`a_n = " ++ str(2 * $2.value) ++ "a_{n-1} - " ++ cond($2.value ^ 2 = 1, "", str($2.value ^ 2))
         ++ "a_{n-2}`] for [`n \ge 2`]. Its solution is [`a_n = (A + Bn) \cdot r^{n}`]. [`r = `] " ++ blank($2.value)
         ++ " [`A = `] " ++ blank($3.value) ++ " [`B = `] " ++ blank($4.value)
}

prompt "{Q.text}"
