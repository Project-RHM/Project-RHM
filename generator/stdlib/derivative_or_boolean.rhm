# ==========================================================================
#  Two grammars in one question: a derivative or a Boolean evaluation
#
#  This file imports calculus.rhm and boolean.rhm as modules and asks one
#  question of either: it is how a user puts the question types of two
#  libraries into one grammar. Each module keeps its own nonterminals,
#  prices, precedences and randoms behind its alias (calc.F, bool.E,
#  bool.given), so nothing in the two files has to be renamed to sit
#  together, and this file adds only the start symbol that chooses between
#  them and the budget it hands over.
#
#  Difficulty is the budget `cost`, handed to the module chosen. The two
#  grammars price on their own scales -- a derivative of 8 is harder than a
#  proposition of 8 -- so the exchange rate is written here, at the
#  boundary: the derivative gets the budget as it is, the proposition gets
#  two more. Each module then spends exactly what it was given.
#
#    rhema run derivative_or_boolean.rhm --set cost=8
# ==========================================================================

import "calculus.rhm" as calc
import "boolean.rhm" as bool

attribute cost = 8 copy        # what this file hands to the module it picks

synth kind on M
synth text on M
synth answer_value on M

start M

M -> calc.F(cost = cost) "derivative" weight 1 {
  kind = "derivative"
  text = "Differentiate the function with respect to x:
[`f(x) = " ++ $1.latex ++ "`]."
  answer_value = differentiate($1.formula, "x")
  require not formula_is_zero(answer_value)
}

M -> bool.E(cost = cost + 2) "boolean" weight 1 {
  kind = "boolean"
  require bool_top($1.f) != "not"
  text = "Evaluate [`" ++ bool_latex($1.f) ++ "`] when " ++ bool.given ++ ".
Enter 1 for true and 0 for false."
  answer_value = bool_evaluate($1.f, bool.names, bool.mask)
}

prompt "{M.text}"
answer M.answer_value
