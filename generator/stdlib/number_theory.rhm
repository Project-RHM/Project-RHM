# ==========================================================================
#  Number theory
#
#  Greatest common divisors and least common multiples, remainders of large
#  powers, inverses modulo n, and linear congruences. Answers are computed
#  with gcd, lcm, pow_mod and mod_inverse; a congruence is built from its
#  solution, so it always has exactly one in the range asked for.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  gcd, lcm
#    2  the remainder of a^k on division by n, an inverse modulo n
#    3  a linear congruence a x = b (mod n)
# ==========================================================================

attribute cost = 2 split

synth kind on Q
synth text on Q
synth answer_value on Q

start Q

# The two numbers share a factor g and are otherwise coprime, so the gcd is
# g, never 1 or one of the numbers themselves.
Q -> "gcd" integer_between(3, 15) integer_between(2, 12) integer_between(2, 12) when cost = 1 {
  cost = -1
  kind = "gcd"
  require $3.value != $4.value
  require gcd($3.value, $4.value) = 1
  text = "Find [`\gcd(" ++ str($2.value * $3.value) ++ ", " ++ str($2.value * $4.value) ++ ")`]."
  answer_value = gcd($2.value * $3.value, $2.value * $4.value)
}

Q -> "lcm" integer_between(2, 12) integer_between(2, 9) integer_between(2, 9) when cost = 1 {
  cost = -1
  kind = "lcm"
  require $3.value != $4.value
  require gcd($3.value, $4.value) = 1
  text = "Find [`\operatorname{lcm}(" ++ str($2.value * $3.value) ++ ", " ++ str($2.value * $4.value) ++ ")`]."
  answer_value = lcm($2.value * $3.value, $2.value * $4.value)
}

Q -> "power" integer_between(2, 13) integer_between(20, 200) integer_between(3, 13) when cost = 2 weight 2 {
  cost = -2
  kind = "power"
  require $2.value % $4.value != 0
  text = "Find the remainder when [`" ++ str($2.value) ++ "^{" ++ str($3.value)
         ++ "}`] is divided by [`" ++ str($4.value) ++ "`]."
  answer_value = pow_mod($2.value, $3.value, $4.value)
}

Q -> "inverse" integer_between(2, 30) integer_between(7, 41) when cost = 2 weight 2 {
  cost = -2
  kind = "inverse"
  require $2.value < $3.value
  require gcd($2.value, $3.value) = 1
  text = "Find the inverse of [`" ++ str($2.value) ++ "`] modulo [`" ++ str($3.value)
         ++ "`]: the integer [`x`] with [`0 \le x < " ++ str($3.value) ++ "`] and [`"
         ++ str($2.value) ++ "x \equiv 1 \pmod{" ++ str($3.value) ++ "}`]."
  answer_value = mod_inverse($2.value, $3.value)
}

# Chosen solution first: x0 in [0, n), a coprime to n, b = a x0 mod n.
Q -> "congruence" integer_between(2, 40) integer_between(7, 50) integer_between(0, 49) when cost = 3 {
  cost = -3
  kind = "congruence"
  require $2.value < $3.value
  require $4.value < $3.value
  require $4.value >= 2                     # x = 0 or 1 reads straight off the congruence
  require gcd($2.value, $3.value) = 1
  text = "Solve [`" ++ str($2.value) ++ "x \equiv " ++ str(($2.value * $4.value) % $3.value)
         ++ " \pmod{" ++ str($3.value) ++ "}`]. Give the solution [`x`] with [`0 \le x < "
         ++ str($3.value) ++ "`]."
  answer_value = $4.value
}

prompt "{Q.text}"
answer Q.answer_value
