# ==========================================================================
#  Lines and circles in the plane
#
#  Distance, midpoint and slope; the line through two points and the
#  perpendicular through a point; the centre and radius of a circle given
#  expanded; the point where two lines meet. Each is built from its answer
#  where there is something to find: a distance is a multiple of a
#  Pythagorean triple, a circle is expanded from its centre and radius, and
#  two lines are drawn through a chosen point.
#
#  Answers: a number, the right-hand side of a line as a formula in x, or a
#  point such as (3, -2). A point is a value of its own (point2), which
#  WeBWorK grades as a point whatever context the question is in. Each form
#  places its own blanks in its text with blank(...): most have one, the
#  circle has two, so the file has no `answer` line.
#
#  Difficulty is the budget `cost`. Every form is fixed, so each is offered
#  at its price alone:
#
#    1  the distance between two points, their midpoint, the slope of the
#       line through them
#    2  the line through two points, the line through a point perpendicular
#       to a given line
#    3  the centre and the radius of x^2 + y^2 + D x + E y + F = 0 (two
#       blanks), the intersection of two lines
# ==========================================================================

attribute cost = 2 split

synth kind on Q
synth text on Q

# A point with whole coordinates.
synth x on P
synth y on P
synth latex on P

# The left side a x + b y of a line in general form, a and b not zero.
synth a on L
synth b on L
synth latex on L

# A Pythagorean triple, perhaps doubled: legs and hypotenuse.
synth leg1 on T
synth leg2 on T
synth hypotenuse on T

start Q

P -> integer_between(-9, 9) integer_between(-9, 9) {
  x = $1.value
  y = $2.value
  latex = "\left(" ++ str($1.value) ++ ", " ++ str($2.value) ++ "\right)"
}

L -> nonzero_integer_between(-5, 5) nonzero_integer_between(-5, 5) {
  a = $1.value
  b = $2.value
  latex = polynomial_latex(polynomial_linear($1.value, 0, "x")) ++ cond($2.value > 0, " + ", " - ")
          ++ polynomial_latex(polynomial_linear(abs($2.value), 0, "y"))
}

T -> integer_between(1, 3) integer_between(1, 2) {
  leg1 = $2.value * cond($1.value = 1, 3, cond($1.value = 2, 5, 8))
  leg2 = $2.value * cond($1.value = 1, 4, cond($1.value = 2, 12, 15))
  hypotenuse = $2.value * cond($1.value = 1, 5, cond($1.value = 2, 13, 17))
}

# ---- Price 1 --------------------------------------------------------------

# From P, one leg across and the other up (or back, or down).
Q -> "distance" P T nonzero_integer_between(-1, 1) nonzero_integer_between(-1, 1) when cost = 1 {
  cost = -1
  kind = "distance"
  let ask = "Find the distance between the points [`" ++ $2.latex ++ "`] and [`\left("
           ++ str($2.x + $4.value * $3.leg1) ++ ", " ++ str($2.y + $5.value * $3.leg2) ++ "\right)`]."
  text = ask ++ " " ++ blank($3.hypotenuse)
}

Q -> "midpoint" P P when cost = 1 {
  cost = -1
  kind = "midpoint"
  require $2.x != $3.x or $2.y != $3.y
  let ask = "Find the midpoint of the segment joining [`" ++ $2.latex ++ "`] and [`" ++ $3.latex
           ++ "`]. Enter it as a point, such as [`(3, -2)`]."
  text = ask ++ " " ++ blank(point2(($2.x + $3.x) / 2, ($2.y + $3.y) / 2))
}

Q -> "slope" P P when cost = 1 {
  cost = -1
  kind = "slope"
  require $2.x != $3.x
  let ask = "Find the slope of the line through [`" ++ $2.latex ++ "`] and [`" ++ $3.latex ++ "`]."
  text = ask ++ " " ++ blank(($3.y - $2.y) / ($3.x - $2.x))
}

# ---- Price 2 --------------------------------------------------------------

Q -> "line_two_points" P P when cost = 2 weight 2 {
  cost = -2
  kind = "line_two_points"
  require $2.x != $3.x and $2.y != $3.y
  let ask = "Find the equation of the line through [`" ++ $2.latex ++ "`] and [`" ++ $3.latex
           ++ "`]. Write it as [`y = mx + b`] and enter the right-hand side."
  let slope = ($3.y - $2.y) / ($3.x - $2.x)
  text = ask ++ " " ++ blank(polynomial_linear(slope, $2.y - $2.x * slope, "x"))
}

# a x + b y = c has slope -a/b, so the perpendicular has slope b/a.
Q -> "perpendicular" P L integer_between(-9, 9) when cost = 2 weight 2 {
  cost = -2
  kind = "perpendicular"
  let ask = "Find the equation of the line through [`" ++ $2.latex ++ "`] that is perpendicular to the line [`"
           ++ $3.latex ++ " = " ++ str($4.value) ++ "`]. Write it as [`y = mx + b`] and enter the right-hand side."
  let slope = $3.b / $3.a
  text = ask ++ " " ++ blank(polynomial_linear(slope, $2.y - $2.x * slope, "x"))
}

# ---- Price 3 --------------------------------------------------------------

# (x - h)^2 + (y - k)^2 = r^2 expanded: D = -2h, E = -2k, F = h^2 + k^2 - r^2.
# Two blanks: this form says where they are, which the others could not.
Q -> "circle" nonzero_integer_between(-9, 9) nonzero_integer_between(-9, 9) integer_between(1, 9) when cost = 3 weight 2 {
  cost = -3
  let constant = $2.value ^ 2 + $3.value ^ 2 - $4.value ^ 2
  kind = "circle"
  text = "Find the centre and the radius of the circle [`x^{2} + y^{2}"
         ++ cond($2.value < 0, " + ", " - ") ++ str(2 * abs($2.value)) ++ " \cdot x"
         ++ cond($3.value < 0, " + ", " - ") ++ str(2 * abs($3.value)) ++ " \cdot y"
         ++ cond(constant = 0, "", cond(constant > 0, " + ", " - ") ++ str(abs(constant)))
         ++ " = 0`]. Centre, as a point such as [`(3, -2)`]: " ++ blank(point2($2.value, $3.value))
         ++ " Radius: " ++ blank($4.value)
}

# Two lines through P that are not parallel meet only there.
Q -> "intersection" P L L when cost = 3 weight 2 {
  cost = -3
  kind = "intersection"
  require $3.a * $4.b != $4.a * $3.b
  let ask = "Find the point where the lines [`" ++ $3.latex ++ " = " ++ str($3.a * $2.x + $3.b * $2.y) ++ "`] and [`"
           ++ $4.latex ++ " = " ++ str($4.a * $2.x + $4.b * $2.y) ++ "`] meet. Enter it as a point, such as [`(3, -2)`]."
  text = ask ++ " " ++ blank(point2($2.x, $2.y))
}

prompt "{Q.text}"
