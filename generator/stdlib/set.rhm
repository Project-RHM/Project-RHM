# ==========================================================================
# Set expressions over three question-level definitions.
#
# set_mode = 0  mixed union/intersection/difference
#            1  union only
#            2  intersection only
#            3  difference only
#
# Each A/B/C definition is fixed before the expression tree is generated, so
# every repeated occurrence denotes exactly the same set.
#
# Difficulty is the budget `cost`, spent exactly. A union costs 1, an
# intersection or a difference 2, and a leaf costs 1 when its set is an
# interval and nothing when it is finite: mixing intervals with finite sets
# is where the work is. The caller chooses the difficulty:
#
#   rhema run set.rhm --set cost=3    easy
#   rhema run set.rhm --set cost=7    medium (the default)
#   rhema run set.rhm --set cost=11    hard
#
# Every whole number from 0 upwards can be spent in every set_mode. The
# difference is priced at 2 rather than 3 for that reason: in the
# difference-only mode a node left with 2 would have no rule to take it,
# which the engine treats as an error rather than a retry.
# ==========================================================================

context "Interval"

attribute cost = 7 split
attribute set_mode = 0 copy

# Finite candidates. set_insert canonicalizes order and removes duplicates.
random a1 = integer_between(-9, 12)
random a2 = integer_between(-9, 12)
random a3 = integer_between(-9, 12)
random a4 = integer_between(-9, 12)
random b1 = integer_between(-9, 12)
random b2 = integer_between(-9, 12)
random b3 = integer_between(-9, 12)
random b4 = integer_between(-9, 12)
random c1 = integer_between(-9, 12)
random c2 = integer_between(-9, 12)
random c3 = integer_between(-9, 12)
random c4 = integer_between(-9, 12)

let a_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), a1), a2), a3), a4)
let b_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), b1), b2), b3), b4)
let c_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), c1), c2), c3), c4)

# Interval candidates. Independent endpoint flags cover (), [), (], and [].
random a_lower = integer_between(-9, 3)
random a_width = integer_between(2, 9)
random a_left_closed = boolean
random a_right_closed = boolean
random b_lower = integer_between(-9, 3)
random b_width = integer_between(2, 9)
random b_left_closed = boolean
random b_right_closed = boolean
random c_lower = integer_between(-9, 3)
random c_width = integer_between(2, 9)
random c_left_closed = boolean
random c_right_closed = boolean

let a_interval = set_interval(a_lower, a_lower + a_width, a_left_closed, a_right_closed)
let b_interval = set_interval(b_lower, b_lower + b_width, b_left_closed, b_right_closed)
let c_interval = set_interval(c_lower, c_lower + c_width, c_left_closed, c_right_closed)

random a_uses_interval = boolean
random b_uses_interval = boolean
random c_draw_interval = boolean
# At least one set is finite and at least one is an interval, so a leaf of
# either price always exists and no budget is ever left without a rule.
let c_uses_interval = cond(a_uses_interval and b_uses_interval, 1 = 0,
                      cond(a_uses_interval or b_uses_interval, c_draw_interval, 1 = 1))

let set_a = cond(a_uses_interval, a_interval, a_finite)
let set_b = cond(b_uses_interval, b_interval, b_finite)
let set_c = cond(c_uses_interval, c_interval, c_finite)

let definitions = "Given the sets:
- [`A = " ++ set_latex(set_a) ++ "`]
- [`B = " ++ set_latex(set_b) ++ "`]
- [`C = " ++ set_latex(set_c) ++ "`]"

synth text on Q
synth answer_value on Q

synth value on E
synth latex on E

synth value on S
synth latex on S

start Q

precedence 1 left "\cup"
precedence 2 left "\cap" "\setminus"

Q -> E {
  require set_a != set_b
  require set_a != set_c
  require set_b != set_c
  text = definitions ++ "
Compute the set expression:
[`" ++ $1.latex ++ "`]."
  answer_value = $1.value
}

# Each rule's guard is the least it can spend: its own price.

E -> E "\cup" E when cost >= 1 and (set_mode = 0 or set_mode = 1) weight 3 {
  cost = -1
  require $1.latex != $3.latex
  value = set_union($1.value, $3.value)
  latex = infix($1, "\cup", $3)
}

E -> E "\cap" E when cost >= 2 and (set_mode = 0 or set_mode = 2) weight 3 {
  cost = -2
  require $1.latex != $3.latex
  value = set_intersection($1.value, $3.value)
  latex = infix($1, "\cap", $3)
}

E -> E "\setminus" E when cost >= 2 and (set_mode = 0 or set_mode = 3) weight 2 {
  cost = -2
  require $1.latex != $3.latex
  value = set_difference($1.value, $3.value)
  latex = infix($1, "\setminus", $3)
}

# A leaf stands wherever the rest of the budget buys its kind.
E -> S when cost <= 1 {
  value = $1.value
  latex = $1.latex
}

# A finite set costs nothing; an interval spends the 1 that reached it.

S -> "A" when cost = 0 and not a_uses_interval weight 1 { value = set_a  latex = "A" }
S -> "A" when cost = 1 and a_uses_interval     weight 1 { cost = -1  value = set_a  latex = "A" }

S -> "B" when cost = 0 and not b_uses_interval weight 1 { value = set_b  latex = "B" }
S -> "B" when cost = 1 and b_uses_interval     weight 1 { cost = -1  value = set_b  latex = "B" }

S -> "C" when cost = 0 and not c_uses_interval weight 1 { value = set_c  latex = "C" }
S -> "C" when cost = 1 and c_uses_interval     weight 1 { cost = -1  value = set_c  latex = "C" }

prompt "{Q.text}"
answer Q.answer_value
width 24
