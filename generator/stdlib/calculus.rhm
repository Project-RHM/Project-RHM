# ==========================================================================
#  Calculus: derivatives and reverse-generated indefinite integrals
#
#  calculus_mode = 0  mixed
#                  1  derivative only
#                  2  integral only
#
#  For an integral question the grammar first generates an antiderivative
#  F(x), differentiates it symbolically to obtain f(x), and asks for the
#  integral of f(x). This construction guarantees that F(x) is correct.
#
#  Difficulty is the budget `cost`, spent exactly, and priced by the
#  differentiation rule each construct asks of the student:
#
#    sum or difference        1        product                 3
#    quotient                 4
#    power of a leaf          1        power of a compound     3 + the compound
#    function of a leaf       1        function of a compound  3 + the compound
#    leaf x or a constant     0        leaf c*x                1
#
#  where a function is sin, cos, exp, ln, sqrt or tan. A compound under a
#  power or a function means the chain rule, which is why it costs 3 on top
#  of what is inside. An integral question pays 2 before F is built: the
#  same F makes a harder integral than derivative (a chain becomes a
#  substitution, a product an integration by parts); it is also built from
#  sums, products, powers, sin, cos and exp only, since ln, sqrt, tan and
#  quotients give integrands this grammar cannot promise are integrable by
#  the course's methods. The caller chooses the difficulty:
#
#    rhema run calculus.rhm --set cost=4     easy
#    rhema run calculus.rhm --set cost=7     medium (the default)
#    rhema run calculus.rhm --set cost=10    hard
#
#  Every whole number from 0 upwards can be spent, so no node is ever left
#  with a budget no rule can take; below 3 only derivative questions fit.
# ==========================================================================

context "Numeric"

attribute cost = 7 split
attribute calculus_mode = 0 copy
# Integral questions consume this budget before generating F, preventing an
# unrelated additive constant from being mistaken for the requested C = 0.
attribute constants = 1 copy
# Integral questions consume this one too: it admits ln, sqrt, tan and
# quotients, which only a derivative question may use.
attribute advanced = 1 copy

synth kind on Q                # the question forms D and I carry the same four
synth text on Q
synth derivative on Q
synth answer_value on Q
synth kind on D
synth text on D
synth derivative on D
synth answer_value on D
synth kind on I
synth text on I
synth derivative on I
synth answer_value on I

synth formula on F
synth latex on F
synth constant on F            # 1 when the subtree is a bare constant, else 0
synth monomial on F            # 1 when the subtree is x, c*x or a power of one
synth constants_used on F      # how many constant leaves the subtree holds
synth linear_terms on F        # x or c*x terms added directly in this subtree
synth formula on T
synth latex on T
synth value on T
synth constant on T
synth monomial on T
synth constants_used on T
synth linear on T              # 1 for x and c*x, 0 for a constant
synth coefficient on T         # the number in front of x, or the constant
synth power on F               # 1 when the subtree is a power, so powers do not nest

start Q

# ---- Question forms ------------------------------------------------------
#
# The file asks three questions. `main` (start Q) draws a derivative or an
# integral, as `calculus_mode` allows; the named questions `derivative`
# (start D) and `integral` (start I) ask one form only, so that a user who
# wants "an integral" can say so:
#
#    rhema run calculus.rhm                              either form
#    rhema run calculus.rhm --question integral --set cost=5
#
# Q only chooses; the forms themselves are D and I, shared by all three.

Q -> D when calculus_mode != 2 weight 1 {
  kind = $1.kind
  derivative = $1.derivative
  text = $1.text
  answer_value = $1.answer_value
}

Q -> I when calculus_mode != 1 and cost >= 3 weight 1 {
  kind = $1.kind
  derivative = $1.derivative
  text = $1.text
  answer_value = $1.answer_value
}

# One additive constant is enough to show that it differentiates away; two
# would read as an unsimplified sum.
D -> F "derivative" {
  kind = "derivative"
  require $1.constants_used <= 1
  derivative = differentiate($1.formula, "x")
  require not formula_is_zero(derivative)
  text = "Differentiate the function with respect to x:
[`f(x) = " ++ $1.latex ++ "`]."
  answer_value = derivative
}

# The integral premium: 2 for the question form, and at least 1 left for F
# so that the integrand is never the derivative of a bare x.
I -> F "integral" when cost >= 3 {
  cost = -2
  constants = -1
  advanced = -1
  kind = "integral"
  derivative = differentiate($1.formula, "x")
  require not formula_is_zero(derivative)
  text = "Find an antiderivative with the constant of integration C = 0:
[`\\int \\left(" ++ formula_latex(derivative) ++ "\\right)\\,dx`]."
  answer_value = $1.formula
}

question derivative {
  start D
  prompt "{D.text}"
  answer D.answer_value
}

# An integral needs a budget of at least 3: 2 for the form and 1 inside.
question integral {
  start I
  prompt "{I.text}"
  answer I.answer_value
  cost = 7
}

# ---- Recursive symbolic function ---------------------------------------
#
# The guard of each rule is the least it can spend. A rule that applies to a
# leaf (T) is allowed only while the budget buys a leaf, 1 or 2; the same
# rule on a compound needs 3 for itself and at least 2 inside, which no leaf
# can spend, so the two never build the same expression and every printed
# expression has one price.
#
# The `constant` flag keeps the pricing honest: a constant times x would
# print exactly like the leaf c*x, and a sum, power or function of constants
# would fold into a constant. Such operands are refused. A sum or difference
# whose derivative is zero, such as x - (7 + x), is refused too: it would
# differentiate away and leave a question cheaper than its price. A product
# of two monomials, such as x^5 * x, is refused because it collects into one,
# and so is a sum with two linear terms, such as x^4 - x + x or 3x + x.

F -> F "+" F when cost >= 1 weight 3 {
  cost = -1
  require $1.latex != $3.latex
  require $1.constant + $3.constant < 2
  constant = 0
  monomial = 0
  constants_used = $1.constants_used + $3.constants_used
  linear_terms = $1.linear_terms + $3.linear_terms
  power = 0
  require linear_terms <= 1
  formula = formula_add($1.formula, $3.formula)
  require not formula_is_zero(differentiate(formula, "x"))
  latex = formula_latex(formula)
}

F -> F "-" F when cost >= 1 weight 3 {
  cost = -1
  require $1.latex != $3.latex
  require $1.constant + $3.constant < 2
  constant = 0
  monomial = 0
  constants_used = $1.constants_used + $3.constants_used
  linear_terms = $1.linear_terms + $3.linear_terms
  power = 0
  require linear_terms <= 1
  formula = formula_subtract($1.formula, $3.formula)
  require not formula_is_zero(differentiate(formula, "x"))
  latex = formula_latex(formula)
}

F -> F "\\cdot" F when cost >= 4 weight 2 {
  cost = -3
  require $1.latex != $3.latex
  require $1.constant = 0
  require $3.constant = 0
  require $1.monomial + $3.monomial < 2
  constant = 0
  monomial = 0
  constants_used = $1.constants_used + $3.constants_used
  linear_terms = 0
  power = 0
  formula = formula_multiply($1.formula, $3.formula)
  latex = formula_latex(formula)
}

F -> T "power" integer_between(2, 5) when cost >= 1 and cost <= 2 weight 3 {
  cost = -1
  require $1.constant = 0
  constant = 0
  monomial = 1
  constants_used = 0
  linear_terms = 0
  power = 1
  formula = formula_power($1.formula, $3.value)
  latex = formula_latex(formula)
}

F -> F "power" integer_between(2, 5) when cost >= 5 weight 3 {
  cost = -3
  require $1.power = 0
  power = 1
  constant = 0
  monomial = 0
  constants_used = $1.constants_used
  linear_terms = 0
  formula = formula_power($1.formula, $3.value)
  latex = formula_latex(formula)
}

F -> "sin" T when cost >= 1 and cost <= 2 weight 2 {
  cost = -1
  require $2.constant = 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_sin($2.formula)
  latex = formula_latex(formula)
}

F -> "sin" F when cost >= 5 weight 2 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_sin($2.formula)
  latex = formula_latex(formula)
}

F -> "cos" T when cost >= 1 and cost <= 2 weight 2 {
  cost = -1
  require $2.constant = 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_cos($2.formula)
  latex = formula_latex(formula)
}

F -> "cos" F when cost >= 5 weight 2 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_cos($2.formula)
  latex = formula_latex(formula)
}

F -> "exp" T when cost >= 1 and cost <= 2 weight 1 {
  cost = -1
  require $2.constant = 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_exp($2.formula)
  latex = formula_latex(formula)
}

F -> "exp" F when cost >= 5 weight 1 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_exp($2.formula)
  latex = formula_latex(formula)
}

# ---- Constructs only a derivative question uses ---------------------------
#
# ln and sqrt take a leaf with a positive coefficient, so that the function
# is defined for positive x; on a compound no such promise is made, and the
# question reads "where the function is defined".

F -> "ln" T when advanced > 0 and cost >= 1 and cost <= 2 weight 2 {
  cost = -1
  require $2.constant = 0
  require $2.coefficient > 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_ln($2.formula)
  latex = formula_latex(formula)
}

F -> "ln" F when advanced > 0 and cost >= 5 weight 2 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_ln($2.formula)
  latex = formula_latex(formula)
}

F -> "sqrt" T when advanced > 0 and cost >= 1 and cost <= 2 weight 2 {
  cost = -1
  require $2.constant = 0
  require $2.coefficient > 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_sqrt($2.formula)
  latex = formula_latex(formula)
}

F -> "sqrt" F when advanced > 0 and cost >= 5 weight 2 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_sqrt($2.formula)
  latex = formula_latex(formula)
}

F -> "tan" T when advanced > 0 and cost >= 1 and cost <= 2 weight 1 {
  cost = -1
  require $2.constant = 0
  constant = 0
  monomial = 0
  constants_used = 0
  linear_terms = 0
  power = 0
  formula = formula_tan($2.formula)
  latex = formula_latex(formula)
}

F -> "tan" F when advanced > 0 and cost >= 5 weight 1 {
  cost = -3
  constant = 0
  monomial = 0
  constants_used = $2.constants_used
  linear_terms = 0
  power = 0
  formula = formula_tan($2.formula)
  latex = formula_latex(formula)
}

# The quotient rule: 4 plus both sides. A constant denominator would be a
# scaling, not a quotient.
F -> F "/" F when advanced > 0 and cost >= 4 weight 2 {
  cost = -4
  require $1.latex != $3.latex
  require $3.constant = 0
  constant = 0
  monomial = 0
  constants_used = $1.constants_used + $3.constants_used
  linear_terms = 0
  power = 0
  formula = formula_divide($1.formula, $3.formula)
  latex = formula_latex(formula)
}

F -> T when cost <= 1 {
  power = 0
  constant = $1.constant
  monomial = $1.monomial
  constants_used = $1.constants_used
  linear_terms = $1.linear
  formula = $1.formula
  latex = $1.latex
}

# ---- Leaves --------------------------------------------------------------

T -> "x" when cost = 0 weight 4 {
  constant = 0
  monomial = 1
  constants_used = 0
  linear = 1
  coefficient = 1
  formula = formula_variable("x")
  latex = formula_latex(formula)
  value = formula
}

# A coefficient of 1 or -1 would be simplified away, leaving a leaf that
# prints as x but was priced as c*x.
T -> nonzero_integer_between(-6, 6) "x" when cost = 1 weight 4 {
  cost = -1
  require $1.value != 1 and $1.value != -1
  constant = 0
  monomial = 1
  constants_used = 0
  linear = 1
  coefficient = $1.value
  formula = formula_multiply(
              formula_constant($1.value),
              formula_variable("x"))
  latex = formula_latex(formula)
  value = formula
}

T -> nonzero_integer_between(-8, 8) when cost = 0 and constants > 0 weight 1 {
  constant = 1
  monomial = 0
  constants_used = 1
  linear = 0
  coefficient = $1.value
  formula = formula_constant($1.value)
  latex = formula_latex(formula)
  value = formula
}

prompt "{Q.text}"
answer Q.answer_value
width 24
