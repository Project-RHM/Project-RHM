DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->flags->set(reduceConstantFunctions=>0);
Context()->flags->set(reduceConstants=>0);

$fun_2 = Formula("((ln(x)))^(1/4)");
$fun_1 = Formula("cos((x^2-2*x+4))");

Context("Interval");

$set_ans_3 = Compute("(-infinity, 11) U ({-7, -6, -5, -2, 4, 5}) U ((-infinity, 11)) U {-7, -6, -5, -2, 4, 5} - ((-infinity, infinity) - ({-7, -6, -5, -2, 4, 5}))");
$set_ans_4 = Compute("([4, 12]) U ((-infinity, 11)) U ([4, 12])");
$set_ans_5 = Compute("[4, 12] - ((-infinity, infinity) - (({-7, -6, -5, -2, 4, 5} U (-infinity, 11)))) - ((-infinity, infinity) - [4, 12])");
$set_ans_1 = Compute("(([4, infinity)) U {-9, -7, -1, 7} U [4, infinity)) - ((-infinity, infinity) - {-9, -7, -1, 7}) - ((-infinity, infinity) - ({-6, -1, 4, 5, 8} - ((-infinity, infinity) - ({-6, -1, 4, 5, 8} - ((-infinity, infinity) - {-9, -7, -1, 7})))))");
$set_ans_2 = Compute("({-6, -1, 4, 5, 8}) U [4, infinity) U {-6, -1, 4, 5, 8} U {-9, -7, -1, 7}");

Context("Vector");

BEGIN_PGML
# Questions:

- _For arithmetic problems, if the result is not an integer, then retain *three significant digits*._
- _For derivative problems, if the result is undefined, then *leave the blank empty*._

[`8*9+17*9`] is equal to [_____]{answer=>Real(225.),width=>7}
---

[`8+0*5`] is equal to [_____]{answer=>Real(8.),width=>6}
---

[`4+9`] is equal to [_____]{answer=>13,width=>5}
---

[`12/9+4/10`] is equal to [_____]{answer=>Formula('1.73333333333'),width=>9}
---

Given the sets:
- [`A = \{-9, -7, -1, 7\}`]
- [`B = \{x | x \geq 4\}`]
- [`C = \{-6, -1, 4, 5, 8\}`]

Compute:
- [`((B) \cup A \cup B) \cap A \cap (C \cap (C \cap A)) = `] [_____]{$set_ans_1}
- [`(C) \cup B \cup C \cup A = `] [_____]{$set_ans_2}

---

Given the sets:
- [`A = \{-7, -6, -5, -2, 4, 5\}`]
- [`B = \{x | 4 \leq x \leq 12\}`]
- [`C = \{x | x < 11\}`]

Compute:
- [`C \cup (A) \cup (C) \cup A \cap (A) = `] [_____]{$set_ans_3}
- [`(B) \cup (C) \cup (B) = `] [_____]{$set_ans_4}
- [`B \cap ((A \cup C)) \cap B = `] [_____]{$set_ans_5}

---

Suppose the vectors:
- [` \vec{u} = \langle -1, -5, -2 \rangle `]
- [` \vec{v} = \langle 8, 8, 8 \rangle `]
- [` \vec{w} = \langle -1, 4, -4 \rangle `]

Compute:
- [` \vec{u} \cdot \vec{w} = `] [_____]{Compute("<-1, -5, -2>") . Compute("<-1, 4, -4>")}
- [` \vec{u} \times \vec{v} = `] [_____]{Compute("<-1, -5, -2>") x Compute("<8, 8, 8>")}
- Enter a vector parallel to [` \vec{v} `]. [_____]{Compute("<8, 8, 8>")->cmp(parallel=>1)}
- [` \vec{w} \cdot \vec{v} = `] [_____]{Compute("<-1, 4, -4>") . Compute("<8, 8, 8>")}
- Enter a unit vector in the direction of [` \vec{v} `]. [_____]{unit(Compute("<8, 8, 8>"))}

---

Suppose the vectors:
- [` \vec{u} = \langle -1, -6, 3 \rangle `]
- [` \vec{v} = \langle -2, -5, 6 \rangle `]

Compute:
- [` \vec{v} \times \vec{u} = `] [_____]{Compute("<-2, -5, 6>") x Compute("<-1, -6, 3>")}
- [` \vec{u} \cdot \vec{v} = `] [_____]{Compute("<-1, -6, 3>") . Compute("<-2, -5, 6>")}
- Enter a unit vector in the direction of [` \vec{u} `]. [_____]{unit(Compute("<-1, -6, 3>"))}
- Enter a vector in the same direction as [` \vec{u} `]. [_____]{Compute("<-1, -6, 3>")->cmp(parallel=>1,sameDirection=>1)}
- Enter a vector in the same direction as [` \vec{v} `]. [_____]{Compute("<-2, -5, 6>")->cmp(parallel=>1,sameDirection=>1)}
- [` \left\| \vec{v} \right\| = `] [_____]{norm(Compute("<-2, -5, 6>"))}

---

Given this function:

>> [`[$fun_1]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_1->D()}
- [`f''(x) =`] [_____]{$fun_1->D()->D()}
- [`f'(8) =`] [_____]{$fun_1->D()->eval(x=>8)}

---

Given this function:

>> [`[$fun_2]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_2->D()}
- [`f''(x) =`] [_____]{$fun_2->D()->D()}

---
END_PGML
ENDDOCUMENT();
