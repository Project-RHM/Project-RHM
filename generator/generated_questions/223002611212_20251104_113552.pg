DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->flags->set(reduceConstantFunctions=>0);
Context()->flags->set(reduceConstants=>0);

$fun_1 = Formula("(sin(x))^2+1*(ln(x))+3");
$fun_2 = Formula("(x^2+3*x+2)^3");
$fun_3 = Formula("(5/(x))/5");
$fun_4 = Formula("((1/(x)))^2");
$fun_5 = Formula("4/(((cos(x))-3))");
$fun_6 = Formula("ln((sin(x)))");

BEGIN_PGML
# Questions:

_For arithmetic problems, if the result is not an integer, then retain *three significant digits*._

Given this function:

>> [`[$fun_1]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_1->D()}
- [`f'(x) =`] [_____]{$fun_1->D()}

---

Given this function:

>> [`[$fun_2]`] <<

Compute:
- [`f''(x) =`] [_____]{$fun_2->D()->D()}
- [`f'(x) =`] [_____]{$fun_2->D()}

---

Given this function:

>> [`[$fun_3]`] <<

Compute:
- [`f''(x) =`] [_____]{$fun_3->D()->D()}
- [`f'(x) =`] [_____]{$fun_3->D()}
- [`f'(5) =`] [_____]{$fun_3->D()->eval(x=>5)}
- [`f'(x) =`] [_____]{$fun_3->D()}

---

Given this function:

>> [`[$fun_4]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_4->D()}
- [`f'(8) =`] [_____]{$fun_4->D()->eval(x=>8)}
- [`f'(3) =`] [_____]{$fun_4->D()->eval(x=>3)}
- [`f'(x) =`] [_____]{$fun_4->D()}

---

Given this function:

>> [`[$fun_5]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_5->D()}
- [`f''(x) =`] [_____]{$fun_5->D()->D()}
- [`f'(x) =`] [_____]{$fun_5->D()}

---

Given this function:

>> [`[$fun_6]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_6->D()}
- [`f''(x) =`] [_____]{$fun_6->D()->D()}
- [`f'(9) =`] [_____]{$fun_6->D()->eval(x=>9)}
- [`f'(x) =`] [_____]{$fun_6->D()}

---
END_PGML
ENDDOCUMENT();
