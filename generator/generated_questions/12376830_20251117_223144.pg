DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->operators->undefine('+','-','*','/');

BEGIN_PGML
# Questions:

_For arithmetic problems, if the result is not an integer, then retain *three significant digits*._

[`14+10-19+15*18`] is equal to [_____]{answer=>Formula('275'),width=>1}
---

[`18+16+7`] is equal to [_____]{Formula('41')}
---

What is the value of [`0+0+15-0*16`]? [_____]{15}
---

[`14+14-1-0/9`] is equal to [_____]{Formula('27')}
---
END_PGML
ENDDOCUMENT();
