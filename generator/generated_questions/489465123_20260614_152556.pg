"PGML.pl"
);
Context("Numeric");
Context()->flags->set(reduceConstantFunctions=>0);
Context()->flags->set(reduceConstants=>0);

$anti_1 = Formula("6*(x^4)");
$fun_1 = $anti_1->D();
$anti_2 = Formula("(x^4)^3");
$fun_2 = $anti_2->D();
$anti_3 = Formula("sin(((x)^2))");
