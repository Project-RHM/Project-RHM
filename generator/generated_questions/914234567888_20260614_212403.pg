DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Complex");

$complex_ans_10 = Complex(66,38);
$complex_ans_9 = Complex(5,-2);
$complex_ans_8 = Complex(5,-1);
$complex_ans_7 = Complex(2,6);
$complex_ans_6 = Complex(6,1);
$complex_ans_5 = Complex(-5,-1);
$complex_ans_4 = Complex(-1,0);
$complex_ans_3 = Complex(-4,2);
$complex_ans_2 = Complex(2,14);
$complex_ans_1 = Complex(-1,-8);

BEGIN_PGML
# Questions:

- _For arithmetic problems, if the result is not an integer, then retain *three significant digits*._
- _For derivative problems, if the result is undefined, then *leave the blank empty*._

Find the conjugate of:
[`-1 + 8i`]
[_____]{$complex_ans_1}
---

Compute the complex number expression:
[`(2 + 4i) * (3 + 1i)`]
[_____]{$complex_ans_2}
---

Find the conjugate of:
[`-4 - 2i`]
[_____]{$complex_ans_3}
---

Simplify the power of i:
[`i^2`]
[_____]{$complex_ans_4}
---

Compute the complex number expression:
[`(1 - 8i) + (-6 + 7i)`]
[_____]{$complex_ans_5}
---

Compute the complex number expression:
[`(8 - 4i) + (-2 + 5i)`]
[_____]{$complex_ans_6}
---

Find the conjugate of:
[`2 - 6i`]
[_____]{$complex_ans_7}
---

Compute the complex number expression:
[`(-1 + 2i) + (6 - 3i)`]
[_____]{$complex_ans_8}
---

Compute the complex number expression:
[`(1 + 5i) + (4 - 7i)`]
[_____]{$complex_ans_9}
---

Compute the complex number expression:
[`(-3 - 7i) * (-8 + 6i)`]
[_____]{$complex_ans_10}
---
END_PGML
ENDDOCUMENT();
