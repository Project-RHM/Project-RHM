DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->operators->undefine('+','-','*','/');

BEGIN_PGML
# Questions:

- _For arithmetic problems, if the result is not an integer, then retain *three significant digits*._
- _For derivative problems, if the result is undefined, then *leave the blank empty*._

[`0+18-18+9`] is equal to [_____]{Real(9.)}
---

[`5+1-10+18*9`] is equal to [_____]{Formula('158')}
---

[`12+5+3+8*16`] is equal to [_____]{answer=>148,width=>8}
---

[`9+8+19+14*15`] is equal to [_____]{answer=>246,width=>1}
---

[`5+7+18-14*4`] is equal to [_____]{Real(-26.)}
---
END_PGML
ENDDOCUMENT();
