DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->operators->undefine('+','-','*','/');

BEGIN_PGML
# Questions:

_For arithmetic problems, if the result is not an integer, then retain *three significant digits*._

[`18+11-1+16*10`] is equal to [_____]{answer=>Formula("188"),width=>2}
---

[`13+6+18-14*19`] is equal to [_____]{answer=>Real(-229),width=>5}
---

[`10+2+7*0`] is equal to [_____]{Real(12)}
---
END_PGML
ENDDOCUMENT();
