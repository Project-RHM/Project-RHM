DOCUMENT();
loadMacros(
"PGstandard.pl",
"MathObjects.pl",
"PGML.pl"
);
Context("Numeric");
Context()->flags->set(reduceConstantFunctions=>0);
Context()->flags->set(reduceConstants=>0);

$fun_2 = Formula("cos((10/(x)))");
$fun_1 = Formula("((ln(x))/10)/3");

Context("Interval");

$set_ans_4 = Compute("{-10, -9, -5, 2, 6, 7} U {-10, -9, -5, 2, 6, 7}");
$set_ans_5 = Compute("{-10, -9, -5, 2, 6, 7} - ((-infinity, infinity) - ({-10, -9, -5, 2, 6, 7})) U {-9, 4, 6, 8} U {-10, -9, -5, 2, 6, 7}");
$set_ans_6 = Compute("{-10, -9, -5, 2, 6, 7} U {-9, 4, 6, 8} U {-9, 4, 6, 8} U {-10, -9, -5, 2, 6, 7} - ((-infinity, infinity) - {-9, 4, 6, 8})");
$set_ans_1 = Compute("(9, infinity) U ({-10, -7, -3, -1, 5, 8} U {-10, -7, -3, -1, 5, 8} - ((-infinity, infinity) - (({-10, -7, -3, -1, 5, 8}) U {-10, -7, -3, -1, 5, 8}))) U (9, infinity) U (9, infinity)");
$set_ans_2 = Compute("(9, infinity) U (9, infinity)");
$set_ans_3 = Compute("((9, infinity) U (9, infinity)) U (9, infinity) U {-10, -7, -3, -1, 5, 8} U (9, infinity) - ((-infinity, infinity) - ((9, infinity) U {-10, -7, -3, -1, 5, 8}))");

Context("Vector");

BEGIN_PGML
# Questions:

_For arithmetic problems, if the result is not an integer, then retain *three significant digits*._

[`3+7+18+11/10`] is equal to [_____]{Formula('29.1')}
---

What is the value of [`15+18+19/16`]? [_____]{34.1875}
---

Given the sets:
- [`A = \{-10, -7, -3, -1, 5, 8\}`]
- [`B = \{x | x > 8\}`]

Compute:
- [`B \cup (A \cup A \cap ((A) \cup A)) \cup B \cup B = `] [_____]{$set_ans_1}
- [`B \cup B = `] [_____]{$set_ans_2}
- [`(B \cup B) \cup B \cup A \cup B \cap (B \cup A) = `] [_____]{$set_ans_3}

---

Given the sets:
- [`A = \{-9, 4, 6, 8\}`]
- [`B = \{-10, -9, -5, 2, 6, 7\}`]

Compute:
- [`B \cup B = `] [_____]{$set_ans_4}
- [`B \cap (B) \cup A \cup B = `] [_____]{$set_ans_5}
- [`B \cup A \cup A \cup B \cap A = `] [_____]{$set_ans_6}

---

Suppose the vectors:
- [` \vec{u} = \langle 3, 8, -6 \rangle `]
- [` \vec{v} = \langle -9, -7, -8 \rangle `]
- [` \vec{w} = \langle -8, -1, 1 \rangle `]

Compute:
- Enter a vector in the same direction as [` \vec{v} `]. [_____]{Compute("<-9, -7, -8>")->cmp(parallel=>1,sameDirection=>1)}
- Enter a unit vector in the direction of [` \vec{w} `]. [_____]{unit(Compute("<-8, -1, 1>"))}
- [` \vec{u} \times \vec{v} = `] [_____]{Compute("<3, 8, -6>") x Compute("<-9, -7, -8>")}
- Enter a vector parallel to [` \vec{u} `]. [_____]{Compute("<3, 8, -6>")->cmp(parallel=>1)}
- [` \left\| \vec{v} \right\| = `] [_____]{norm(Compute("<-9, -7, -8>"))}
- [` \vec{v} \cdot \vec{w} = `] [_____]{Compute("<-9, -7, -8>") . Compute("<-8, -1, 1>")}

---

Suppose the vectors:
- [` \vec{u} = \langle 4, -10, -6 \rangle `]
- [` \vec{v} = \langle 9, 8, -6 \rangle `]
- [` \vec{w} = \langle 2, -7, 6 \rangle `]

Compute:
- Enter a vector in the same direction as [` \vec{u} `]. [_____]{Compute("<4, -10, -6>")->cmp(parallel=>1,sameDirection=>1)}
- Enter a vector in the same direction as [` \vec{v} `]. [_____]{Compute("<9, 8, -6>")->cmp(parallel=>1,sameDirection=>1)}
- [` \left\| \vec{w} \right\| = `] [_____]{norm(Compute("<2, -7, 6>"))}
- [` \left\| \vec{u} \right\| = `] [_____]{norm(Compute("<4, -10, -6>"))}
- [` \vec{w} \cdot \vec{u} = `] [_____]{Compute("<2, -7, 6>") . Compute("<4, -10, -6>")}
- Enter a vector parallel to [` \vec{v} `]. [_____]{Compute("<9, 8, -6>")->cmp(parallel=>1)}

---

Given this function:

>> [`[$fun_1]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_1->D()}
- [`f'(9) =`] [_____]{$fun_1->D()->eval(x=>9)}
- [`f'(3) =`] [_____]{$fun_1->D()->eval(x=>3)}
- [`f'(8) =`] [_____]{$fun_1->D()->eval(x=>8)}

---

Given this function:

>> [`[$fun_2]`] <<

Compute:
- [`f'(x) =`] [_____]{$fun_2->D()}
- [`f''(x) =`] [_____]{$fun_2->D()->D()}
- [`f'(8) =`] [_____]{$fun_2->D()->eval(x=>8)}

---
END_PGML
ENDDOCUMENT();
