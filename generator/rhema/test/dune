; The library's files are given by name. The test must not list the
; directory: the suites run side by side in it, and another one's temporary
; grammar may be there one moment and gone the next.
(test
 (name rhema_types_test)
 (modules rhema_types_test)
 (package rhema)
 (libraries rhema)
 (deps (glob_files %{project_root}/stdlib/*.rhm))
 (action (chdir %{project_root}/stdlib (run %{test} %{deps}))))

