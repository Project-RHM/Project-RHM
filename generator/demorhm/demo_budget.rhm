# Reused from the October 27 demo: the same rules, checked with current Rhema.
attribute cost = 4 split

synth value on E
synth latex on E

precedence 1 left + -
precedence 2 left *

start E

E -> E + E when cost >= 1 weight 3 {
  cost = -1
  value = $1.value + $3.value
  latex = infix($1, "+", $3)
}

E -> E - E when cost >= 2 weight 2 {
  cost = -2
  require $1.value != $3.value
  value = $1.value - $3.value
  latex = infix($1, "-", $3)
}

E -> E * E when cost >= 3 weight 2 {
  cost = -3
  value = $1.value * $3.value
  latex = infix($1, "\\cdot", $3)
}

E -> integer_between(2, 9) when cost = 0 {
  value = $1.value
  latex = str($1.value)
}

prompt "Evaluate [`{E.latex}`]."
answer E.value
