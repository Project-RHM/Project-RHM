# Generated by the Rhema form editor.

attribute cost = 12 split

attribute digit = 4 copy

synth value on E

synth value on num

synth latex on E

synth latex on num

precedence 1 left "+" "-"

precedence 2 left "*" "/"

start E

E -> E + E when (cost >= 1) weight 6 {
  cost = (- 1)
  value = ($1.value + $3.value)
  latex = infix($1, "+", $3)
}

E -> E - E when (cost >= 2) weight 4 {
  cost = (- 2)
  require ($1.value != $3.value)
  value = ($1.value - $3.value)
  latex = infix($1, "-", $3)
}

E -> E * E when (cost >= 3) weight 3 {
  cost = (- 3)
  value = ($1.value * $3.value)
  latex = infix($1, "\\cdot", $3)
}

E -> E / E when (cost >= 4) weight 2 {
  cost = (- 4)
  require ($3.value != 0)
  value = ($1.value / $3.value)
  latex = infix($1, "\\div", $3)
}

E -> num when ((cost <= 3) and (cost < digit)) weight 15 {
  value = $1.value
  latex = $1.latex
}

num -> integer_between(2, 9) when (cost = 0) weight 1 {
  value = $1.value
  latex = str($1.value)
}

num -> integer(2) when (cost = 1) weight 1 {
  cost = (- 1)
  value = $1.value
  latex = str($1.value)
}

num -> integer(3) when (cost = 2) weight 1 {
  cost = (- 2)
  value = $1.value
  latex = str($1.value)
}

num -> integer(4) when (cost = 3) weight 1 {
  cost = (- 3)
  value = $1.value
  latex = str($1.value)
}

num -> "fraction" integer_between(1, 9) integer_between(1, 4) when (cost = 2) weight 1 {
  cost = (- 2)
  require (($2.value % cond(($3.value = 1), 2, cond(($3.value = 2), 3, cond(($3.value = 3), 5, 7)))) != 0)
  value = ($2.value / cond(($3.value = 1), 2, cond(($3.value = 2), 3, cond(($3.value = 3), 5, 7))))
  latex = ("\\frac{" ++ (str($2.value) ++ ("}{" ++ (str(cond(($3.value = 1), 2, cond(($3.value = 2), 3, cond(($3.value = 3), 5, 7)))) ++ "}"))))
}

prompt "What is the value of [`{E.latex}`]?"

answer E.value

width 16
