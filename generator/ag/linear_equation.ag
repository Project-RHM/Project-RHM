# ==========================================================================
#  Solving a linear equation in several steps
#
#  The root is chosen first. The left side is a tree of sums, differences,
#  bracketed multiples and fractions in x, which is linear, so it is
#  s*x + t for a slope s and intercept t computed alongside it. The right
#  side is c*x + k with c different from s and k chosen so that both sides
#  agree at the root; the equation then has exactly that root. The answer is
#  right by construction and the student's work is in the left side.
#
#  Difficulty is the budget `cost`, spent exactly:
#
#    sum or difference          1        a multiple of a bracket   1
#    a fraction with a number   2        x, c*x or a number        0
#    below the line
#
#  Every whole number from 1 upwards can be spent; the least is 1, since a
#  single term on the left is no equation to work through.
#
#    agrun --set cost=2 linear_equation.ag     easy
#    agrun --set cost=5 linear_equation.ag     medium (the default)
#    agrun --set cost=8 linear_equation.ag     hard
# ==========================================================================

context "Numeric"

attribute cost = 5 split

random root = integer_between(-6, 6)
random direction = nonzero_integer_between(-1, 1)

synth text on Q
synth answer_value on Q
synth c on Q                   # the slope on the right, never the left one
synth rhs on Q

synth formula on E
synth latex on E
synth slope on E
synth intercept on E
synth constant on E            # 1 when the subtree is a bare number
synth numbers on E             # numbers added directly in this chain
synth x_terms on E             # x terms added directly in this chain
synth fraction on E            # 1 for a fraction, so fractions do not nest
synth formula on T
synth latex on T
synth slope on T
synth intercept on T
synth constant on T
synth value on T

start Q

Q -> E {
  require $1.slope != 0
  require $1.constant = 0
  c = cond($1.slope + direction = 0, $1.slope + 2 * direction, $1.slope + direction)
  rhs = formula_add(formula_multiply(formula_constant(c), formula_variable("x")),
                    formula_constant($1.slope * root + $1.intercept - c * root))
  text = "Solve for [`x`]:
[`" ++ $1.latex ++ " = " ++ formula_latex(rhs) ++ "`]."
  answer_value = root
}

# ---- The left side ---------------------------------------------------------
#
# Each rule's guard is the least it can spend. A chain of sums holds at most
# one number and two x terms (more would only be collecting), and a multiple
# or a fraction takes a compound, which keeps at least 1 of the budget.

E -> E "+" E when cost >= 1 weight 3 {
  cost = -1
  require $1.latex != $3.latex
  numbers = $1.numbers + $3.numbers
  x_terms = $1.x_terms + $3.x_terms
  require numbers <= 1 and x_terms <= 2
  formula = formula_add($1.formula, $3.formula)
  require not formula_is_zero(formula)   # -5x + 5x would fold away
  latex = formula_latex(formula)
  slope = $1.slope + $3.slope
  intercept = $1.intercept + $3.intercept
  constant = 0
  fraction = 0
}

E -> E "-" E when cost >= 1 weight 3 {
  cost = -1
  require $1.latex != $3.latex
  numbers = $1.numbers + $3.numbers
  x_terms = $1.x_terms + $3.x_terms
  require numbers <= 1 and x_terms <= 2
  formula = formula_subtract($1.formula, $3.formula)
  require not formula_is_zero(formula)   # -5x + 5x would fold away
  latex = formula_latex(formula)
  slope = $1.slope - $3.slope
  intercept = $1.intercept - $3.intercept
  constant = 0
  fraction = 0
}

E -> integer_between(2, 5) "\cdot" E when cost >= 2 weight 2 {
  cost = -1
  formula = formula_multiply(formula_constant($1.value), $3.formula)
  latex = formula_latex(formula)
  slope = $1.value * $3.slope
  intercept = $1.value * $3.intercept
  constant = 0
  numbers = 0
  x_terms = 1
  fraction = 0
}

E -> E "/" integer_between(2, 4) when cost >= 3 weight 2 {
  cost = -2
  require $1.fraction = 0
  formula = formula_divide($1.formula, formula_constant($3.value))
  latex = formula_latex(formula)
  slope = $1.slope / $3.value
  intercept = $1.intercept / $3.value
  constant = 0
  numbers = 0
  x_terms = 1
  fraction = 1
}

E -> T when cost = 0 {
  formula = $1.formula
  latex = $1.latex
  slope = $1.slope
  intercept = $1.intercept
  constant = $1.constant
  numbers = $1.constant
  x_terms = 1 - $1.constant
  fraction = 0
}

# ---- Terms -----------------------------------------------------------------

T -> "x" weight 3 {
  formula = formula_variable("x")
  latex = formula_latex(formula)
  slope = 1
  intercept = 0
  constant = 0
  value = formula
}

T -> nonzero_integer_between(-5, 5) "x" weight 3 {
  require $1.value != 1 and $1.value != -1
  formula = formula_multiply(formula_constant($1.value), formula_variable("x"))
  latex = formula_latex(formula)
  slope = $1.value
  intercept = 0
  constant = 0
  value = formula
}

T -> nonzero_integer_between(-9, 9) weight 2 {
  formula = formula_constant($1.value)
  latex = formula_latex(formula)
  slope = 0
  intercept = $1.value
  constant = 1
  value = formula
}

prompt "{Q.text}"
answer Q.answer_value
width 10
