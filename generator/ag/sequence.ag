# ==========================================================================
#  Arithmetic and geometric sequences
#
#  One specification covers four question forms. Question-level random values
#  are drawn once, while weighted Q rules decide which form is asked.
# ==========================================================================

random first      = integer_between(-10, 10)
random difference = nonzero_integer_between(-8, 8)
random ratio      = nonzero_integer_between(-5, 5)
random index      = integer_between(2, 8)

let first_text      = str(first)
let difference_text = str(difference)
let ratio_text      = str(ratio)
let index_text      = str(index)

synth kind on Q
synth first_value on Q
synth step_value on Q
synth index_value on Q
synth text on Q
synth value on Q

start Q

# Arithmetic nth term: a_n = a_1 + (n - 1)d
Q -> "arithmetic_nth" weight 3 {
  kind        = "arithmetic_nth"
  first_value = first
  step_value  = difference
  index_value = index
  text        = "An arithmetic sequence has first term [`a_1 = " ++ first_text
                ++ "`] and common difference [`d = " ++ difference_text
                ++ "`]. Find [`a_{" ++ index_text ++ "}`]."
  value       = first + (index - 1) * difference
}

# Geometric nth term: a_n = a_1 r^(n - 1)
Q -> "geometric_nth" weight 3 {
  kind        = "geometric_nth"
  first_value = first
  step_value  = ratio
  index_value = index
  text        = "A geometric sequence has first term [`a_1 = " ++ first_text
                ++ "`] and common ratio [`r = " ++ ratio_text
                ++ "`]. Find [`a_{" ++ index_text ++ "}`]."
  value       = first * (ratio ^ (index - 1))
}

# Arithmetic finite sum: S_n = n(2a_1 + (n - 1)d)/2
Q -> "arithmetic_sum" weight 2 {
  kind        = "arithmetic_sum"
  first_value = first
  step_value  = difference
  index_value = index
  text        = "An arithmetic sequence has first term [`a_1 = " ++ first_text
                ++ "`] and common difference [`d = " ++ difference_text
                ++ "`]. Find the sum [`S_{" ++ index_text ++ "}`]."
  value       = index * (2 * first + (index - 1) * difference) / 2
}

# Geometric finite sum. cond is lazy, so r = 1 does not evaluate the division.
Q -> "geometric_sum" weight 2 {
  kind        = "geometric_sum"
  first_value = first
  step_value  = ratio
  index_value = index
  text        = "A geometric sequence has first term [`a_1 = " ++ first_text
                ++ "`] and common ratio [`r = " ++ ratio_text
                ++ "`]. Find the sum [`S_{" ++ index_text ++ "}`]."
  value       = cond(ratio = 1,
                     first * index,
                     first * ((ratio ^ index) - 1) / (ratio - 1))
}

prompt "{Q.text}"
answer Q.value
width 10
