# ==========================================================================
#  Four-operation arithmetic
#
#  Everything a question needs -- its shape, its answer, and its wording --
#  is defined in this file. Editing it does not require rebuilding OCaml.
# ==========================================================================


# ---- Inherited attributes: budgets handed down, controlling difficulty ----
#
#   split = the remaining budget is divided between the child nodes
#   copy  = the same value is passed unchanged to every child

attribute len   = 3 split      # operator count: len = 3 produces exactly 3 operators
attribute digit = 2 copy       # digits per number: every integer is 2 digits


# ---- Synthesized attributes: results computed on the way back up ----

synth value                    # what this subtree equals -> becomes the answer
synth latex                    # how this subtree is written -> becomes the question


# ---- Precedence: parentheses are added automatically from this table ----

precedence 1 left  +  -
precedence 2 left  *  /


start E


# ---- Productions ----
#
#   How to read one:   shape      when it may apply     weight   { equations }
#
#   $1 $2 $3 refer to the symbols on the right of the arrow, counting from 1.
#   In E -> E + E, $1 is the left E, $2 is the plus sign, $3 is the right E.

E -> E + E   when len > 0   weight 3 {
       len   = -1
       value = $1.value + $3.value
       latex = infix($1, "+", $3)
     }

E -> E - E   when len > 0   weight 3 {
       len   = -1
       value = $1.value - $3.value
       latex = infix($1, "-", $3)
     }

E -> E * E   when len > 0   weight 2 {
       len   = -1
       value = $1.value * $3.value
       latex = infix($1, "\\cdot", $3)
     }

E -> E / E   when len > 0   weight 1 {
       len   = -1
       require $3.value != 0          # no zero denominator; retry this subtree
       value = $1.value / $3.value
       latex = infix($1, "\\div", $3)
     }

# The budget is spent, so this is the only rule left -- which is why
# generation always terminates.
E -> num     when len = 0 {
       value = $1.value
       latex = $1.latex
     }

# integer(digit) is a leaf that rolls a die: it draws a digit-digit integer.
num -> integer(digit) {
       value = $1.value
       latex = str($1.value)
     }


# ---- Question wording ----
#
#   {E.latex} is replaced by the generated expression.
#   To change how the question reads, edit the line below.

prompt "What is the value of [`{E.latex}`]?"
answer E.value
