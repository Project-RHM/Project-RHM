# ==========================================================================
# Set expressions over three question-level definitions.
#
# set_mode = 0  mixed union/intersection/difference
#            1  union only
#            2  intersection only
#            3  difference only
#
# Each A/B/C definition is fixed before the expression tree is generated, so
# every repeated occurrence denotes exactly the same set.
# ==========================================================================

context "Interval"

attribute len = 3 split
attribute set_mode = 0 copy

# Finite candidates. set_insert canonicalizes order and removes duplicates.
random a1 = integer_between(-9, 12)
random a2 = integer_between(-9, 12)
random a3 = integer_between(-9, 12)
random a4 = integer_between(-9, 12)
random b1 = integer_between(-9, 12)
random b2 = integer_between(-9, 12)
random b3 = integer_between(-9, 12)
random b4 = integer_between(-9, 12)
random c1 = integer_between(-9, 12)
random c2 = integer_between(-9, 12)
random c3 = integer_between(-9, 12)
random c4 = integer_between(-9, 12)

let a_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), a1), a2), a3), a4)
let b_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), b1), b2), b3), b4)
let c_finite = set_insert(set_insert(set_insert(set_insert(set_empty(), c1), c2), c3), c4)

# Interval candidates. Independent endpoint flags cover (), [), (], and [].
random a_lower = integer_between(-9, 3)
random a_width = integer_between(2, 9)
random a_left_closed = boolean
random a_right_closed = boolean
random b_lower = integer_between(-9, 3)
random b_width = integer_between(2, 9)
random b_left_closed = boolean
random b_right_closed = boolean
random c_lower = integer_between(-9, 3)
random c_width = integer_between(2, 9)
random c_left_closed = boolean
random c_right_closed = boolean

let a_interval = set_interval(a_lower, a_lower + a_width, a_left_closed, a_right_closed)
let b_interval = set_interval(b_lower, b_lower + b_width, b_left_closed, b_right_closed)
let c_interval = set_interval(c_lower, c_lower + c_width, c_left_closed, c_right_closed)

random a_uses_interval = boolean
random b_uses_interval = boolean
random c_uses_interval = boolean

let set_a = cond(a_uses_interval, a_interval, a_finite)
let set_b = cond(b_uses_interval, b_interval, b_finite)
let set_c = cond(c_uses_interval, c_interval, c_finite)

let definitions = "Given the sets:
- [`A = " ++ set_latex(set_a) ++ "`]
- [`B = " ++ set_latex(set_b) ++ "`]
- [`C = " ++ set_latex(set_c) ++ "`]"

synth text on Q
synth answer_value on Q

synth value on E
synth latex on E

synth value on S
synth latex on S

start Q

precedence 1 left "\cup"
precedence 2 left "\cap" "\setminus"

Q -> E {
  require set_a != set_b
  require set_a != set_c
  require set_b != set_c
  text = definitions ++ "
Compute the set expression:
[`" ++ $1.latex ++ "`]."
  answer_value = $1.value
}

E -> E "\cup" E when len > 0 and (set_mode = 0 or set_mode = 1) weight 3 {
  len = -1
  require $1.latex != $3.latex
  value = set_union($1.value, $3.value)
  latex = infix($1, "\cup", $3)
}

E -> E "\cap" E when len > 0 and (set_mode = 0 or set_mode = 2) weight 3 {
  len = -1
  require $1.latex != $3.latex
  value = set_intersection($1.value, $3.value)
  latex = infix($1, "\cap", $3)
}

E -> E "\setminus" E when len > 0 and (set_mode = 0 or set_mode = 3) weight 2 {
  len = -1
  require $1.latex != $3.latex
  value = set_difference($1.value, $3.value)
  latex = infix($1, "\setminus", $3)
}

E -> S when len = 0 {
  value = $1.value
  latex = $1.latex
}

S -> "A" weight 1 {
  value = set_a
  latex = "A"
}

S -> "B" weight 1 {
  value = set_b
  latex = "B"
}

S -> "C" weight 1 {
  value = set_c
  latex = "C"
}

prompt "{Q.text}"
answer Q.answer_value
width 24
