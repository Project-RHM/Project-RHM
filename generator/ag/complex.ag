# ==========================================================================
#  Complex numbers
#
#  One specification covers recursive arithmetic expressions, conjugates,
#  integer-valued moduli, and powers of i. Complex values remain semantic
#  values until PGML rendering; latex is only their displayed representation.
# ==========================================================================

context "Complex"

# Exactly two arithmetic operators are used when a rule expands E.
attribute len = 2 split

# Values used by the guaranteed-integer modulus rule. For m > 1,
# (m^2 - 1, 2m, m^2 + 1) is a Pythagorean triple. Independent signs and a
# swap add variety without weakening the correctness guarantee.
random modulus_m       = integer_between(2, 6)
random modulus_sign_re = nonzero_integer_between(-1, 1)
random modulus_sign_im = nonzero_integer_between(-1, 1)
random modulus_swap    = boolean

let modulus_a = modulus_m * modulus_m - 1
let modulus_b = 2 * modulus_m
let modulus_re = cond(modulus_swap,
                      modulus_sign_re * modulus_b,
                      modulus_sign_re * modulus_a)
let modulus_im = cond(modulus_swap,
                      modulus_sign_im * modulus_a,
                      modulus_sign_im * modulus_b)
let modulus_value = modulus_m * modulus_m + 1
let modulus_latex = complex_latex(modulus_re, modulus_im)

# i^n depends only on n mod 4.
random exponent = integer_between(2, 24)
let power_case = exponent % 4
let power_re = cond(power_case = 0, 1,
                    cond(power_case = 2, -1, 0))
let power_im = cond(power_case = 1, 1,
                    cond(power_case = 3, -1, 0))
let exponent_text = str(exponent)

synth kind on Q
synth text on Q
synth answer_value on Q

synth re on E
synth im on E
synth latex on E

synth re on Z
synth im on Z
synth latex on Z
synth value on Z

start Q

precedence 1 left "+" "-"
precedence 2 left "\cdot"

# ---- Question forms ------------------------------------------------------

Q -> E "arithmetic" weight 5 {
  kind = "arithmetic"
  text = "Compute the complex number expression:
[`" ++ $1.latex ++ "`]."
  answer_value = complex($1.re, $1.im)
}

Q -> E "conjugate" weight 2 {
  kind = "conjugate"
  text = "Find the complex conjugate of:
[`" ++ $1.latex ++ "`]."
  answer_value = complex($1.re, -$1.im)
}

Q -> "modulus" weight 2 {
  kind = "modulus"
  text = "Find the modulus of the complex number:
[`" ++ modulus_latex ++ "`]."
  answer_value = modulus_value
}

Q -> "power_i" weight 2 {
  kind = "power_i"
  text = "Evaluate the power of the imaginary unit:
[`i^{" ++ exponent_text ++ "}`]."
  answer_value = complex(power_re, power_im)
}

# ---- Recursive complex expression --------------------------------------

E -> E "+" E when len > 0 weight 3 {
  len = -1
  require $1.latex != $3.latex
  re = $1.re + $3.re
  im = $1.im + $3.im
  latex = infix($1, "+", $3)
}

E -> E "-" E when len > 0 weight 3 {
  len = -1
  require $1.latex != $3.latex
  re = $1.re - $3.re
  im = $1.im - $3.im
  latex = infix($1, "-", $3)
}

E -> E "\cdot" E when len > 0 weight 2 {
  len = -1
  require $1.latex != $3.latex
  re = $1.re * $3.re - $1.im * $3.im
  im = $1.re * $3.im + $1.im * $3.re
  latex = infix($1, "\cdot", $3)
}

E -> Z when len = 0 {
  re = $1.re
  im = $1.im
  latex = $1.latex
}

# Every leaf is genuinely complex: the imaginary component is never zero.
Z -> integer_between(-6, 6) nonzero_integer_between(-6, 6) {
  re = $1.value
  im = $2.value
  latex = "(" ++ complex_latex($1.value, $2.value) ++ ")"
  value = complex(re, im)
}

prompt "{Q.text}"
answer Q.answer_value
width 14
