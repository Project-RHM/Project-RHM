# ==========================================================================
#  Complex numbers
#
#  One specification covers recursive arithmetic expressions, conjugates,
#  integer-valued moduli, and powers of i. Complex values remain semantic
#  values until PGML rendering; latex is only their displayed representation.
#
#  Difficulty is the budget `cost`, spent exactly. In an expression, a sum or
#  difference costs 1 (each component once) and a product 3 (four products
#  and i^2 = -1); a leaf a + bi costs nothing. The question forms:
#
#    arithmetic   the expression's cost, at least 1
#    conjugate    the expression's cost, from 0 upwards
#    modulus      2, plus a modulus expression: a product of two 2, a
#                 conjugate 1, a whole-number multiple 1, a leaf 0. Every
#                 leaf is a Pythagorean triple, so the modulus is a whole
#                 number however the expression is built.
#    power_i      1, plus the expression multiplied by i^n
#
#  The caller chooses the difficulty:
#
#    agrun --set cost=2 complex.ag     easy
#    agrun --set cost=4 complex.ag     medium (the default)
#    agrun --set cost=7 complex.ag     hard
# ==========================================================================

context "Complex"

attribute cost = 4 split

# i^n depends only on n mod 4.
random exponent = integer_between(2, 24)
let power_case = exponent % 4
let power_re = cond(power_case = 0, 1,
                    cond(power_case = 2, -1, 0))
let power_im = cond(power_case = 1, 1,
                    cond(power_case = 3, -1, 0))
let exponent_text = str(exponent)

synth kind on Q
synth text on Q
synth answer_value on Q

synth re on E
synth im on E
synth latex on E

synth atom on E                # 1 for a bare leaf, which needs no brackets

synth re on Z
synth im on Z
synth latex on Z
synth value on Z

synth re on M                  # a modulus expression: triples under products,
synth im on M                  # conjugates and whole-number multiples
synth modulus on M
synth latex on M
synth top on M                 # "leaf", "product", "conjugate" or "scale"
synth re on T
synth im on T
synth modulus on T
synth latex on T
synth value on T

start Q

precedence 1 left "+" "-"
precedence 2 left "\cdot"

# ---- Question forms ------------------------------------------------------
#
# Computing a bare leaf is no question, so arithmetic needs at least 1.

Q -> E "arithmetic" when cost >= 1 weight 5 {
  kind = "arithmetic"
  text = "Compute the complex number expression:
[`" ++ $1.latex ++ "`]."
  answer_value = complex($1.re, $1.im)
}

Q -> E "conjugate" weight 2 {
  kind = "conjugate"
  text = "Find the complex conjugate of:
[`" ++ $1.latex ++ "`]."
  answer_value = complex($1.re, -$1.im)
}

# The modulus of a product, conjugate or multiple of Pythagorean-triple
# numbers is a whole number: |zw| = |z||w|, |conj z| = |z|, |kz| = k|z|.
Q -> M "modulus" when cost >= 2 weight 2 {
  cost = -2
  kind = "modulus"
  text = "Find the modulus of the complex number:
[`" ++ $1.latex ++ "`]."
  answer_value = $1.modulus
}

# Multiplying by i^n rotates: the answer is the expression's value turned
# by n quarter turns.
Q -> E "power_i" when cost >= 1 weight 2 {
  cost = -1
  kind = "power_i"
  text = "Evaluate:
[`i^{" ++ exponent_text ++ "} \cdot " ++ cond($1.atom = 1, $1.latex, "(" ++ $1.latex ++ ")") ++ "`]."
  answer_value = complex($1.re * power_re - $1.im * power_im, $1.re * power_im + $1.im * power_re)
}

# ---- Modulus expressions -------------------------------------------------
#
# Each rule's guard is the least it can spend. A conjugate is never taken of
# a conjugate, nor a multiple of a multiple.

M -> M "\cdot" M when cost >= 2 weight 3 {
  cost = -2
  require $1.latex != $3.latex
  re = $1.re * $3.re - $1.im * $3.im
  im = $1.re * $3.im + $1.im * $3.re
  modulus = $1.modulus * $3.modulus
  latex = infix($1, "\cdot", $3)
  top = "product"
}

M -> "\overline" M when cost >= 1 weight 2 {
  cost = -1
  require $2.top != "conjugate"
  re = $2.re
  im = -$2.im
  modulus = $2.modulus
  latex = "\overline{" ++ $2.latex ++ "}"
  top = "conjugate"
}

M -> integer_between(2, 4) "\cdot" M when cost >= 1 weight 2 {
  cost = -1
  require $3.top != "scale"
  re = $1.value * $3.re
  im = $1.value * $3.im
  modulus = $1.value * $3.modulus
  latex = str($1.value) ++ cond($3.top = "leaf", $3.latex, "(" ++ $3.latex ++ ")")
  top = "scale"
}

M -> T when cost = 0 {
  re = $1.re
  im = $1.im
  modulus = $1.modulus
  latex = $1.latex
  top = "leaf"
}

# A Pythagorean triple (m^2 - 1, 2m, m^2 + 1) for m > 1, with independent
# signs and an optional swap of the two legs.
T -> integer_between(2, 5) integer_between(0, 1) integer_between(0, 1) integer_between(0, 1) "triple" {
  re = cond($3.value = 1, 1, -1) * cond($2.value = 1, 2 * $1.value, $1.value * $1.value - 1)
  im = cond($4.value = 1, 1, -1) * cond($2.value = 1, $1.value * $1.value - 1, 2 * $1.value)
  modulus = $1.value * $1.value + 1
  latex = "(" ++ complex_latex(re, im) ++ ")"
  value = complex(re, im)
}

# ---- Recursive complex expression --------------------------------------
#
# Each rule's guard is the least it can spend: its own price. The product
# carries the heavier weight so that a budget buys products as readily as
# chains of sums.

E -> E "+" E when cost >= 1 weight 2 {
  cost = -1
  require $1.latex != $3.latex
  re = $1.re + $3.re
  im = $1.im + $3.im
  latex = infix($1, "+", $3)
  atom = 0
}

E -> E "-" E when cost >= 1 weight 2 {
  cost = -1
  require $1.latex != $3.latex
  re = $1.re - $3.re
  im = $1.im - $3.im
  latex = infix($1, "-", $3)
  atom = 0
}

E -> E "\cdot" E when cost >= 3 weight 3 {
  cost = -3
  require $1.latex != $3.latex
  re = $1.re * $3.re - $1.im * $3.im
  im = $1.re * $3.im + $1.im * $3.re
  latex = infix($1, "\cdot", $3)
  atom = 0
}

# The budget is spent, so only a leaf is left.
E -> Z when cost = 0 {
  re = $1.re
  im = $1.im
  latex = $1.latex
  atom = 1
}

# Every leaf is genuinely complex: the imaginary component is never zero.
Z -> integer_between(-6, 6) nonzero_integer_between(-6, 6) {
  re = $1.value
  im = $2.value
  latex = "(" ++ complex_latex($1.value, $2.value) ++ ")"
  value = complex(re, im)
}

prompt "{Q.text}"
answer Q.answer_value
width 14
