# ==========================================================================
#  Boolean expression evaluation
#
#  The student is shown a truth assignment and a proposition, and answers
#  1 or 0. The proposition is a real value (see ag_boolean.ml): the engine
#  renders it, evaluates it and judges its shape, so this file only says
#  what a good question looks like.
#
#  "Good" is calibrated against the course's own assignments: variables
#  p, q, r; two to four connectives; \to, \leftrightarrow and \oplus as
#  ordinary connectives, not rarities; negation on variables, at most two
#  of them, never around the whole proposition; and an assignment chosen
#  so that the student has to read the whole expression.
# ==========================================================================


# ---- Budgets handed down ----

attribute len = 4 split        # most connectives (S trims it to 2, 3 or 4)
attribute extras = 2 split     # how many of \to, \leftrightarrow, \oplus may appear


# ---- Synthesized attributes ----

synth f on E                   # the proposition built so far
synth f on V
synth f on S
synth value on Q               # its truth under the assignment
synth text on Q                # the question


# ---- Drawn once per question ----
#
# A truth assignment belongs to the whole question, not to one leaf, so it
# is drawn here and every occurrence of a variable sees the same value.

random p = boolean
random q = boolean
random r = boolean
random phrasing = integer_between(1, 3)
random target = boolean         # the answer this question is to have

let names = "p,q,r"
let mask  = cond(p, 1, 0) + cond(q, 2, 0) + cond(r, 4, 0)

let tp = cond(p, "\mathsf{T}", "\mathsf{F}")
let tq = cond(q, "\mathsf{T}", "\mathsf{F}")
let tr = cond(r, "\mathsf{T}", "\mathsf{F}")

let given     = "[`p = " ++ tp ++ "`], [`q = " ++ tq ++ "`] and [`r = " ++ tr ++ "`]"
let given_one = "[`p = " ++ tp ++ ",\; q = " ++ tq ++ ",\; r = " ++ tr ++ "`]"


start Q


# ---- Question ----

Q -> S {
       # An assignment with every variable the same lets a student answer
       # without reading the proposition.
       require tp != tq or tq != tr
       # The course never negates a whole proposition, and rarely writes
       # more than two negations.
       require bool_top($1.f) != "not"
       require bool_negations($1.f) <= 2
       # With three or more leaves, all three variables take part.
       require bool_variable_count($1.f) = 3 or bool_size($1.f) < 2
       # The assignment is chosen with intent: at least two variables have
       # to be read to get the answer, so no single value settles it.
       require bool_variable_count($1.f) < 2 or bool_sensitivity($1.f, names, mask) >= 2
       value = bool_evaluate($1.f, names, mask)
       # A person balances a set by deciding the answer first; the coin toss
       # `target` does the same, so neither answer can dominate.
       require value = target
       text  = cond(phrasing = 1,
                 "Suppose " ++ given ++ ". What is the truth value of [`" ++ bool_latex($1.f) ++ "`]?",
               cond(phrasing = 2,
                 "Let " ++ given_one ++ ". Is the proposition [`" ++ bool_latex($1.f) ++ "`] true or false?",
                 "Evaluate [`" ++ bool_latex($1.f) ++ "`] when " ++ given ++ "."))
     }


# ---- Size ----
#
# A set of questions that all have the same number of connectives looks
# generated. `len` is the most a question may have; the default of 4 gives
# two, three or four connectives in the ratio 2 : 3 : 1, three being the
# course's usual size. (A budget may only shrink, so the variation trims
# from the top.)

S -> E  when len > 2  weight 2 { len = -2  f = $1.f }
S -> E  when len > 1  weight 3 { len = -1  f = $1.f }
S -> E                weight 1 {           f = $1.f }


# ---- Productions ----
#
# Every rule that builds a compound asks the engine whether it is tidy:
# no operands over the same variables, no variable standing alone in a
# chain that also contains it, no negation of a negation. Refusing early
# keeps the retries cheap.

E -> E "\land" E  when len > 0  weight 3 {
       len = -1
       f = bool_and($1.f, $3.f)
       require bool_is_tidy(f)
     }

E -> E "\lor" E  when len > 0  weight 3 {
       len = -1
       f = bool_or($1.f, $3.f)
       require bool_is_tidy(f)
     }

# The conditional is the course's favourite connective; \leftrightarrow
# and \oplus appear but less often. The three share the `extras` budget.

E -> E "\to" E  when len > 0 and extras > 0  weight 4 {
       len    = -1
       extras = -1
       f = bool_imp($1.f, $3.f)
       require bool_is_tidy(f)
     }

E -> E "\leftrightarrow" E  when len > 0 and extras > 0  weight 1 {
       len    = -1
       extras = -1
       f = bool_iff($1.f, $3.f)
       require bool_is_tidy(f)
     }

E -> E "\oplus" E  when len > 0 and extras > 0  weight 1 {
       len    = -1
       extras = -1
       f = bool_xor($1.f, $3.f)
       require bool_is_tidy(f)
     }

# Negating a compound, \neg (p \lor q). The guard leaves the operand at
# least one connective, so a negated variable comes only from the leaf
# rule below, where it is free.
E -> "\neg" E  when len > 1  weight 1 {
       len = -1
       f = bool_not($2.f)
       require bool_is_tidy(f)
     }

E -> V         when len = 0  weight 3 { f = $1.f }
E -> "\neg" V  when len = 0  weight 1 { f = bool_not($2.f) }

V -> "p" { f = bool_var("p") }
V -> "q" { f = bool_var("q") }
V -> "r" { f = bool_var("r") }


# ---- Question wording ----

prompt "{Q.text}
Enter 1 for true and 0 for false."

answer Q.value
