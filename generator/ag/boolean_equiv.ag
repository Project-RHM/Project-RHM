# ==========================================================================
#  Boolean equivalence
#
#  The student is shown two expressions and answers 1 if they are equivalent
#  and 0 otherwise. Equivalence is a claim about *every* assignment, not about
#  one, so a single true/false value cannot express it.
#
#  Instead each subexpression carries its whole truth table. With three
#  variables there are eight assignments, so a truth table is an eight-bit
#  number, and the connectives become bitwise operations on it. Two
#  expressions are equivalent exactly when their tables are equal -- which is
#  a comparison the engine already knows how to make, with no idea that logic
#  is involved.
#
#      row     A B C        bit
#       0      F F F         1
#       1      F F T         2
#       2      F T F         4
#       3      F T T         8
#       4      T F F        16
#       5      T F T        32
#       6      T T F        64
#       7      T T T       128
#
#  so A is true in rows 4..7  -> 16+32+64+128 = 240
#     B is true in rows 2,3,6,7 ->  4+ 8+64+128 = 204
#     C is true in rows 1,3,5,7 ->  2+ 8+32+128 = 170
#  and negation is 255 - table.
# ==========================================================================


attribute len = 2 split        # size of the subexpressions a law is built from

# The subexpression language carries these two.
synth table on P               # the truth table, as an eight-bit number
synth table on V
synth latex on P               # how the subexpression is written
synth latex on V
# The same rendering, bracketed unless it is a single variable. The laws below
# splice subexpressions into contexts that bind more tightly than the
# subexpression itself, so splicing the bare form would silently change what
# the question says -- the displayed expression would stop matching the truth
# table the answer was computed from.
synth safe on P
synth safe on V

# Only a whole question carries these: the two sides of the claim, and whether
# the claim actually holds. They are not called left/right because those two
# words are taken by the precedence syntax.
synth lhs on Q
synth rhs on Q
synth holds on Q


start Q


# ==========================================================================
#  Questions
#
#  Each rule below states a law, building both sides from the same
#  subexpressions, so the two sides really are the same claim written twice.
#  `holds` is not asserted -- it is computed by comparing the two tables, so a
#  law that has been deliberately broken is still labelled correctly even in
#  the cases where the break happens to cancel out.
# ==========================================================================

# ---- laws that hold -------------------------------------------------------

# De Morgan
Q -> P P   weight 2 {
       lhs = "\neg (" ++ $1.safe ++ " \land " ++ $2.safe ++ ")"
       rhs = "\neg " ++ $1.safe ++ " \lor \neg " ++ $2.safe
       holds = 255 - bit_and($1.table, $2.table)
               = bit_or(255 - $1.table, 255 - $2.table)
       }

# Implication as disjunction
Q -> P P   weight 2 {
       lhs = $1.safe ++ " \to " ++ $2.safe
       rhs = "\neg " ++ $1.safe ++ " \lor " ++ $2.safe
       holds = bit_or(255 - $1.table, $2.table)
               = bit_or(255 - $1.table, $2.table)
       }

# Double negation
Q -> P     weight 2 {
       lhs = "\neg (\neg " ++ $1.safe ++ ")"
       rhs = $1.safe
       holds = 255 - (255 - $1.table) = $1.table
       }

# Absorption
Q -> P P   weight 1 {
       lhs = $1.safe ++ " \land (" ++ $1.safe ++ " \lor " ++ $2.safe ++ ")"
       rhs = $1.safe
       holds = bit_and($1.table, bit_or($1.table, $2.table)) = $1.table
       }

# Biconditional as two implications
Q -> P P   weight 1 {
       lhs = $1.safe ++ " \leftrightarrow " ++ $2.safe
       rhs = "(" ++ $1.safe ++ " \to " ++ $2.safe ++ ") \land ("
               ++ $2.safe ++ " \to " ++ $1.safe ++ ")"
       holds = 255 - bit_xor($1.table, $2.table)
               = bit_and(bit_or(255 - $1.table, $2.table),
                         bit_or(255 - $2.table, $1.table))
       }

# ---- laws with one connective swapped, so they usually fail ---------------
#
# "Usually" is the point: whether the claim holds is computed, not assumed,
# so the rare pair where the swap makes no difference is still labelled 1.

# De Morgan with the wrong connective on the right
Q -> P P   weight 3 {
       lhs = "\neg (" ++ $1.safe ++ " \land " ++ $2.safe ++ ")"
       rhs = "\neg " ++ $1.safe ++ " \land \neg " ++ $2.safe
       holds = 255 - bit_and($1.table, $2.table)
               = bit_and(255 - $1.table, 255 - $2.table)
       }

# Implication turned around
Q -> P P   weight 3 {
       lhs = $1.safe ++ " \to " ++ $2.safe
       rhs = $2.safe ++ " \to " ++ $1.safe
       holds = bit_or(255 - $1.table, $2.table) = bit_or(255 - $2.table, $1.table)
       }

# Distribution with the connectives the wrong way round
Q -> P P   weight 2 {
       lhs = $1.safe ++ " \lor (" ++ $1.safe ++ " \land " ++ $2.safe ++ ")"
       rhs = $1.safe ++ " \land " ++ $2.safe
       holds = bit_or($1.table, bit_and($1.table, $2.table))
               = bit_and($1.table, $2.table)
       }


# ==========================================================================
#  Subexpressions
#
#  P is a small expression; the laws above are stated over whatever P
#  produces, so the same law reads differently every time.
# ==========================================================================

P -> P "\land" P   when len > 0  weight 2 {
       len   = -1
       require $1.latex != $3.latex
       table = bit_and($1.table, $3.table)
       latex = infix($1, "\land", $3)
       safe  = "(" ++ latex ++ ")"
       }

P -> P "\lor" P    when len > 0  weight 2 {
       len   = -1
       require $1.latex != $3.latex
       table = bit_or($1.table, $3.table)
       latex = infix($1, "\lor", $3)
       safe  = "(" ++ latex ++ ")"
       }

P -> "\neg" P      when len > 0  weight 1 {
       len   = -1
       table = 255 - $2.table
       latex = prefix("\neg", $2)
       safe  = "(" ++ latex ++ ")"
       }

P -> V             when len = 0 {
       table = $1.table
       latex = $1.latex
       safe  = $1.safe
       }

V -> "A" { table = 240  latex = "A"  safe = "A" }
V -> "B" { table = 204  latex = "B"  safe = "B" }
V -> "C" { table = 170  latex = "C"  safe = "C" }


precedence 1 left  "\lor"
precedence 2 left  "\land"
precedence 3 right "\neg"


# ---- Question wording ----

prompt "Determine whether the Boolean expressions are equivalent:
[`{Q.lhs}, {Q.rhs}`]
Enter 1 if equivalent and 0 otherwise."

answer Q.holds
