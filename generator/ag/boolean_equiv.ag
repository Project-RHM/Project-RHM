# ==========================================================================
#  Boolean equivalence, justified by a truth table
#
#  The student is shown a claimed equivalence, completes its truth table,
#  and says whether it holds. Set as the course sets these: a lecturer
#  starts from a small proposition and rewrites it with two or three laws,
#  so the two sides are genuinely a derivation apart, not one law apart.
#
#    p \to q            \equiv \neg (p \land \neg q)       (two steps)
#    p \to (q \lor r)   \equiv (p \land \neg q) \to r      (three steps)
#
#  A pair that does not hold is built the same way with one step replaced
#  by a classic mistake -- the converse, De Morgan without switching the
#  connective, regrouping a conditional -- so it looks as plausible as a
#  true one. The engine decides by enumeration whether each claim holds,
#  and a "mistake" that happens to preserve the meaning is drawn again.
#
#  Laws and mistakes live in ag_boolean.ml (equivalence_laws, mistake_rules);
#  this file chooses the core, the number of steps, and what a fair question
#  looks like. The truth table follows the course's assignments: two or
#  three variables, and at most seven columns to fill.
# ==========================================================================

attribute len = 2 split        # connectives of the core; S trims to 1 or 2

synth f on E
synth f on V
synth f on C
synth fa on Q                  # the derived side
synth fb on Q                  # the core, or a second derived side
synth lhs on Q                 # the two sides in the order shown
synth rhs on Q
synth claim on Q
synth solution on Q
synth answer_value on Q

# How the claim is set.
random style = integer_between(1, 5)      # 1-3: a derived side against the core; 4-5: two derived sides
random total = integer_between(2, 3)      # law steps between the two sides
random wrong = boolean                    # one step is a mistake, so the claim fails
random flip = boolean                     # which side is written first
random k1 = integer_between(0, 999999)    # the choices of the first derivation
random k2 = integer_between(0, 999999)    # and of the second
random loose = integer_between(1, 5)      # 1: the core may read its variables out of order
random roomy = integer_between(1, 10)     # 1-3: the table may have a sixth column
random small = integer_between(1, 4)      # 1: a core of one connective is allowed

let first_steps  = cond(style <= 3, total, 1)
let second_steps = cond(style <= 3, 0, total - 1)

stem "Determine whether each of the following logical equivalences holds, and justify your answer with a truth table. Fill in each blank with T or F."

start Q

Q -> C {
       # The two sides: one derived from the core, the other the core itself
       # or a second derivation from it.
       fa = cond(wrong, bool_derive_wrong($1.f, first_steps, k1), bool_derive($1.f, first_steps, k1))
       fb = cond(second_steps = 0, $1.f, bool_derive($1.f, second_steps, k2))

       # Every step asked for was taken.
       require bool_steps($1.f, first_steps, k1, wrong) = first_steps
       require second_steps = 0 or bool_steps($1.f, second_steps, k2, 1 = 0) = second_steps

       # The claim holds exactly when no mistake was made.
       require bool_equivalent(fa, fb) = (not wrong)

       # Two or three steps apart, not a relabelling and not one law apart.
       require not bool_same_shape(fa, fb)
       require not bool_one_step_apart(fa, fb)
       # Nor the same but for one connective or one negated variable, a
       # difference seen before any reasoning.
       require not bool_slight_difference(fa, fb)

       # Each side is something a person would write.
       require bool_is_fair(fa)
       require bool_is_fair(fb)
       require not bool_is_tautology(fa)
       require not bool_is_contradiction(fa)
       require not bool_is_tautology(fb)
       require not bool_is_contradiction(fb)
       require bool_negations(fa) <= 2
       require bool_negations(fb) <= 2

       # A table a student can fill by hand: the assignments' tables have
       # four or five columns to fill, so seven in ten questions keep to five
       # and the rest to six; never fewer than three.
       require bool_table_width(fa, fb) <= cond(roomy <= 3, 6, 5)
       require bool_table_width(fa, fb) >= 3
       # At least one side has two connectives: p \lor q against \neg p \lor \neg q
       # is too slight for a derivation.
       require bool_size(fa) >= 2 or bool_size(fb) >= 2

       lhs = cond(flip, fa, fb)
       rhs = cond(flip, fb, fa)
       claim = "[`" ++ bool_latex(lhs) ++ " \equiv " ++ bool_latex(rhs) ++ "`]"
       solution = "core " ++ bool_latex($1.f) ++ "; first side: " ++ bool_derivation($1.f, first_steps, k1, wrong)
                  ++ cond(second_steps = 0, "", "; second side: " ++ bool_derivation($1.f, second_steps, k2, 1 = 0))
       answer_value = parts(truth_table2(lhs, rhs),
                            labelled("Therefore the two sides are ",
                                     choice("logically equivalent|not logically equivalent",
                                            cond(wrong, "not logically equivalent", "logically equivalent"))))
     }


# ---- The core: a small proposition as a course writes one ----
#
# One or two connectives over two or three variables, each variable once,
# the conditional the most common, negation only on variables, variables
# read p, q, r in order.

C -> S {
       # Each variable once, as laws are stated: p \to (q \lor r), not
       # p \to (\neg p \to r). A derivation may repeat a variable later, when a
       # law copies a part (distribution, the biconditional), as a person's
       # derivation does.
       require bool_variable_count($1.f) = bool_size($1.f) + 1
       # A core of one connective, p \to q, has few two-step derivations, and
       # left alone they crowd the set: \neg (p \land \neg q) \equiv p \to q
       # and its relabellings were a fifth of all questions. One in four such
       # cores is kept.
       require bool_size($1.f) >= 2 or small = 1
       require bool_is_plain($1.f)
       require not bool_has_trivial_part($1.f)
       require loose = 1 or bool_in_order($1.f)
       require bool_variable_count($1.f) >= 2
       f = $1.f
     }

S -> E  when len > 1  weight 1 { len = -1  f = $1.f }
S -> E                weight 2 {           f = $1.f }

E -> E "\to" E            when len > 0  weight 5 { len = -1  f = bool_imp($1.f, $3.f)  require bool_is_plain(f) }
E -> E "\land" E          when len > 0  weight 3 { len = -1  f = bool_and($1.f, $3.f)  require bool_is_plain(f) }
E -> E "\lor" E           when len > 0  weight 3 { len = -1  f = bool_or($1.f, $3.f)   require bool_is_plain(f) }
E -> E "\leftrightarrow" E when len > 0 weight 1 { len = -1  f = bool_iff($1.f, $3.f)  require bool_is_plain(f) }
E -> E "\oplus" E         when len > 0  weight 1 { len = -1  f = bool_xor($1.f, $3.f)  require bool_is_plain(f) }

E -> V         when len = 0  weight 3 { f = $1.f }
E -> "\neg" V  when len = 0  weight 1 { f = bool_not($2.f) }

V -> "p" { f = bool_var("p") }
V -> "q" { f = bool_var("q") }
V -> "r" { f = bool_var("r") }


prompt "{Q.claim}"
answer Q.answer_value
