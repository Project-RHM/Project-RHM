# ==========================================================================
#  Boolean equivalence
#
#  The student is shown two propositions and answers 1 if they are
#  logically equivalent and 0 otherwise. Each question is one law of
#  propositional logic, stated correctly or with one classic mistake, over
#  parts drawn from a small expression language.
#
#  The propositions are real values (see ag_boolean.ml): a law builds both
#  sides as formulas, the engine renders them and decides equivalence by
#  enumerating every assignment, so the text a student sees and the answer
#  come from one object. A law that should hold asserts it; a mistake that
#  happens to hold for some parts is drawn again rather than asked, so a
#  student is never tested on a coincidence.
#
#  The laws follow the course's assignments: De Morgan, the conditional's
#  disguises, contrapositive against converse and inverse, distribution
#  (including the conditional over \lor and \land), exportation, and
#  associativity, which holds for \leftrightarrow and \oplus but not \to.
# ==========================================================================


attribute len = 2 split        # connectives shared by the parts of a law


# ---- Synthesized attributes ----

synth f on P                   # a part
synth f on V

synth fa on L                  # the two sides of the claim
synth fb on L
synth fa on S
synth fb on S

synth holds on Q
synth lhs on Q
synth rhs on Q
synth text on Q

random flip = boolean                  # which side is shown first
random phrasing = integer_between(1, 2)


start Q


Q -> S {
       # The course rarely writes more than two negations on a side.
       require bool_negations($1.fa) <= 2
       require bool_negations($1.fb) <= 2
       holds = bool_equivalent($1.fa, $1.fb)
       lhs   = bool_latex(cond(flip, $1.fa, $1.fb))
       rhs   = bool_latex(cond(flip, $1.fb, $1.fa))
       text  = cond(phrasing = 1,
                 "Are the following two propositions logically equivalent?
[`" ++ lhs ++ "`]
[`" ++ rhs ++ "`]",
                 "Is [`" ++ lhs ++ " \equiv " ++ rhs ++ "`] a valid logical equivalence?")
     }


# ---- Size ----
#
# `len` is the most connectives the parts of a law may share. Stated over
# bare variables, \neg (p \land q) \equiv \neg p \lor \neg q, is how the
# course writes a law, so that form gets the biggest share.

S -> L  when len > 1  weight 3 { len = -2  fa = $1.fa  fb = $1.fb }
S -> L  when len > 0  weight 2 { len = -1  fa = $1.fa  fb = $1.fb }
S -> L                weight 1 {           fa = $1.fa  fb = $1.fb }


# ==========================================================================
#  Laws
#
#  Each law builds its two sides, refuses untidy ones (which also rules out
#  \neg \neg when a part already starts with \neg), and then either asserts
#  that it holds or insists that it does not.
# ==========================================================================

# ---- Laws that hold ------------------------------------------------------

# De Morgan, conjunction
L -> P P   weight 6 {
       fa = bool_not(bool_and($1.f, $2.f))
       fb = bool_or(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# De Morgan, disjunction
L -> P P   weight 6 {
       fa = bool_not(bool_or($1.f, $2.f))
       fb = bool_and(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# The conditional as a disjunction
L -> P P   weight 4 {
       fa = bool_imp($1.f, $2.f)
       fb = bool_or(bool_not($1.f), $2.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Contrapositive
L -> P P   weight 4 {
       fa = bool_imp($1.f, $2.f)
       fb = bool_imp(bool_not($2.f), bool_not($1.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# The negated conditional
L -> P P   weight 3 {
       fa = bool_not(bool_imp($1.f, $2.f))
       fb = bool_and($1.f, bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Distribution of \land over \lor
L -> P P P   weight 12 {
       fa = bool_and($1.f, bool_or($2.f, $3.f))
       fb = bool_or(bool_and($1.f, $2.f), bool_and($1.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Distribution of \lor over \land
L -> P P P   weight 12 {
       fa = bool_or($1.f, bool_and($2.f, $3.f))
       fb = bool_and(bool_or($1.f, $2.f), bool_or($1.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# The conditional distributes over \lor in its conclusion
L -> P P P   weight 12 {
       fa = bool_imp($1.f, bool_or($2.f, $3.f))
       fb = bool_or(bool_imp($1.f, $2.f), bool_imp($1.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# ... and over \land
L -> P P P   weight 12 {
       fa = bool_imp($1.f, bool_and($2.f, $3.f))
       fb = bool_and(bool_imp($1.f, $2.f), bool_imp($1.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Exportation
L -> P P P   weight 12 {
       fa = bool_imp(bool_and($1.f, $2.f), $3.f)
       fb = bool_imp($1.f, bool_imp($2.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# \leftrightarrow is associative
L -> P P P   weight 8 {
       fa = bool_iff($1.f, bool_iff($2.f, $3.f))
       fb = bool_iff(bool_iff($1.f, $2.f), $3.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# \oplus is associative
L -> P P P   weight 8 {
       fa = bool_xor($1.f, bool_xor($2.f, $3.f))
       fb = bool_xor(bool_xor($1.f, $2.f), $3.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# The biconditional as two conditionals
L -> P P   weight 3 {
       fa = bool_iff($1.f, $2.f)
       fb = bool_and(bool_imp($1.f, $2.f), bool_imp($2.f, $1.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# The biconditional by cases
L -> P P   weight 2 {
       fa = bool_iff($1.f, $2.f)
       fb = bool_or(bool_and($1.f, $2.f), bool_and(bool_not($1.f), bool_not($2.f)))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Double negation: the one place \neg \neg is meant to appear.
L -> P     weight 1 {
       fa = bool_not(bool_not($1.f))
       fb = $1.f
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# Absorption: the one law whose side repeats a part on purpose, stated as
# the course states it, over a variable.
L -> P P   weight 1 {
       require bool_is_atom($1.f)
       fa = bool_and($1.f, bool_or($1.f, $2.f))
       fb = $1.f
       require bool_is_tidy(bool_and($1.f, $2.f))
       require bool_equivalent(fa, fb)
       }

# The same proposition with its operands reordered: looks different, holds.
L -> P P P   weight 6 {
       fa = bool_or($1.f, bool_and($2.f, $3.f))
       fb = bool_or(bool_and($3.f, $2.f), $1.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require bool_equivalent(fa, fb)
       }

# ---- Laws with one classic mistake --------------------------------------
#
# Whether the mistake shows depends on the parts; a pair where it happens
# not to is drawn again, so every one of these is asked only when it fails.

# De Morgan with the connective left unchanged
L -> P P   weight 4 {
       fa = bool_not(bool_and($1.f, $2.f))
       fb = bool_and(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

L -> P P   weight 4 {
       fa = bool_not(bool_or($1.f, $2.f))
       fb = bool_or(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# De Morgan with a negation dropped
L -> P P   weight 4 {
       fa = bool_not(bool_and($1.f, $2.f))
       fb = bool_or(bool_not($1.f), $2.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# Converse
L -> P P   weight 3 {
       fa = bool_imp($1.f, $2.f)
       fb = bool_imp($2.f, $1.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# Inverse
L -> P P   weight 4 {
       fa = bool_imp($1.f, $2.f)
       fb = bool_imp(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# The conditional with the negation on the wrong side
L -> P P   weight 3 {
       fa = bool_imp($1.f, $2.f)
       fb = bool_or($1.f, bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# The negated conditional done as a conditional of negations
L -> P P   weight 3 {
       fa = bool_not(bool_imp($1.f, $2.f))
       fb = bool_imp(bool_not($1.f), bool_not($2.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# \to is not associative
L -> P P P   weight 12 {
       fa = bool_imp($1.f, bool_imp($2.f, $3.f))
       fb = bool_imp(bool_imp($1.f, $2.f), $3.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# Distribution that forgets to distribute over the second operand
L -> P P P   weight 10 {
       fa = bool_and($1.f, bool_or($2.f, $3.f))
       fb = bool_or(bool_and($1.f, $2.f), $3.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# The conditional over \lor with the wrong connective between the halves
L -> P P P   weight 10 {
       fa = bool_imp($1.f, bool_or($2.f, $3.f))
       fb = bool_and(bool_imp($1.f, $2.f), bool_imp($1.f, $3.f))
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# Exportation with the brackets the wrong way
L -> P P P   weight 8 {
       fa = bool_imp(bool_and($1.f, $2.f), $3.f)
       fb = bool_imp(bool_imp($1.f, $2.f), $3.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# The biconditional reduced to one conditional
L -> P P   weight 2 {
       fa = bool_iff($1.f, $2.f)
       fb = bool_imp($1.f, $2.f)
       require bool_is_tidy(fa)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }

# Absorption with the connectives the wrong way round
L -> P P   weight 1 {
       require bool_is_atom($1.f)
       fa = bool_or($1.f, bool_and($1.f, $2.f))
       fb = bool_and($1.f, $2.f)
       require bool_is_tidy(fb)
       require not bool_equivalent(fa, fb)
       }


# ==========================================================================
#  Parts
#
#  P is a small expression over \neg, \land and \lor; the laws above are
#  stated over whatever P produces, so the same law reads differently every
#  time.
# ==========================================================================

P -> P "\land" P   when len > 0  weight 2 {
       len = -1
       f = bool_and($1.f, $3.f)
       require bool_is_tidy(f)
       }

P -> P "\lor" P    when len > 0  weight 2 {
       len = -1
       f = bool_or($1.f, $3.f)
       require bool_is_tidy(f)
       }

P -> "\neg" P      when len > 1  weight 1 {
       len = -1
       f = bool_not($2.f)
       require bool_is_tidy(f)
       }

P -> V             when len = 0  weight 3 { f = $1.f }
P -> "\neg" V      when len = 0  weight 1 { f = bool_not($2.f) }

V -> "p" { f = bool_var("p") }
V -> "q" { f = bool_var("q") }
V -> "r" { f = bool_var("r") }


# ---- Question wording ----

prompt "{Q.text}
Enter 1 if they are equivalent and 0 if they are not."

answer Q.holds
